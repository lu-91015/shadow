//@expect: 2\n2\n6\n3\n8\n3\n3\nbar\nbaz\n3.5\n1\n2\n1\n0\n1\n4\nApple\n1
//@desc: hashmap_insert 分派修复回归 —— dict 值按类型分派到正确变体：
//   array<int>/array<string>/array<array<int>>/set<int>/float 经 hashmap_insert 存入 dict，
//   d[key] 下标回读须还原完整对象（此前非 int 值全被 strdup 截断到首个 NUL，元素丢失）。
dsb cg_dict_nested_insert;

kimo build_even() -> array<int> { let a: array<int> = [2, 4, 6]; return a; }

kimo main() -> int {
    // 1) dict<string, array<int>>：函数返回数组 + 覆盖
    let d: dict<string, array<int>> = hashmap_new();
    hashmap_insert(d, "even", build_even());
    hashmap_insert(d, "odd", build_odd());
    println(hashmap_size(d));        // 2
    println(d["even"][0]);           // 2
    println(d["even"][2]);           // 6
    println(d["odd"][1]);            // 3
    hashmap_insert(d, "even", [8, 9, 10]);
    println(d["even"][0]);           // 8
    println(len(d["even"]));         // 3

    // 2) dict<string, array<string>>：数组元素为字符串
    let ds: dict<string, array<string>> = hashmap_new();
    let ws: array<string> = ["foo", "bar", "baz"];
    hashmap_insert(ds, "w", ws);
    println(len(ds["w"]));           // 3
    println(ds["w"][1]);             // bar
    println(ds["w"][2]);             // baz

    // 3) dict<string, float>：浮点值（此前被 strdup 截断）
    let df: dict<string, float> = hashmap_new();
    hashmap_insert(df, "pi", 3.5);
    println(df["pi"]);               // 3.5

    // 4) dict<string, set<int>>：集合去重 + 元素删
    let sd: dict<string, set<int>> = hashmap_new();
    let s = set_new();
    set_add(s, 10);
    set_add(s, 10);
    set_add(s, 20);
    hashmap_insert(sd, "s", s);
    println(hashmap_size(sd));       // 1
    println(set_size(sd["s"]));      // 2
    println(set_contains(sd["s"], 10)); // 1
    set_remove(sd["s"], 10);
    println(set_contains(sd["s"], 10)); // 0
    println(set_size(sd["s"]));      // 1

    // 5) dict<string, array<array<int>>>：嵌套二维矩阵
    let dm: dict<string, array<array<int>>> = hashmap_new();
    let m: array<array<int>> = [[1,2],[3,4]];
    hashmap_insert(dm, "m", m);
    println(dm["m"][1][1]);          // 4

    // 6) dict<string, string>：字符串值仍正常（此前也走 string 变体）
    let dstr: dict<string, string> = hashmap_new();
    hashmap_insert(dstr, "a", "Apple");
    println(dstr["a"]);              // Apple
    println(hashmap_size(dstr));     // 1

    return 0;
}

kimo build_odd() -> array<int> { let a: array<int> = [1, 3, 5]; return a; }