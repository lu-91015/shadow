//@expect: 2\n1\n4\n0\n[a\0b]\n1
//@timeout: 60
// 回归：字符串字面量 \0 转义不得静默丢弃数据（NUL 字节在 NUL 结尾 C 串里无法承载，
// 旧实现在 lexer 拼入 "\0" 后因 strlen("\0")==0 被后续拼接吞掉："a\0b"→"ab"，数据丢失）。
// 修复：退化为字面量反斜杠-0，往返无损、可见可查。字符字面量 '\0' 是标量 0，保持不变。
dsb cg_str_nul_escape;

kimo main() -> int {
    // A. "\0" 不再塌缩成空串：为 2 字符（反斜杠 + '0'）
    println(int_to_str(len("\0")));              // 2
    // B. "\0" 与字面量 "\\0" 等价（都是反斜杠-0）
    println(int_to_str(str_eq("\0", "\\0")));    // 1
    // C. "a\0b" 四字符，不再塌缩成 "ab"（旧 bug 此处为 2）
    println(int_to_str(len("a\0b")));            // 4
    // D. "a\0b" != "ab"，数据不再丢失
    println(int_to_str(str_eq("a\0b", "ab")));   // 0
    // E. 往返可见：打印出原始转义字样 [a\0b]
    println("[" + "a\0b" + "]");                 // [a\0b]
    // F. 字符字面量 '\0' 仍是标量 0
    let c = '\0';
    println(int_to_str(c == 0));                 // 1
    return 0;
}