//@mode: exe
//@desc: 自增 ++ 与自减 -- 增量能力。当前编译器对 ++/-- 无前缀/后缀语义，需实现
//       整数变量自增减。i 从 10 起，i++ 后为 11，--i 后回到 10。仅作守门：实现后移除 //@xfail。
//@xfail: 自增自减未实现：i++ / --i 无运算符语义。修复后应输出 10。
//@expect: 10
dsb ex_inc_dec;

kimo main() -> int {
    let i = 10;
    let j = i++;
    let k = --i;
    println(k); // 10: j=i++=10,i=11; k=--i=10
    return 0;
}