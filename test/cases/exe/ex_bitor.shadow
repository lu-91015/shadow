//@mode: exe
//@desc: 位或运算 | 增量能力。当前编译器把单个 | 一律当作逻辑或（要求 bool 操作数），
//       需实现整数位或语义。6(110) | 3(011) = 7(111)。仅作守门：实现后移除 //@xfail。
//@xfail: 位或未实现：let y = x | 3 编译报错（logical operator requires bool operands）。修复后应输出 7。
//@expect: 7
dsb ex_bitor;

kimo main() -> int {
    let x = 6; // 110
    let y = x | 3; // 110 | 011 = 111 = 7
    println(y);
    return 0;
}