//@mode: exe
//@desc: 位异或运算 ^ 增量能力。当前编译器对 ^ 无整型语义，需实现整数位异或。
//       6(110) ^ 3(011) = 5(101)。仅作守门：实现后移除 //@xfail。
//@xfail: 位异或未实现：let y = x ^ 3 无整数位异或语义。修复后应输出 5。
//@expect: 5
dsb ex_bitxor;

kimo main() -> int {
    let x = 6; // 110
    let y = x ^ 3; // 110 ^ 011 = 101 = 5
    println(y);
    return 0;
}