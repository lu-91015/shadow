//@timeout: 180
//@expect: GC_DROP_OK
// ↑ 超时上调：SHADOW_GC_STRESS 压测门禁下每 8 次分配触发一次同步 GC，
//   编译+运行远超默认 30s；run_tests.py 把 TIMEOUT 计入 FAIL，会掩盖真实结果。
// ↑ 必须用 expect 断言：--run 只回传子进程 stdout，退出码被 src/main.shadow 吞掉
//   （恒 return 0），只写 `return 1` 的用例永远不会红。
// ex_gc_finalizer.shadow — GC v1：Drop finalizer 在对象回收时执行
// 大量分配带 Drop 的结构体并丢弃，GC 触发后 drop 应被调用。
dsb ex_gc_finalizer;

trait Drop {
    kimo drop(self: Self) -> void;
}

struct Res {
    id: int;
}

let drop_count: int = 0;

impl Drop for Res {
    kimo drop(self: Res) -> void {
        drop_count = drop_count + 1;
    }
}

kimo main() -> int {
    let round = 0;
    while (round < 15) {
        let keep: array<Res> = [];
        let i = 0;
        while (i < 50000) {
            let r: Res = Res { id: i };
            if (i % 100 == 0) {
                keep = array_push(keep, r);
            }
            i = i + 1;
        }
        // 保留的检查
        i = 0;
        while (i < len(keep)) {
            let r2: Res = keep[i];
            if (r2.id % 100 != 0) {
                println("ERR bad id round=" + int_to_str(round) + " i=" + int_to_str(i) + " got=" + int_to_str(r2.id));
                return 1;
            }
            i = i + 1;
        }
        round = round + 1;
    }
    println("drops=" + int_to_str(drop_count));
    if (drop_count < 5000) {
        println("ERR too few drops");
        return 1;
    }
    println("GC_DROP_OK");
    return 0;
}
