//@mode: exe
//@desc: ADT — 带载荷枚举(payload enum) + 限定构造 Color.Red(3) + match 绑定解构 Color.Red(x) =>。
//@expect: 3\n11\n26
dsb ex_payload_enum_match;

enum Color { Red(int); Green(int); Blue(int); }

kimo main() -> int {
    let sum = 0;

    let c = Color.Red(3);
    match c {
        Color.Red(x) => { sum = sum + x; }       // 3
        Color.Green(x) => { sum = sum + x * 2; }
        Color.Blue(x) => { sum = sum + x * 3; }
    }
    println(sum);                                // 期望 3

    let g = Color.Green(4);
    match g {
        Color.Red(x) => { sum = sum + x; }
        Color.Green(x) => { sum = sum + x * 2; } // +8
        Color.Blue(x) => { sum = sum + x * 3; }
    }
    println(sum);                                // 期望 11

    let b = Color.Blue(5);
    match b {
        Color.Red(x) => { sum = sum + x; }
        Color.Green(x) => { sum = sum + x * 2; }
        Color.Blue(x) => { sum = sum + x * 3; }  // +15
    }
    println(sum);                                // 期望 26
    return 0;
}