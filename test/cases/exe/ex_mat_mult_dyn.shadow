//@mode: exe
//@desc: Bug1 修复回归 — 两个动态元素(any/ptr)作乘数：codegen 按 i64 乘法语义生成并 trunc 回 int，
//       不再产生被 llc 拒绝的非法 IR `mul ptr %x, %y`（修复见 codegen.shadow cg_gen_binop 的
//       BIN_MUL 动态操作数分支，2026-08-20）。遍历嵌套 array 参数全部 a[i][k]*b[k][j] 之和，
//       sum=19+22+43+50=134。此用例守护数组元素动态乘法不回归 mul ptr ptr。
//@expect: 134
dsb ex_mat_mult_dyn;

kimo mul(a: array, b: array) -> int {
    let n = len(a);
    let s = 0;
    let i = 0;
    while (i < n) {
        let j = 0;
        while (j < n) {
            let k = 0;
            while (k < n) {
                s = s + a[i][k] * b[k][j]; // trigger: mul ptr ptr（两动态元素相乘）
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return s;
}

kimo main() -> int {
    let a = [[1, 2], [3, 4]];
    let b = [[5, 6], [7, 8]];
    let r = mul(a, b);
    println(r); // 1*5+2*7=19, 1*6+2*8=22, 3*5+4*7=43, 3*6+4*8=50 → 134
    return 0;
}