//@expect: 1\n1\n0\n0\ntrue\nfalse\n1\n1\n1
//@timeout: 60
// 回归：bool 值（LLVM i1）传给 int 形参运行时/内建函数时未 zext 到 i32，高位垃圾。
// 比较/逻辑操作产生 i1，直接喂 i32 形参（int_to_str/println_bool 等）会输出随机负大数。
// 修复：cg_gen_call 实参拓宽在 float→double 之外，补 bool(i1)→zext 到 i32。
dsb cg_bool_widen;

kimo main() -> int {
    // (1) 比较结果直接喂 int_to_str（i1→i32 zext）
    println(int_to_str(3 == 3));              // 1
    let c = 'z';
    println(int_to_str(c == 'z'));            // 1
    println(int_to_str(c != 'z'));            // 0
    println(int_to_str(c == 'y'));            // 0

    // (2) println 直接接收 bool 表达式（shadow_println_bool 形参是 int）
    println((2 > 1));                          // true
    println((1 > 2));                          // false

    // (3) bool 变量（i1 槽）喂 int_to_str
    let b = (4 >= 4);
    println(int_to_str(b));                    // 1

    // (4) 逻辑与 结果喂 int_to_str（i1→i32）
    println(int_to_str(1 == 1 && 2 == 2));     // 1

    // (5) char 比较经 bool 变量喂 int_to_str
    let b2 = ('a' < 'b');
    println(int_to_str(b2));                   // 1
    return 0;
}