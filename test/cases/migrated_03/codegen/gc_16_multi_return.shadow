//@desc: GC frame anchor pop on multiple return paths
//@expect-ir: shadow_gc_tls_frame_head
dsb gc_16_multi_return;
struct P { x: int, y: int }
kimo classify(n: int) -> int {
    let p = P { x: n, y: n };
    if (n > 10) {
        return p.x;
    }
    if (n < 0) {
        return p.y;
    }
    return 0;
}
kimo main() -> int {
    return classify(5);
}
