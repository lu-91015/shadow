//@ mode: codegen
//@ desc: try/catch with cross-function throw (called function throws, caller catches)
//@expect-ir: shadow_exception_occurred
dsb cg_try_catch_cross_fn;

kimo fail() -> int {
    throw "boom";
    return 0;
}

kimo main() -> int {
    let result = 0;
    try {
        result = fail();
        result = result + 1;
    } catch {
        result = 42;
    }
    return result;
}
