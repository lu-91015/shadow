//@desc: GC frame anchor (compile-time stack map) covers for-loop array root
//@expect-ir: shadow_gc_thread_frame_head
//@expect-ir: shadow_array_len
dsb gc_05_for_loop_root;
kimo main() -> int {
    let arr = [1, 2, 3];
    let sum = 0;
    for (x in arr) {
        sum = sum + x;
    }
    return sum;
}
