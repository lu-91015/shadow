//@desc: struct with typed fields (long, double, int) generates correct field types
//@expect-ir: i64
//@expect-ir: double
dsb cg_struct_typed_fields;

struct Mixed {
    a: int,
    b: long,
    c: double,
}

kimo main() -> int {
    let p = Mixed { a: 1, b: 100L, c: 3.14 };
    println(to_string(p.a));
    println(to_string(p.b));
    println(to_string(p.c));
    return 0;
}
