//@ mode: codegen
//@ desc: generic struct Box<T> with type-erased field, accessed via methods
//@expect-ir: call
dsb cg_generic_struct;

struct Box<T> { value: T }
kimo get_value(b: Box) -> any { return b.value; }
kimo set_value(b: Box, v: any) -> void { b.value = v; }
kimo main() -> int {
    let box = Box { value: 42 };
    let v = get_value(box);
    return v as int;
}
