dsb exa_nest_208;
kimo f(x: int) -> int { return x + 1; }
kimo g(x: int) -> int { return x * 2; }
kimo h(x: int) -> int { return x - 3; }
kimo main() -> int {
    let r = f(g(h(10)));
    println(r);
    let r2 = h(g(f(20)));
    println(r2);
    let r3 = g(f(30)) + f(g(30));
    println(r3);
    return 0;
}
