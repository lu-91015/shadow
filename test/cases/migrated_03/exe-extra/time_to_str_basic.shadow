//@desc: date_to_str / timestamp_to_str / nanotimestamp_to_str formatting
//@expect: DATE=2023.01.15
//@expect: TS_NONEMPTY
//@expect: NTS_NONEMPTY
dsb time_to_str_basic;

kimo main() -> int {
    let d: date = date"2023.01.15";
    let ds: string = date_to_str(d);
    println("DATE=" + ds);

    // 时间戳：底层 long，格式化函数应返回非空字符串
    let t: timestamp = timestamp"2023.01.15 12:30:45.000";
    let ts: string = timestamp_to_str(t);
    if (len(ts) > 0) { println("TS_NONEMPTY"); }
    else { println("TS_EMPTY"); }

    let n: nanotimestamp = nanotimestamp"2023.01.15 12:30:45.000000000";
    let ns: string = nanotimestamp_to_str(n);
    if (len(ns) > 0) { println("NTS_NONEMPTY"); }
    else { println("NTS_EMPTY"); }

    return 0;
}
