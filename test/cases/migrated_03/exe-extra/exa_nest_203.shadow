dsb exa_nest_203;
kimo f(x: int) -> int { return x + 1; }
kimo g(x: int) -> int { return x * 2; }
kimo h(x: int) -> int { return x - 3; }
kimo main() -> int {
    let r = f(g(h(1)));
    println(r);
    let r2 = h(g(f(2)));
    println(r2);
    let r3 = g(f(3)) + f(g(3));
    println(r3);
    return 0;
}
