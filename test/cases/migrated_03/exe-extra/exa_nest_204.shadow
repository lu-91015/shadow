dsb exa_nest_204;
kimo f(x: int) -> int { return x + 1; }
kimo g(x: int) -> int { return x * 2; }
kimo h(x: int) -> int { return x - 3; }
kimo main() -> int {
    let r = f(g(h(4)));
    println(r);
    let r2 = h(g(f(5)));
    println(r2);
    let r3 = g(f(6)) + f(g(6));
    println(r3);
    return 0;
}
