//@desc: GC across array + struct + for-loop (root management)
//@expect: 7
dsb codegen_gc_lifecycle;
struct Pair { a: int, b: int }
kimo main() -> int {
    let arr = [1, 2, 3];
    let p = Pair { a: 1, b: 2 };
    let sum = 0;
    for (x in arr) {
        sum = sum + x;
    }
    println(sum + p.a); return 0;
}
