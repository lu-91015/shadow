//@desc: panic statement compiles+links (rt_panic_msg); non-taken path runs normally (bug #60)
//@expect: safe
//@expect: done
dsb cg_panic_compiles;

kimo checked_div(a: int, b: int) -> int {
    if (b == 0) {
        panic("division by zero");
    }
    return a / b;
}

kimo main() -> int {
    let r = checked_div(10, 2);
    if (r == 5) { println("safe"); }
    println("done");
    return 0;
}
