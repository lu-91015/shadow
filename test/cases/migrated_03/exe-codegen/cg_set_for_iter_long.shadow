//@desc: for (x in set<long>) iteration — count + membership (unordered, avoids pre-existing long arith bug)
//@expect: 3\n1\n1\n1\nok
dsb cg_set_for_iter_long;

kimo main() -> int {
    let s: set<long> = set_new();
    set_add(s, 1000000000L);
    set_add(s, 2000000000L);
    set_add(s, 3000000000L);
    // 重复元素不增加 size
    set_add(s, 2000000000L);

    // 迭代计数
    let count = 0;
    for (x in s) {
        count = count + 1;
    }
    println(count);  // 3

    // 迭代验证成员存在性（顺序不确定，但元素确定）
    // 注意：避免 long 算术（sum = sum + x 有 STORE_VAR 类型截断的预存 bug）
    let found_a = 0;
    let found_b = 0;
    let found_c = 0;
    for (x in s) {
        if (set_contains(s, x) == 1) {
            if (x == 1000000000L) { found_a = 1; }
            if (x == 2000000000L) { found_b = 1; }
            if (x == 3000000000L) { found_c = 1; }
        }
    }
    println(found_a);   // 1
    println(found_b);   // 1
    println(found_c);   // 1

    if (count == 3 && found_a == 1 && found_b == 1 && found_c == 1) {
        println("ok");
    }

    set_free(s);
    return 0;
}
