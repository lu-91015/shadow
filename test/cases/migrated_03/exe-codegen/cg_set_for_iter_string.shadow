//@desc: for (x in set<string>) iteration — count + membership check (unordered)
//@expect: 3\n1\n1\n1\nok
dsb cg_set_for_iter_string;

kimo main() -> int {
    let s: set<string> = set_new();
    set_add(s, "alpha");
    set_add(s, "beta");
    set_add(s, "gamma");
    // 重复元素不增加 size
    set_add(s, "alpha");

    // 迭代计数（unordered_set 顺序不确定，但元素数确定）
    let count = 0;
    for (x in s) {
        count = count + 1;
    }
    println(count);  // 3

    // 迭代验证成员存在性（每个元素只出现一次）
    let found_alpha = 0;
    let found_beta = 0;
    let found_gamma = 0;
    for (x in s) {
        if (str_eq(x, "alpha") == 1) { found_alpha = 1; }
        if (str_eq(x, "beta") == 1) { found_beta = 1; }
        if (str_eq(x, "gamma") == 1) { found_gamma = 1; }
    }
    println(found_alpha);   // 1
    println(found_beta);    // 1
    println(found_gamma);   // 1

    if (count == 3 && found_alpha == 1 && found_beta == 1 && found_gamma == 1) {
        println("ok");
    }

    set_free(s);
    return 0;
}
