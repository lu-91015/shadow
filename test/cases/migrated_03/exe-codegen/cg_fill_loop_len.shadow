//@expect: 276
//@ desc: v10_s18 填充循环强度削减的语义回归：削减后 len 在循环出口一次补上，
//@       base>0 / 多目标 / 循环后再 append / 各种不该削减的形状都必须与逐元素 push 同结果
dsb cg_fill_loop_len;

kimo mkv(i: int) -> int { return i * 3; }

kimo main() -> int {
    let sum = 0;

    // 削减命中：base=0，常量值
    let a: array<int> = [];
    let i = 0;
    while (i < 5) { a = array_push(a, 7); i = i + 1; }
    sum = sum + len(a) + a[0] + a[4];
    // 出口已补 len → 循环后的普通 push 仍要接在 5 个元素之后
    a = array_push(a, 9);
    sum = sum + len(a) + a[5];

    // 削减命中：base>0，容量必须按 n-base 给
    let b: array<int> = [];
    let j = 3;
    while (j < 10) { b = array_push(b, j); j = j + 1; }
    sum = sum + len(b) + b[0] + b[6];

    // 削减命中：值是纯表达式
    let c: array<int> = [];
    let k = 0;
    while (k < 4) { c = array_push(c, k * k); k = k + 1; }
    sum = sum + c[0] + c[1] + c[2] + c[3];

    // 削减命中：多目标共享同一计数器
    let p: array<int> = [];
    let q: array<int> = [];
    let t = 0;
    while (t < 6) { p = array_push(p, t); q = array_push(q, t + 100); t = t + 1; }
    sum = sum + p[5] + q[5];

    // 不削减（值里有调用）：len 3，r[2]=6
    let r: array<int> = [];
    let u = 0;
    while (u < 3) { r = array_push(r, mkv(u)); u = u + 1; }
    sum = sum + len(r) + r[2];

    // 不削减（体内有 if）：5 个元素 0,1,3,4,5
    let s: array<int> = [];
    let w = 0;
    while (w < 6) { if (w != 2) { s = array_push(s, w); } w = w + 1; }
    sum = sum + len(s) + s[4];

    // 不削减（元素是 8 字节指针槽）：3 个 "x"
    let g: array<string> = [];
    let y = 0;
    while (y < 3) { g = array_push(g, "x"); y = y + 1; }
    sum = sum + len(g);
    if (g[2] == "x") { sum = sum + 1; }

    // 不削减（<= 边界按下标写会越过 cap）：4 个元素 0..3
    let z: array<int> = [];
    let v2 = 0;
    while (v2 <= 3) { z = array_push(z, v2); v2 = v2 + 1; }
    sum = sum + len(z) + z[3];

    // 嵌套：外层非填充循环，内层每次新建数组（上界是变量）→ 2+3+4
    let o = 0;
    while (o < 3) {
        let lim = o + 2;
        let m: array<int> = [];
        let ii = 0;
        while (ii < lim) { m = array_push(m, 1); ii = ii + 1; }
        sum = sum + len(m);
        o = o + 1;
    }

    // 空填充：一次都不进循环，len 必须保持 0
    let e: array<int> = [];
    let ei = 0;
    while (ei < 0) { e = array_push(e, 1); ei = ei + 1; }
    sum = sum + len(e);
    let f: array<int> = [];
    let fj = 5;
    while (fj < 3) { f = array_push(f, 1); fj = fj + 1; }
    sum = sum + len(f);

    // 削减命中：自增在前（1-based 填充）→ 下标必须再减 1
    let h1: array<int> = [];
    let hi = 0;
    while (hi < 4) { hi = hi + 1; h1 = array_push(h1, hi * 2); }
    sum = sum + len(h1) + h1[0] + h1[3];

    // 削减命中：自增在前且 base>0 → 元素 11,12,13
    let h2: array<int> = [];
    let hj = 10;
    while (hj < 13) { hj = hj + 1; h2 = array_push(h2, hj); }
    sum = sum + len(h2) + h2[0] + h2[2];

    // 削减命中：同一体内两个目标分居自增两侧 → 两个下标式子各差 1
    let m1: array<int> = [];
    let m2: array<int> = [];
    let hm = 0;
    while (hm < 5) { m1 = array_push(m1, hm); hm = hm + 1; m2 = array_push(m2, hm); }
    sum = sum + len(m1) + len(m2) + m1[4] + m2[4];

    println(sum);
    return 0;
}
