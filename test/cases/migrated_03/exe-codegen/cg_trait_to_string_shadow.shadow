//@mode: exe
//@desc: FIXED — trait 方法 to_string 与 runtime 内建重名时方法优先，obj.to_string() 正确走 trait 静态分发
//@expect: Foo
//@pos: 修复（2026-09-17）：内置名与 struct receiver 同名方法冲突时方法优先（tc_check_call 内置白名单分支内先做 receiver 方法分发）
// 复现（2026-08-19 实证）：
//   impl ToString for Foo { to_string(self:any)->string{ return "Foo"; } }
//   println(f.to_string())  ->  实际输出 0（RC=0，无任何诊断）
// 对照：方法名改为 describe 后，self:any 与 self:Self 两种写法均正确输出 "Foo"，
//   证明根因是名字冲突（与 self 类型无关）。
// 同类佐证：tc/tc_trait_parse.shadow 也用 to_string 但只测编译（@expect-ir: define），
//   未覆盖运行分发，故未被发现。
dsb cg_trait_to_string_shadow;

trait ToString {
    kimo to_string(self: any) -> string;
}

struct Foo { x: int; }

impl ToString for Foo {
    kimo to_string(self: any) -> string {
        return "Foo";
    }
}

kimo main() -> int {
    let f = Foo { x: 42 };
    println(f.to_string());
    return 0;
}
