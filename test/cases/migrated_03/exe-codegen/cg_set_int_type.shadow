//@desc: set<int> add/contains/remove/size + dedup
//@expect: 0\n1\n1\n0\n2\n1\n1\n0
dsb cg_set_int_type;

kimo main() -> int {
    let s: set<int> = set_new();

    // 初始为空
    println(set_size(s));              // 0
    println(set_contains(s, 42));      // 0

    // 添加 int 元素
    set_add(s, 42);
    set_add(s, 7);
    set_add(s, 42);                    // 重复元素，不应增加 size

    println(set_contains(s, 42));       // 1
    println(set_contains(s, 7));        // 1
    println(set_contains(s, 100));     // 0

    println(set_size(s));              // 2（42 去重）

    // 删除元素
    println(set_remove(s, 42));        // 1
    println(set_contains(s, 42));      // 0
    println(set_size(s));             // 1

    set_free(s);
    return 0;
}
