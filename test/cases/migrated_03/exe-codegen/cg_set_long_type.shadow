//@desc: set<long> add/contains/remove + dedup with large values
//@expect: 0\n1\n1\n0\n2\n1\n1\n0
dsb cg_set_long_type;

kimo main() -> int {
    let s: set<long> = set_new();

    // 初始为空
    println(set_size(s));                // 0
    println(set_contains(s, 1000000L));  // 0

    // 添加 long 元素（大数确保 long 语义）
    set_add(s, 1000000L);
    set_add(s, 999999999L);
    set_add(s, 1000000L);                // 重复元素，不应增加 size

    println(set_contains(s, 1000000L));    // 1
    println(set_contains(s, 999999999L));  // 1
    println(set_contains(s, 1L));          // 0

    println(set_size(s));               // 2（1000000L 去重）

    // 删除元素
    println(set_remove(s, 1000000L));     // 1
    println(set_contains(s, 1000000L));   // 0
    println(set_size(s));               // 1

    set_free(s);
    return 0;
}
