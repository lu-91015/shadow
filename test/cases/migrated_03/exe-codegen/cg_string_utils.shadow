//@desc: L4 string utilities — contains/starts_with/ends_with/index_of/replace/trim/upper/lower/char_at
//@expect: 1\n0\n1\n1\n6\nhelloworld\nhello world\nHELLO\nworld\ne
dsb cg_string_utils;
// str_contains / starts_with / ends_with 用 str_eq + substr2 实现
kimo str_contains(s: string, sub: string) -> int {
    let slen = len(s);
    let sublen = len(sub);
    if (sublen > slen) { return 0; }
    if (sublen == 0) { return 1; }
    let i = 0;
    while (i <= slen - sublen) {
        let candidate = substr2(s, i, i + sublen);
        if (str_eq(candidate, sub) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

kimo str_starts_with(s: string, prefix: string) -> int {
    let slen = len(s);
    let plen = len(prefix);
    if (plen > slen) { return 0; }
    if (plen == 0) { return 1; }
    let candidate = substr2(s, 0, plen);
    if (str_eq(candidate, prefix) == 1) { return 1; }
    return 0;
}

kimo str_ends_with(s: string, suffix: string) -> int {
    let slen = len(s);
    let sulen = len(suffix);
    if (sulen > slen) { return 0; }
    if (sulen == 0) { return 1; }
    let start = slen - sulen;
    let candidate = substr2(s, start, slen);
    if (str_eq(candidate, suffix) == 1) { return 1; }
    return 0;
}

kimo main() -> int {
    let s = "hello world";
    // contains / starts_with / ends_with
    println(str_contains(s, "world"));      // 1
    println(str_contains(s, "xyz"));          // 0
    println(str_starts_with(s, "hello"));    // 1
    println(str_ends_with(s, "world"));      // 1
    // L4：直接绑定 runtime 的字符串处理函数
    println(str_index_of(s, "world"));      // 6
    println(str_replace(s, " ", ""));        // helloworld
    println(str_trim("  hello world  "));    // hello world
    println(str_to_upper("hello"));          // HELLO
    println(str_to_lower("WORLD"));          // world
    println(str_char_at("hello", 1));        // e
    return 0;
}
