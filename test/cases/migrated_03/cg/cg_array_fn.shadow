//@mode: exe
//@desc: Array as function parameter and return value
//@expect-stdout: 1
//@expect-stdout: 2
//@expect-stdout: 3
//@expect-stdout: 10
//@expect-stdout: 3
dsb cg_array_fn;

kimo sum_array(arr: array) -> int {
    let total = 0;
    let i = 0;
    while (i < len(arr)) {
        total = total + arr[i];
        i = i + 1;
    }
    return total;
}

kimo modify_array(arr: array) -> array {
    arr[0] = 10;
    return arr;
}

kimo main() -> int {
    let data = [1, 2, 3];
    // array as parameter
    let i = 0;
    while (i < len(data)) {
        println(to_string(data[i]));
        i = i + 1;
    }

    // array passed to function and modified
    let modified = modify_array(data);
    println(to_string(modified[0]));

    // array as return value — get length
    println(to_string(len(modified)));

    return 0;
}
