//@mode: exe
dsb cg_array_simple;
// simplified array param test
kimo get_first(arr: array) -> int {
    // 无元素类型的裸 array 下标结果为 any，需显式 as int
    //（对齐 0.3 正式用例 test/cases/codegen|exe-codegen/cg_array_simple.shadow；
    //  0.3 的 cg/ 是手工草稿目录，不参与自动化测试，此版本 0.3 自身也编译不过）
    return arr[0] as int;
}

kimo main() -> int {
    let data = [42, 7];
    let x = get_first(data);
    println(to_string(x));
    return 0;
}
