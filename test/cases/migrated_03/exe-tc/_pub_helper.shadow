dsb _pub_helper;
// Helper module for pub visibility tests
pub struct PubBox { value: int }
struct PrivBox { value: int }
pub enum PubColor { Red, Green, Blue }
enum PrivColor { A, B, C }
pub kimo get_pub_box_value(b: PubBox) -> int { return b.value; }
pub kimo pub_color_val(c: PubColor) -> int {
    if (c == PubColor.Red) { return 0; }
    if (c == PubColor.Green) { return 1; }
    return 2;
}
kimo get_priv_box_value(b: PrivBox) -> int { return b.value; }
kimo priv_color_val(c: PrivColor) -> int { return 0; }
