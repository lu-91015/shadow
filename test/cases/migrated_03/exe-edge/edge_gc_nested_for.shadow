//@desc: GC nested for loops with struct alloc in inner loop
//@expect: 18
dsb edge_gc_nested_for;
struct P { x: int, y: int }
kimo main() -> int {
    let outer = [1, 2, 3];
    let inner = [4, 5, 6];
    let sum = 0;
    for (o in outer) {
        for (i in inner) {
            let p = P { x: o, y: i };
            sum = sum + p.x;
        }
    }
    println(sum); return 0;
}
