//@desc: deeply nested if (12 levels) codegens without crashing
//@expect: 1
dsb edge_deep_if;
kimo f(x: int) -> int {
    if (x > 0) {
        if (x > 1) {
            if (x > 2) {
                if (x > 3) {
                    if (x > 4) {
                        if (x > 5) {
                            if (x > 6) {
                                if (x > 7) {
                                    if (x > 8) {
                                        if (x > 9) {
                                            if (x > 10) {
                                                if (x > 11) {
                                                    return 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return 0;
}
kimo main() -> int { println(f(20)); return 0; }
