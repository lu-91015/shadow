//@desc: GC deeply nested if-else with struct alloc at each level
//@expect: 1
dsb edge_gc_deep_nested_if;
struct P { x: int, y: int }
kimo main() -> int {
    let a = 1;
    if (a > 0) {
        if (a > 0) {
            if (a > 0) {
                let p = P { x: 1, y: 2 };
                println(p.x); return 0;
            }
        }
    }
    println(0); return 0;
}
