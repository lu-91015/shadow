//@desc: chained `any` member access (box struct, access two fields)
//@expect-ir: shadow_any_
dsb edge_any_member_chain;
struct Point { x: int, y: int }
kimo main() -> int {
    let p = Point { x: 3, y: 4 };
    let a = p as any;
    let vx = a.x as int;
    let vy = a.y as int;
    return vx + vy;
}
