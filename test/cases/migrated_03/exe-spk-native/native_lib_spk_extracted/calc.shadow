dsb calc;
// native_lib 包内的 Shadow 模块
// 声明 @extern 函数返回 opaque 句柄（64 位，不截断）
// 实际实现位于 native/calc_bind.cpp（由 [native] 节声明，编译器自动编译链接）

// 创建一个存储 int 值的 opaque 句柄
@extern("rt_calc_create") kimo rt_calc_create(value: int) -> opaque { return null as opaque; }

// 读取句柄存储的值并加上 addend，返回结果
@extern("rt_calc_add") kimo rt_calc_add(handle: opaque, addend: int) -> int { return 0; }

// pub 包装函数：创建句柄存储 value，再读取并加上 value，得到 2*value
pub kimo calc_double(value: int) -> int {
    let h = rt_calc_create(value);
    return rt_calc_add(h, value);
}
