//@desc: GC mark-sweep end-to-end test
dsb tc_gc_test;

@extern("shadow_gc_collect") kimo gc_collect() -> long { return 0; }

kimo main() -> int {
    let arr1 = [1, 2, 3];
    let arr2 = [4, 5, 6];
    let before = gc_collect();
    arr1 = [];
    arr2 = [];
    let freed = gc_collect();
    if (freed > 0) {
        return 1;
    }
    return 0;
}
