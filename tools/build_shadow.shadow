// Shadow 0.5 — 自举构建脚本（Shadow 原生版，替代 build_shadow.sh）
//
// 自举接力：本文件由【冻结的 build/shadow.exe】编译为 build/build_shadow.exe
// （鸡生蛋问题的标准解法：用上一轮的编译器编出本轮的构建工具）。运行时执行
// 7 阶段自举：预编译 rt 对象 -> 冻结 HOST 编 stage1 -> 逐级自举 stage2/3 ->
// 固定点验证 -> 部署为 build/shadow.exe -> 编全部 rt/*.c -> 冒烟。
//
// 用法（仓库根执行）：
//   export LLVM_HOME="D:/llvm/clang+llvm-22.1.0-x86_64-pc-windows-msvc"
//   build/build_shadow.exe
//   # 可选：用外部引导器冷启动（替代默认的 build/shadow.exe）
//   set BUILD_HOST=other/shadow.exe  &&  build/build_shadow.exe
//
// 说明：
//   - rt_sys_exec 由编译器作为内建提供（无需 @extern）；env_get 需显式声明。
//   - 全程相对路径（cwd=仓库根），LLVM 路径与 bootstrap/ 均不含空格。
//   - rt_sys_exec 只回传 stdout+stderr、不回传退出码；用「产物是否非空 /
//     字节比对」近似原 .sh 的 set -e 与 python verify_fixed_point.py 语义。

dsb build_shadow;

@extern("shadow_env_get") kimo env_get(name: string) -> string { return ""; }
@extern("rt_read_bytes") kimo rt_read_bytes(path: any) -> any { return 0 as any; }
@extern("rt_buf_len") kimo rt_buf_len(p: any) -> int { return 0; }
@extern("rt_write_bytes") kimo rt_write_bytes(path: any, p: any, n: int) -> int { return 0; }
@extern("shadow_get_byte") kimo rt_get_byte(p: any, off: int) -> int { return 0; }

kimo file_ok(path: string) -> int {
    let b = rt_read_bytes(path);
    if (rt_buf_len(b) > 0) { return 1; }
    return 0;
}

kimo files_equal(a: string, b: string) -> int {
    let ba = rt_read_bytes(a);
    let bb = rt_read_bytes(b);
    let la = rt_buf_len(ba);
    let lb = rt_buf_len(bb);
    if (la != lb) { return 0; }
    let i = 0;
    while (i < la) {
        if (rt_get_byte(ba, i) != rt_get_byte(bb, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

kimo file_copy(a: string, b: string) -> int {
    let src = rt_read_bytes(a);
    let n = rt_buf_len(src);
    return rt_write_bytes(b, src, n);
}

kimo main() -> int {
    let llvm = env_get("LLVM_HOME");
    if (len(llvm) == 0) {
        println("set LLVM_HOME to your LLVM installation (e.g. D:/llvm/clang+llvm-XX)");
        return 1;
    }
    let bin = llvm + "/bin";
    let clang_c = bin + "/clang.exe";
    let clang = bin + "/clang++.exe";
    let llc = bin + "/llc.exe";
    let objcopy = bin + "/llvm-objcopy.exe";
    let rt_lib = llvm + "/lib";
    let boot = "bootstrap";

    // HOST 引导器：默认用上一轮自举产物 build/shadow.exe；可用 BUILD_HOST 覆盖。
    let host = env_get("BUILD_HOST");
    if (len(host) == 0) { host = "build/shadow.exe"; }
    println("build_shadow (shadow): LLVM_HOME=" + llvm + "  HOST=" + host);

    // 确保 build/rt 存在（等效 mkdir -p build/rt）
    rt_sys_exec("cmd /c mkdir build\\rt");

    // [0/7] precompile rt_zip.o + shadow_gc_supplement.o
    println("[0/7] precompile rt_zip.o + shadow_gc_supplement.o");
    rt_sys_exec(clang_c + " -O0 -I " + boot + " -c rt/rt_zip.c -o build/rt/rt_zip.o");
    rt_sys_exec(clang_c + " -O0 -c rt/shadow_gc_supplement.c -o build/rt/shadow_gc_supplement.o");
    rt_sys_exec(clang_c + " -O1 -Wall -c rt/shadow_index.c -o build/rt/shadow_index.o");
    rt_sys_exec(clang_c + " -O0 -I " + boot + " -c rt/rt_proc_spawn.c -o build/rt/rt_proc_spawn.o");
    // 用户程序 runtime 的辅助对象（main_link_exe 从 self_dir/rt/ 精确取这些名字）
    // miniz：源与头均已入库（bootstrap/miniz.c + miniz.h），一律现编，绝不复制预编译 .o。
    // 同时产出 bootstrap/miniz.o —— [1/7]/[2/7] 的 stage 链接行直接引用该路径。
    rt_sys_exec(clang_c + " -O1 -I " + boot + " -c " + boot + "/miniz.c -o " + boot + "/miniz.o");
    rt_sys_exec(clang_c + " -O1 -I " + boot + " -c " + boot + "/miniz.c -o build/rt/miniz.o");
    rt_sys_exec(clang_c + " -O0 -I " + boot + " -c bootstrap/cxa_atexit_shim.c -o build/rt/cxa_atexit_shim.o");

    // [0.4/7] patch runtime: CreateProcessA shadow_sys_exec
    println("[0.4/7] patch runtime: CreateProcessA shadow_sys_exec");
    rt_sys_exec(clang_c + " -O0 -I " + boot + " -c bootstrap/sys_exec_cpa.c -o build/rt/sys_exec_cpa.o");
    // runtime_for_selfhost.o 一律从源码现编：它是下面 wk.o / user.o 的唯一母本。
    // 沿用已提交的 .o 会让 rt/ 的改动被静默忽略，而 fixed-point 只逐字节比 .ll、看不见 .o 漂移
    // （历史事故：c0819b2 源码正确、.o 陈旧，ex_gc_longrun 被误判为"修了没用"）。
    // 不再需要 -I build/linux —— miniz.h 已经 bootstrap/ 经 -I bootstrap 解析。
    rt_sys_exec(clang + " -O1 -c rt/linux/runtime_for_selfhost.cpp -o " + boot + "/runtime_for_selfhost.o"
        + " -I " + boot + " -I " + llvm + "/include -std=c++17 -D_CRT_SECURE_NO_WARNINGS -w");
    // 运行时符号重命名：stage1.o 内含 shadow-lang 标准库实现（shadow_string_concat 等强符号），
    // runtime_for_selfhost.o 的 C++ 同名实现必须加 __cpp_ 前缀避免重复符号；shadow_sys_exec 走
    // CreateProcessA 补丁（sys_exec_cpa.o）。rt_alloc_cap 为新增原语，保留原名供编译器链接。
    rt_sys_exec(objcopy
        + " --redefine-sym=shadow_sys_exec=shadow_sys_exec_blob"
        + " --redefine-sym=shadow_any_box_ptr=__cpp_shadow_any_box_ptr"
        + " --redefine-sym=shadow_any_box_string=__cpp_shadow_any_box_string"
        + " --redefine-sym=shadow_any_print=__cpp_shadow_any_print"
        + " --redefine-sym=shadow_any_to_string=__cpp_shadow_any_to_string"
        + " --redefine-sym=shadow_any_unbox_ptr=__cpp_shadow_any_unbox_ptr"
        + " --redefine-sym=shadow_array_get_int=__cpp_shadow_array_get_int"
        + " --redefine-sym=shadow_array_get_ptr=__cpp_shadow_array_get_ptr"
        + " --redefine-sym=shadow_array_len=__cpp_shadow_array_len"
        + " --redefine-sym=shadow_array_pop=__cpp_shadow_array_pop"
        + " --redefine-sym=shadow_array_push_float=__cpp_shadow_array_push_float"
        + " --redefine-sym=shadow_array_push_int=__cpp_shadow_array_push_int"
        + " --redefine-sym=shadow_array_push_long=__cpp_shadow_array_push_long"
        + " --redefine-sym=shadow_array_push_ptr=__cpp_shadow_array_push_ptr"
        + " --redefine-sym=shadow_array_set_int=__cpp_shadow_array_set_int"
        + " --redefine-sym=shadow_array_set_ptr=__cpp_shadow_array_set_ptr"
        + " --redefine-sym=shadow_content_hash=__cpp_shadow_content_hash"
        + " --redefine-sym=shadow_gc_poll=__cpp_shadow_gc_poll"
        + " --redefine-sym=shadow_gc_register_type=__cpp_shadow_gc_register_type"
        + " --redefine-sym=shadow_gc_root_range=__cpp_shadow_gc_root_range"
        + " --redefine-sym=shadow_int_to_str=__cpp_shadow_int_to_str"
        + " --redefine-sym=shadow_llvm_set_alwaysinline=__cpp_shadow_llvm_set_alwaysinline"
        + " --redefine-sym=shadow_println_int=__cpp_shadow_println_int"
        + " --redefine-sym=shadow_println_str=__cpp_shadow_println_str"
        + " --redefine-sym=shadow_set_cli_args=__cpp_shadow_set_cli_args"
        + " --redefine-sym=shadow_string_concat=__cpp_shadow_string_concat"
        + " --redefine-sym=shadow_string_len=__cpp_shadow_string_len"
        + " --redefine-sym=shadow_sys_args=__cpp_shadow_sys_args"
        + " --redefine-sym=shadow_zip_list=__cpp_shadow_zip_list"
        + " --redefine-sym=shadow_zip_pack=__cpp_shadow_zip_pack"
        + " --redefine-sym=shadow_zip_unpack=__cpp_shadow_zip_unpack"
        + " " + boot + "/runtime_for_selfhost.o build/rt/runtime_for_selfhost_wk.o");
    // 用户程序专用 runtime（main_link_exe Windows 分支链接用，与 Linux 同源 cpp 实现）：
    // 用户产物内嵌 runtime_lib 的 define（shadow_array_len 等强符号）会与 C++ runtime 同名
    // 冲突 → 这些符号加 __cpp_ 前缀；GC 符号（gc_poll/gc_root_range/gc_register_type）保留
    // 原名（真 GC，对齐 Linux 用户产物链接 runtime_for_selfhost.o 的行为）。
    // shadow_sys_exec 走 sys_exec_cpa.o。不链接 shadow_gc_supplement.o（no-op GC）——用户产物必须用真 GC。
    rt_sys_exec(objcopy
        + " --redefine-sym=shadow_sys_exec=__cpp_shadow_sys_exec"
        + " --redefine-sym=shadow_any_box_ptr=__cpp_shadow_any_box_ptr"
        + " --redefine-sym=shadow_any_box_string=__cpp_shadow_any_box_string"
        + " --redefine-sym=shadow_any_print=__cpp_shadow_any_print"
        + " --redefine-sym=shadow_any_to_string=__cpp_shadow_any_to_string"
        + " --redefine-sym=shadow_any_unbox_ptr=__cpp_shadow_any_unbox_ptr"
        + " --redefine-sym=shadow_array_get_int=__cpp_shadow_array_get_int"
        + " --redefine-sym=shadow_array_get_ptr=__cpp_shadow_array_get_ptr"
        + " --redefine-sym=shadow_array_len=__cpp_shadow_array_len"
        + " --redefine-sym=shadow_array_pop=__cpp_shadow_array_pop"
        + " --redefine-sym=shadow_array_push_float=__cpp_shadow_array_push_float"
        + " --redefine-sym=shadow_array_push_int=__cpp_shadow_array_push_int"
        + " --redefine-sym=shadow_array_push_long=__cpp_shadow_array_push_long"
        + " --redefine-sym=shadow_array_push_ptr=__cpp_shadow_array_push_ptr"
        + " --redefine-sym=shadow_array_set_int=__cpp_shadow_array_set_int"
        + " --redefine-sym=shadow_array_set_ptr=__cpp_shadow_array_set_ptr"
        + " --redefine-sym=shadow_content_hash=__cpp_shadow_content_hash"
        + " --redefine-sym=shadow_int_to_str=__cpp_shadow_int_to_str"
        + " --redefine-sym=shadow_llvm_set_alwaysinline=__cpp_shadow_llvm_set_alwaysinline"
        + " --redefine-sym=shadow_println_int=__cpp_shadow_println_int"
        + " --redefine-sym=shadow_println_str=__cpp_shadow_println_str"
        + " --redefine-sym=shadow_set_cli_args=__cpp_shadow_set_cli_args"
        + " --redefine-sym=shadow_string_concat=__cpp_shadow_string_concat"
        + " --redefine-sym=shadow_string_len=__cpp_shadow_string_len"
        + " --redefine-sym=shadow_sys_args=__cpp_shadow_sys_args"
        + " --redefine-sym=shadow_zip_list=__cpp_shadow_zip_list"
        + " --redefine-sym=shadow_zip_pack=__cpp_shadow_zip_pack"
        + " --redefine-sym=shadow_zip_unpack=__cpp_shadow_zip_unpack"
        + " " + boot + "/runtime_for_selfhost.o build/rt/runtime_for_selfhost_user.o");
    println("    wrote build/rt/runtime_for_selfhost_user.o (user-program runtime, GC kept)");

    // [1/7] stage1: HOST compile src/main.shadow
    println("[1/7] stage1: HOST(" + host + ") compile src/main.shadow");
    rt_sys_exec(host + " src/main.shadow -o build/stage1.ll");
    if (file_ok("build/stage1.ll") == 0) { println("[X] stage1.ll empty"); return 1; }
    rt_sys_exec(llc + " -O0 -filetype=obj build/stage1.ll -o build/stage1.o");
    // /Brepro：让 lld 写入内容派生的固定 TimeDateStamp 而非当前时间。
    // 否则每次自举 build/shadow.exe 都会差 1~2 字节（偏移 129 起的时间戳），
    // 在按字节比对的验证文化里制造假漂移（A/B 对照与 git 状态噪音）。
    rt_sys_exec(clang + " -std=c++17 build/stage1.o build/rt/runtime_for_selfhost_wk.o " + boot + "/miniz.o build/rt/shadow_gc_supplement.o build/rt/rt_zip.o build/rt/shadow_index.o build/rt/rt_proc_spawn.o build/rt/sys_exec_cpa.o build/rt/cxa_atexit_shim.o -o build/shadow-stage1.exe -Wl,/subsystem:console -Wl,/Brepro -Wl,/stack:8388608 -lws2_32 -lLLVM-C -L" + rt_lib + " -Lpkg/shadow/llvm/crt");
    println("    wrote build/shadow-stage1.exe");

    // [2/7] stage2: shadow-stage1 compile src/main.shadow
    println("[2/7] stage2: shadow-stage1 compile src/main.shadow");
    rt_sys_exec("build/shadow-stage1.exe src/main.shadow -o build/stage2.ll");
    if (file_ok("build/stage2.ll") == 0) { println("[X] stage2.ll empty"); return 1; }
    rt_sys_exec(llc + " -O0 -filetype=obj build/stage2.ll -o build/stage2.o");
    rt_sys_exec(clang + " -std=c++17 build/stage2.o build/rt/runtime_for_selfhost_wk.o " + boot + "/miniz.o build/rt/shadow_gc_supplement.o build/rt/rt_zip.o build/rt/shadow_index.o build/rt/rt_proc_spawn.o build/rt/sys_exec_cpa.o build/rt/cxa_atexit_shim.o -o build/shadow-stage2.exe -Wl,/subsystem:console -Wl,/Brepro -Wl,/stack:8388608 -lws2_32 -lLLVM-C -L" + rt_lib + " -Lpkg/shadow/llvm/crt");
    println("    wrote build/shadow-stage2.exe");

    // [3/7] stage3: shadow-stage2 compile src/main.shadow
    println("[3/7] stage3: shadow-stage2 compile src/main.shadow");
    rt_sys_exec("build/shadow-stage2.exe src/main.shadow -o build/stage3.ll");
    if (file_ok("build/stage3.ll") == 0) { println("[X] stage3.ll empty"); return 1; }
    println("    wrote build/stage3.ll");

    // [4/7] verify fixed-point (替代 python verify_fixed_point.py：字节比对)
    println("[4/7] verify fixed-point");
    if (files_equal("build/stage2.ll", "build/stage3.ll") == 1) {
        println("FIXEDPOINT_OK stage2==stage3");
    } else {
        println("[X] stage2 != stage3");
        return 1;
    }

    // [5/7] final artifact shadow.exe
    println("[5/7] final artifact shadow.exe");
    file_copy("build/shadow-stage2.exe", "build/shadow.exe");
    println("    wrote build/shadow.exe");

    // [6/7] compile rt/ system-call layer
    println("[6/7] compile rt/ system-call layer");
    // 用户产物运行时对象用 -O2：分配器/字符串/数组原语加速所有用户程序。
    rt_sys_exec(clang_c + " -O2 -I " + boot + " -c rt/rt_core.c -o build/rt/rt_core.o");
    rt_sys_exec(clang_c + " -O2 -I " + boot + " -c rt/rt_fs.c -o build/rt/rt_fs.o");
    rt_sys_exec(clang_c + " -O2 -I " + boot + " -c rt/rt_proc.c -o build/rt/rt_proc.o");
    rt_sys_exec(clang_c + " -O2 -I " + boot + " -c rt/rt_proc_spawn.c -o build/rt/rt_proc_spawn.o");
    rt_sys_exec(clang_c + " -O2 -I " + boot + " -c rt/rt_time.c -o build/rt/rt_time.o");
    rt_sys_exec(clang_c + " -O2 -I " + boot + " -c rt/rt_err.c -o build/rt/rt_err.o");
    rt_sys_exec(clang_c + " -O2 -I " + boot + " -c rt/rt_extra.c -o build/rt/rt_extra.o");
    rt_sys_exec(clang_c + " -O2 -I " + boot + " -c rt/rt_gc.c -o build/rt/rt_gc.o");
    rt_sys_exec(clang_c + " -O2 -I " + boot + " -c rt/rt_thread.c -o build/rt/rt_thread.o");
    rt_sys_exec(clang_c + " -O2 -I " + boot + " -c rt/rt_io.c -o build/rt/rt_io.o");

    // [7/7] smoke --version
    println("[7/7] smoke --version");
    rt_sys_exec("build/shadow.exe --version");

    println("done");
    return 0;
}
