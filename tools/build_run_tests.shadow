// Shadow 0.5 — 构建脚本（Shadow 原生版，替代 tools/build_run_tests.sh）
//
// 自举接力：本文件由【上一轮自举产物 build/shadow.exe】编译为 build/build_run_tests.exe
// （鸡生蛋问题的标准解法：用上一轮的编译器编出本轮的构建工具），运行时再调用
// build/shadow.exe 把 test/run_tests.shadow 编成 build/run_tests.exe。
//
// 用法（仓库根执行）：
//   export LLVM_HOME="D:/llvm/clang+llvm-22.1.0-x86_64-pc-windows-msvc"
//   build/build_run_tests.exe          # 编译 + 链接 -> build/run_tests.exe
//
// 说明：
//   - 本程序是独立 Shadow 程序：rt_sys_exec 由编译器作为内建提供（无需 @extern）；
//     env_get 需显式 @extern 声明（见下）。
//   - 全程使用相对路径（cwd=仓库根），LLVM 路径与 rt/ 均不含空格，
//     天然避开 CreateProcessA 的空格路径坑（与 cpa 版 shadow_sys_exec 配合）。
//   - rt_sys_exec 只回传 stdout+stderr、不回传退出码；故失败判定靠「产物是否产生 /
//     末尾用 run_tests.exe --list 冒烟」近似（等价于 .sh 的 set -e）。

dsb build_run_tests;

// env_get 非内建，需显式 @extern 声明后由 runtime_for_selfhost_wk.o 提供实现。
@extern("shadow_env_get") kimo env_get(name: string) -> string { return ""; }

kimo main() -> int {
    let llvm = env_get("LLVM_HOME");
    if (len(llvm) == 0) {
        println("set LLVM_HOME to your LLVM installation (e.g. D:/llvm/clang+llvm-XX)");
        return 1;
    }
    let bin = llvm + "/bin";
    let clang_c = bin + "/clang.exe";
    let clang = bin + "/clang++.exe";
    let llc = bin + "/llc.exe";
    let objcopy = bin + "/llvm-objcopy.exe";
    let boot = "rt";

    println("build_run_tests (shadow): LLVM_HOME=" + llvm);

    // [0] 预编译 rt 对象（与 build_shadow.sh [0/7] 一致）
    println("[0] precompile rt objects");
    rt_sys_exec(clang_c + " -O0 -I " + boot + " -c rt/rt_zip.c -o build/rt/rt_zip.o");
    rt_sys_exec(clang_c + " -O1 -Wall -c rt/shadow_index.c -o build/rt/shadow_index.o");
    rt_sys_exec(clang_c + " -O0 -I " + boot + " -c rt/rt_proc_spawn.c -o build/rt/rt_proc_spawn.o");
    rt_sys_exec(clang_c + " -O0 -I " + boot + " -c rt/rt_test_par.c -o build/rt/rt_test_par.o");
    rt_sys_exec(clang_c + " -O0 -I " + boot + " -c " + boot + "/cxa_atexit_shim.c -o build/rt/cxa_atexit_shim.o");

    // [0.4] runtime patch：shadow_sys_exec 改用 CreateProcessA（含空格路径可启动）；
    // run_tests.exe 是普通 Shadow 程序，使用【用户态 runtime = user.o】：
    //   - 内建（shadow_array_len 等）加 __cpp_ 前缀，与编译器内联进 run_tests.o 的
    //     同名强符号不冲突；
    //   - GC 符号（gc_poll/gc_root_range/gc_register_type）保留原名 = 真 GC；
    //   - 不链接 shadow_gc_supplement.o（no-op GC，仅编译器 wk 版使用）；
    //   - sys_exec_cpa.o 提供 shadow_sys_exec，故 user.o 的 shadow_sys_exec 须改名让位。
    // 依赖 build/rt/runtime_for_selfhost.o（由 bootstrap.sh / rebuild_win_runtime.sh 产出）。
    println("[0.4] patch runtime: user.o (CreateProcessA shadow_sys_exec)");
    rt_sys_exec(clang_c + " -O0 -I " + boot + " -c " + boot + "/sys_exec_cpa.c -o build/rt/sys_exec_cpa.o");
    rt_sys_exec(objcopy +
        " --redefine-sym=shadow_sys_exec=__cpp_shadow_sys_exec" +
        " --redefine-sym=shadow_any_box_ptr=__cpp_shadow_any_box_ptr" +
        " --redefine-sym=shadow_any_box_string=__cpp_shadow_any_box_string" +
        " --redefine-sym=shadow_any_print=__cpp_shadow_any_print" +
        " --redefine-sym=shadow_any_to_string=__cpp_shadow_any_to_string" +
        " --redefine-sym=shadow_any_unbox_ptr=__cpp_shadow_any_unbox_ptr" +
        " --redefine-sym=shadow_array_get_int=__cpp_shadow_array_get_int" +
        " --redefine-sym=shadow_array_get_ptr=__cpp_shadow_array_get_ptr" +
        " --redefine-sym=shadow_array_len=__cpp_shadow_array_len" +
        " --redefine-sym=shadow_array_pop=__cpp_shadow_array_pop" +
        " --redefine-sym=shadow_array_push_float=__cpp_shadow_array_push_float" +
        " --redefine-sym=shadow_array_push_int=__cpp_shadow_array_push_int" +
        " --redefine-sym=shadow_array_push_long=__cpp_shadow_array_push_long" +
        " --redefine-sym=shadow_array_push_ptr=__cpp_shadow_array_push_ptr" +
        " --redefine-sym=shadow_array_set_int=__cpp_shadow_array_set_int" +
        " --redefine-sym=shadow_array_set_ptr=__cpp_shadow_array_set_ptr" +
        " --redefine-sym=shadow_content_hash=__cpp_shadow_content_hash" +
        " --redefine-sym=shadow_int_to_str=__cpp_shadow_int_to_str" +
        " --redefine-sym=shadow_llvm_set_alwaysinline=__cpp_shadow_llvm_set_alwaysinline" +
        " --redefine-sym=shadow_println_int=__cpp_shadow_println_int" +
        " --redefine-sym=shadow_println_str=__cpp_shadow_println_str" +
        " --redefine-sym=shadow_set_cli_args=__cpp_shadow_set_cli_args" +
        " --redefine-sym=shadow_string_concat=__cpp_shadow_string_concat" +
        " --redefine-sym=shadow_string_len=__cpp_shadow_string_len" +
        " --redefine-sym=shadow_sys_args=__cpp_shadow_sys_args" +
        " --redefine-sym=shadow_zip_list=__cpp_shadow_zip_list" +
        " --redefine-sym=shadow_zip_pack=__cpp_shadow_zip_pack" +
        " --redefine-sym=shadow_zip_unpack=__cpp_shadow_zip_unpack" +
        " "build/rt/runtime_for_selfhost.o build/rt/runtime_for_selfhost_user.o");

    // [1] 用上一轮自举产物 HOST 编译 test/run_tests.shadow
    println("[1] compile test/run_tests.shadow -> build/run_tests.ll");
    rt_sys_exec("build/shadow.exe test/run_tests.shadow -o build/run_tests.ll");
    // [2] llc -> .o
    println("[2] llc -> build/run_tests.o");
    rt_sys_exec(llc + " -O0 -filetype=obj build/run_tests.ll -o build/run_tests.o");
    // [3] clang++ 链接 -> build/run_tests.exe（用户程序 runtime：user.o + cxa_atexit_shim，
    //     不链 shadow_gc_supplement.o；-Lpkg/shadow/llvm/crt 提供 winhttp.lib 等）
    println("[3] clang++ link -> build/run_tests.exe");
    rt_sys_exec(clang + " -std=c++17 build/run_tests.o" +
        " build/rt/runtime_for_selfhost_user.o "build/rt/miniz.o" +
        " build/rt/rt_zip.o build/rt/shadow_index.o" +
        " build/rt/rt_proc_spawn.o build/rt/rt_test_par.o build/rt/sys_exec_cpa.o" +
        " build/rt/cxa_atexit_shim.o" +
        " -o build/run_tests.exe -Wl,/subsystem:console -Wl,/Brepro -lws2_32 -lLLVM-C -L" + llvm + "/lib -Lpkg/shadow/llvm/crt");

    // 冒烟：run_tests.exe 能列出 tc 用例即代表链接产物可用
    let smoke = rt_sys_exec("build/run_tests.exe --cases test/cases/tc --list");
    if (len(smoke) > 0) {
        println("done. wrote build/run_tests.exe (" + int_to_str(len(smoke)) + " bytes of --list output)");
        return 0;
    }
    println("[X] build/run_tests.exe not produced or failed to run");
    return 1;
}
