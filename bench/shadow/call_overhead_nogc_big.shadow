// 隔离测试3：@nogc 主循环调用 rt_strlen，N=3000000 验证线性扩展
dsb call_overhead_nogc_big;

@nogc kimo loop(s: string) -> int {
    let total = 0;
    let i = 0;
    while (i < 3000000) {
        total = total + rt_strlen(s);
        i = i + 1;
    }
    return total;
}

kimo main() -> int {
    let s = "the quick brown fox jumps over the lazy dog";
    println(loop(s));
    return 0;
}
