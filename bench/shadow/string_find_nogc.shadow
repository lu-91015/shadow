// 基准测试：字符串查找（str_index_of 朴素匹配）@nogc 版
dsb string_find_nogc;

@nogc kimo main() -> int {
    let s = "the quick brown fox jumps over the lazy dog";
    let needle = "lazy";
    let total = 0;
    let i = 0;
    while (i < 300000) {
        total = total + str_index_of(s, needle);
        i = i + 1;
    }
    println(total);
    return 0;
}
