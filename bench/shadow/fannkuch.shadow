// fannkuch-redux：排列翻转（整数，迭代置换）
// 与 bench/go/fannkuch.go 同算法、同 N=10。
dsb fannkuch;

kimo main() -> int {
    let n = 10;
    let perm1: array<int> = [];
    let count: array<int> = [];
    let i = 0;
    while (i < n) {
        perm1 = array_push(perm1, i + 1);
        count = array_push(count, 0);
        i = i + 1;
    }
    let maxFlips = 0;
    let checksum = 0;
    let r = n;
    let done = 0;
    while (done == 0) {
        if (perm1[0] != 1) {
            let k = perm1[0];
            let flips = 0;
            while (k > 1) {
                let a = 0;
                let b = k - 1;
                while (a < b) {
                    let t = perm1[a];
                    perm1[a] = perm1[b];
                    perm1[b] = t;
                    a = a + 1;
                    b = b - 1;
                }
                k = perm1[0];
                flips = flips + 1;
            }
            if (flips > maxFlips) { maxFlips = flips; }
            if (r % 2 == 0) { checksum = checksum + flips; } else { checksum = checksum - flips; }
        }
        // 下一置换（旋转法）
        let q = 0;
        let ci = 1;
        while (ci < r) {
            count[ci] = count[ci] + 1;
            if (count[ci] <= ci) {
                q = ci;
                ci = r;
            } else {
                count[ci] = 0;
            }
            ci = ci + 1;
        }
        if (q == 0) {
            done = 1;
        } else {
            let t0 = perm1[q];
            perm1[q] = perm1[0];
            perm1[0] = t0;
            let a = 1;
            let b = q - 1;
            while (a < b) {
                let t = perm1[a];
                perm1[a] = perm1[b];
                perm1[b] = t;
                a = a + 1;
                b = b - 1;
            }
            r = q;
        }
    }
    println(checksum);
    println(maxFlips);
    return 0;
}
