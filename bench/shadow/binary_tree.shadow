// binary_tree：二叉树分配与遍历（数组式 arena，元素赋值回传）
// 与 bench/go/binary_tree.go 同算法、同 maxDepth=10；节点数完全一致。
dsb binary_tree;

kimo buildTree(left: array<int>, right: array<int>, free: array<int>, depth: int) -> int {
    let idx = free[0];
    free[0] = free[0] + 1;
    left[idx] = -1;
    right[idx] = -1;
    if (depth > 0) {
        let l = buildTree(left, right, free, depth - 1);
        let rr = buildTree(left, right, free, depth - 1);
        left[idx] = l;
        right[idx] = rr;
    }
    return idx;
}

kimo checkTree(left: array<int>, right: array<int>, idx: int) -> int {
    if (left[idx] == -1) {
        return 1;
    }
    return 1 + checkTree(left, right, left[idx]) + checkTree(left, right, right[idx]);
}

kimo main() -> int {
    let maxDepth = 10;
    let minDepth = 4;
    let NODES = 100000;
    let left: array<int> = [];
    let right: array<int> = [];
    let i = 0;
    while (i < NODES) {
        left = array_push(left, -1);
        right = array_push(right, -1);
        i = i + 1;
    }
    let free: array<int> = [];
    free = array_push(free, 0);

    let longLived = buildTree(left, right, free, maxDepth);
    let total = 0;
    let depth = minDepth;
    while (depth <= maxDepth) {
        let iterations = 1;
        let s = maxDepth - depth;
        let ii = 0;
        while (ii < s) { iterations = iterations * 2; ii = ii + 1; }
        let it = 1;
        while (it <= iterations) {
            let root = buildTree(left, right, free, depth);
            total = total + checkTree(left, right, root);
            it = it + 1;
        }
        depth = depth + 2;
    }
    println(checkTree(left, right, longLived));
    println(total);
    return 0;
}
