// nbody：引力 N 体模拟（double + 自实现牛顿 sqrt）
// 与 bench/go/nbody.go 同算法、同 N=1000，输出被 bench_time.py 丢弃，仅计时。
// 注：shadow 曾因「double 标量作用户函数实参」codegen 出错（裸实数字面量未 fpext 成 double，
//     高 32 位留垃圾 → 病态 denormal）。该 bug 已由 commit cb1c67c 修复（调用点 float→double 拓宽），
//     故此处恢复正常写法：advance 接收 dt:double 形参，调用点直接传 double 字面量 0.01。
dsb nbody;

kimo my_sqrt(x: double) -> double {
    if (x <= 0.0) { return 0.0; }
    let guess: double = x;
    let i = 0;
    while (i < 30) {
        guess = 0.5 * (guess + x / guess);
        i = i + 1;
    }
    return guess;
}

kimo advance(pos: array<array<double>>, vel: array<array<double>>, mass: array<double>, dt: double, nb: int) -> void {
    let i = 0;
    while (i < nb) {
        let j = i + 1;
        while (j < nb) {
            let dx = pos[i][0] - pos[j][0];
            let dy = pos[i][1] - pos[j][1];
            let dz = pos[i][2] - pos[j][2];
            let d2 = dx * dx + dy * dy + dz * dz;
            let d = my_sqrt(d2);
            let mag = dt / (d2 * d);
            vel[i][0] = vel[i][0] - dx * mass[j] * mag;
            vel[i][1] = vel[i][1] - dy * mass[j] * mag;
            vel[i][2] = vel[i][2] - dz * mass[j] * mag;
            vel[j][0] = vel[j][0] + dx * mass[i] * mag;
            vel[j][1] = vel[j][1] + dy * mass[i] * mag;
            vel[j][2] = vel[j][2] + dz * mass[i] * mag;
            j = j + 1;
        }
        i = i + 1;
    }
    let k = 0;
    while (k < nb) {
        pos[k][0] = pos[k][0] + vel[k][0] * dt;
        pos[k][1] = pos[k][1] + vel[k][1] * dt;
        pos[k][2] = pos[k][2] + vel[k][2] * dt;
        k = k + 1;
    }
}

kimo energy(pos: array<array<double>>, vel: array<array<double>>, mass: array<double>, nb: int) -> double {
    let e: double = 0.0;
    let i = 0;
    while (i < nb) {
        e = e + 0.5 * mass[i] * (vel[i][0] * vel[i][0] + vel[i][1] * vel[i][1] + vel[i][2] * vel[i][2]);
        let j = i + 1;
        while (j < nb) {
            let dx = pos[i][0] - pos[j][0];
            let dy = pos[i][1] - pos[j][1];
            let dz = pos[i][2] - pos[j][2];
            let d = my_sqrt(dx * dx + dy * dy + dz * dz);
            e = e - (mass[i] * mass[j]) / d;
            j = j + 1;
        }
        i = i + 1;
    }
    return e;
}

kimo main() -> int {
    let pi: double = 3.141592653589793;
    let solar_mass: double = 4.0 * pi * pi;
    let days_per_year: double = 365.24;
    let n = 1000;

    let pos: array<array<double>> = [];
    let vel: array<array<double>> = [];
    let mass: array<double> = [];

    // body 0: sun
    let r0: array<double> = [];
    r0 = array_push(r0, 0.0); r0 = array_push(r0, 0.0); r0 = array_push(r0, 0.0);
    pos = array_push(pos, r0);
    let v0: array<double> = [];
    v0 = array_push(v0, 0.0); v0 = array_push(v0, 0.0); v0 = array_push(v0, 0.0);
    vel = array_push(vel, v0);
    mass = array_push(mass, solar_mass);

    // body 1: jupiter
    let r1: array<double> = [];
    r1 = array_push(r1, 4.84143144246472090e+00);
    r1 = array_push(r1, -1.16032004402742839e+00);
    r1 = array_push(r1, -1.03622044471123109e-01);
    pos = array_push(pos, r1);
    let v1: array<double> = [];
    v1 = array_push(v1, 1.66007664274403694e-03 * days_per_year);
    v1 = array_push(v1, 7.69901118419740425e-03 * days_per_year);
    v1 = array_push(v1, -6.90460016972063023e-05 * days_per_year);
    vel = array_push(vel, v1);
    mass = array_push(mass, 9.54791938424326609e-04 * solar_mass);

    // body 2: saturn
    let r2: array<double> = [];
    r2 = array_push(r2, 8.34336671824457987e+00);
    r2 = array_push(r2, 4.12479856412430479e+00);
    r2 = array_push(r2, -4.03523417114321381e-01);
    pos = array_push(pos, r2);
    let v2: array<double> = [];
    v2 = array_push(v2, -2.76742510726862411e-03 * days_per_year);
    v2 = array_push(v2, 4.99852801234917238e-03 * days_per_year);
    v2 = array_push(v2, 2.30417297573763929e-05 * days_per_year);
    vel = array_push(vel, v2);
    mass = array_push(mass, 2.85885980666130812e-04 * solar_mass);

    // body 3: uranus
    let r3: array<double> = [];
    r3 = array_push(r3, 1.28943695621391310e+01);
    r3 = array_push(r3, -1.51111514016986312e+01);
    r3 = array_push(r3, -2.23307578859889259e-01);
    pos = array_push(pos, r3);
    let v3: array<double> = [];
    v3 = array_push(v3, 2.96460137564761618e-03 * days_per_year);
    v3 = array_push(v3, 2.37847173959480950e-03 * days_per_year);
    v3 = array_push(v3, -2.96589568540237556e-05 * days_per_year);
    vel = array_push(vel, v3);
    mass = array_push(mass, 4.36624404335156298e-05 * solar_mass);

    // body 4: neptune
    let r4: array<double> = [];
    r4 = array_push(r4, 1.53796971148509165e+01);
    r4 = array_push(r4, -2.59193146099879641e+01);
    r4 = array_push(r4, 1.79258772950371181e-01);
    pos = array_push(pos, r4);
    let v4: array<double> = [];
    v4 = array_push(v4, 2.68067772490389322e-03 * days_per_year);
    v4 = array_push(v4, 1.62824170038242295e-03 * days_per_year);
    v4 = array_push(v4, -9.51592254519715870e-05 * days_per_year);
    vel = array_push(vel, v4);
    mass = array_push(mass, 5.15138902046611451e-05 * solar_mass);

    // offset momentum（让系统总动量为 0）
    let px: double = 0.0;
    let py: double = 0.0;
    let pz: double = 0.0;
    let i = 0;
    while (i < 5) {
        px = px + vel[i][0] * mass[i];
        py = py + vel[i][1] * mass[i];
        pz = pz + vel[i][2] * mass[i];
        i = i + 1;
    }
    vel[0][0] = -px / solar_mass;
    vel[0][1] = -py / solar_mass;
    vel[0][2] = -pz / solar_mass;

    println(energy(pos, vel, mass, 5));
    advance(pos, vel, mass, 0.01, 5);
    println(energy(pos, vel, mass, 5));
    return 0;
}
