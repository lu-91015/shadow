// 诊断：rt_alloc_cap 是否返回堆字符串容量
dsb cap_diag;

@extern("rt_alloc_cap") kimo rt_alloc_cap(p: any) -> int { return 0; }

kimo main() -> int {
    let out = "";
    let i = 0;
    while (i < 5) {
        let cap: int = rt_alloc_cap(out);
        let l: int = len(out);
        println("i=" + int_to_str(i) + " len=" + int_to_str(l) + " cap=" + int_to_str(cap));
        out = out + "x";
        i = i + 1;
    }
    return 0;
}
