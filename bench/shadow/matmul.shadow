// 基准测试：矩阵乘法（嵌套数组 + 三重循环）
dsb matmul;

kimo main() -> int {
    let n = 150;
    let a = [];
    let b = [];
    let c = [];
    let i = 0;
    while (i < n) {
        let rowa = [];
        let rowb = [];
        let rowc = [];
        let j = 0;
        while (j < n) {
            rowa = array_push(rowa, i * n + j);
            rowb = array_push(rowb, j * n + i);
            rowc = array_push(rowc, 0);
            j = j + 1;
        }
        a = array_push(a, rowa);
        b = array_push(b, rowb);
        c = array_push(c, rowc);
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        let j = 0;
        while (j < n) {
            let s = 0;
            let k = 0;
            while (k < n) {
                s = s + a[i][k] * b[k][j];
                k = k + 1;
            }
            c[i][j] = s;
            j = j + 1;
        }
        i = i + 1;
    }
    println(c[0][0]);
    println(c[n - 1][n - 1]);
    return 0;
}
