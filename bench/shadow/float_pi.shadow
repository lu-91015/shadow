// 基准测试：浮点 π 计算（Leibniz 级数 π/4 = 1 - 1/3 + 1/5 - 1/7 + ...）
// 注：shadow 类型推断对浮点字面量有 bug（let a = 3.0 推断为 int），
// 需显式 : double 声明。
dsb float_pi;

kimo main() -> int {
    let n = 100000000;
    let sum: double = 0.0;
    let i = 0;
    while (i < n) {
        let d: double = (i * 2 + 1) as double;
        if (i % 2 == 0) {
            sum = sum + 1.0 / d;
        } else {
            sum = sum - 1.0 / d;
        }
        i = i + 1;
    }
    let pi: double = sum * 4.0;
    println(pi);
    return 0;
}
