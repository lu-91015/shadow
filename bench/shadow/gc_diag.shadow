// 诊断：字符串拼接 GC 行为（小规模）
dsb gc_diag;

kimo main() -> int {
    let s = "the quick brown fox jumps over the lazy dog";
    let total = 0;
    let iter = 0;
    while (iter < 30000) {
        let out = "";
        let i = len(s) - 1;
        while (i >= 0) {
            out = out + s[i];
            i = i - 1;
        }
        total = total + len(out);
        iter = iter + 1;
    }
    println(total);
    return 0;
}
