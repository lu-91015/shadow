// spectral_norm：谱范数（幂迭代，double + 自实现牛顿 sqrt）
// 与 bench/go/spectral_norm.go 同算法、同 N=100。
dsb spectral_norm;

kimo my_sqrt(x: double) -> double {
    if (x <= 0.0) { return 0.0; }
    let g: double = x;
    let i = 0;
    while (i < 30) {
        g = 0.5 * (g + x / g);
        i = i + 1;
    }
    return g;
}

kimo evalA(i: int, j: int) -> double {
    if ((i + j) % 2 == 0) {
        return 1.0 / (i + j + 1) as double;
    }
    return -1.0 / (i + j + 1) as double;
}

kimo multiplyAv(v: array<double>, tmp: array<double>, n: int) -> void {
    let i = 0;
    while (i < n) {
        let s: double = 0.0;
        let j = 0;
        while (j < n) {
            s = s + evalA(i, j) * v[j];
            j = j + 1;
        }
        tmp[i] = s;
        i = i + 1;
    }
    let k = 0;
    while (k < n) {
        v[k] = tmp[k];
        k = k + 1;
    }
}

kimo multiplyAtv(v: array<double>, tmp: array<double>, n: int) -> void {
    let i = 0;
    while (i < n) {
        let s: double = 0.0;
        let j = 0;
        while (j < n) {
            s = s + evalA(j, i) * v[j];
            j = j + 1;
        }
        tmp[i] = s;
        i = i + 1;
    }
    let k = 0;
    while (k < n) {
        v[k] = tmp[k];
        k = k + 1;
    }
}

kimo multiplyAtAv(v: array<double>, out: array<double>, tmp: array<double>, n: int) -> void {
    multiplyAv(v, tmp, n);
    multiplyAtv(tmp, out, n);
}

kimo main() -> int {
    let n = 100;
    let u: array<double> = [];
    let i = 0;
    while (i < n) { u = array_push(u, 1.0); i = i + 1; }
    let v: array<double> = [];
    let j = 0;
    while (j < n) { v = array_push(v, 0.0); j = j + 1; }
    let tmp: array<double> = [];
    let k = 0;
    while (k < n) { tmp = array_push(tmp, 0.0); k = k + 1; }
    let it = 0;
    while (it < 10) {
        multiplyAtAv(u, v, tmp, n);
        multiplyAtAv(v, u, tmp, n);
        it = it + 1;
    }
    let vv: double = 0.0;
    let vBv: double = 0.0;
    let m = 0;
    while (m < n) {
        vv = vv + u[m] * u[m];
        vBv = vBv + u[m] * v[m];
        m = m + 1;
    }
    println(my_sqrt(vBv / vv));
    return 0;
}
