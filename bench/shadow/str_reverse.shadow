// 基准测试：字符串反转（逐字符访问 + 拼接）
dsb str_reverse;

kimo main() -> int {
    let s = "the quick brown fox jumps over the lazy dog";
    let total = 0;
    let iter = 0;
    while (iter < 200000) {
        let out = "";
        let i = len(s) - 1;
        while (i >= 0) {
            out = out + s[i];
            i = i - 1;
        }
        total = total + len(out);
        iter = iter + 1;
    }
    println(total);
    return 0;
}
