// 基准测试：快速排序（静态类型数组访问 + 递归 + 比较）
dsb quicksort;

kimo qs_partition(a: array<int>, lo: int, hi: int) -> int {
    let pivot = a[hi];
    let i = lo - 1;
    let j = lo;
    while (j < hi) {
        if (a[j] < pivot) {
            i = i + 1;
            let t = a[i];
            a[i] = a[j];
            a[j] = t;
        }
        j = j + 1;
    }
    let t2 = a[i + 1];
    a[i + 1] = a[hi];
    a[hi] = t2;
    return i + 1;
}

kimo qs(a: array<int>, lo: int, hi: int) -> void {
    if (lo < hi) {
        let p = qs_partition(a, lo, hi);
        qs(a, lo, p - 1);
        qs(a, p + 1, hi);
    }
}

kimo main() -> int {
    let n = 20000;
    let a: array<int> = [];
    let i = 0;
    while (i < n) {
        a = array_push(a, (n - i) % 7919);
        i = i + 1;
    }
    qs(a, 0, n - 1);
    println(a[0]);
    println(a[n - 1]);
    return 0;
}
