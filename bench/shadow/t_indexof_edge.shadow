// 边界测试：shadow_index_of_fast 合并 strlen+首字节扫描后的正确性
dsb t_indexof_edge;

kimo main() -> int {
    // 基本：开头/中间/结尾/缺失
    println(str_index_of("hello world", "hello"));      // 0
    println(str_index_of("hello world", "world"));      // 6
    println(str_index_of("hello world", "d"));          // 10
    println(str_index_of("hello world", "xyz"));        // -1
    // 空 needle / 单字符
    println(str_index_of("abc", ""));                   // 0
    println(str_index_of("abc", "b"));                  // 1
    // needle 长于字符串
    println(str_index_of("abc", "abcd"));               // -1
    println(str_index_of("abc", "abcdefgh"));           // -1
    // needle 恰好等于字符串
    println(str_index_of("abc", "abc"));                // 0
    // 首字节重复（验证跳过逻辑）
    println(str_index_of("aaaaab", "aab"));             // 3
    println(str_index_of("ababab", "bab"));             // 1
    // 首字节在末尾、末字节越界场景
    println(str_index_of("aX", "ab"));                  // -1
    println(str_index_of("ab", "abc"));                 // -1
    println(str_index_of("abc", "abcd"));               // -1
    // 空字符串
    println(str_index_of("", "a"));                     // -1
    println(str_index_of("", ""));                      // 0
    // 中文/多字节（按字节匹配）
    println(str_index_of("你好世界", "世界"));           // 6
    return 0;
}
