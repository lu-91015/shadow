// Shadow 0.5 — core 工具函数
// ============================================================
// 不使用 any 盒子：参数与返回全部具体类型。
// 跨模块引用 core_ast 的 pub struct 依赖 P0.4-1 全局 pub 回退（无需 import）。
//
// ⚠️ 自举宿主在 import 模块内的解析缺陷与规避规范（实测确认）：
//   1. `return 0 as <struct>` 表达式直接返回 → return type mismatch；
//      必须经中间变量：`let x = 0 as T; return x;`
//   2. `return <expr 含 as any>`（如 `return (e as any) == 0`）→ mismatch；
//      必须经中间变量 + if 分支：`let x = e as any; if (x == 0) return 1;`
//   3. `return <expr 含跨模块常量>`（如 `return t.kind == TYPE_INFER`）→ mismatch；
//      必须先把常量/字段赋给本地变量再比较：`let v = TYPE_INFER; ...`
//   4. 跨模块引用其他模块 pub struct/常量/函数无需 import（P0.4-1 全局 pub 回退）
//   5. str_join 为宿主内置（str_join(arr, sep) -> string，一次性分配），禁止自定义
//   6. ⚠️ 跨模块读 struct 的 long 字段：高 32 位不可靠（import 模块读主文件 AST 的
//      long 字段会得到垃圾值）。凡读 long 字段参与 int 比较/赋值，一律 `as int`
//      （值在 int 范围时低 32 位截断无损）。操作符/索引/整数字面量皆适用；
//      超 int 范围的 long 字面量跨模块传递会错，编译器源码应避免。
dsb utils;

// 构造退化点区间（起点=终点，长度 0）
pub kimo mk_loc(file: string, line: int, col: int) -> Location {
    return Location { file: file, line: line, col: col, end_line: line, end_col: col };
}

// 显式区间构造（终点半开不含）
pub kimo mk_loc_range(file: string, line: int, col: int, end_line: int, end_col: int) -> Location {
    return Location { file: file, line: line, col: col, end_line: end_line, end_col: end_col };
}

// 返回 loc 副本，把终点改成 (end_line, end_col)。不原地修改（Location 按值语义）。
pub kimo loc_with_end(loc: Location, end_line: int, end_col: int) -> Location {
    return Location { file: loc.file, line: loc.line, col: loc.col, end_line: end_line, end_col: end_col };
}

// 用 start 的起点 + end 的终点合成覆盖两者的区间
pub kimo loc_span(start: Location, end: Location) -> Location {
    return Location { file: start.file, line: start.line, col: start.col, end_line: end.end_line, end_col: end.end_col };
}

// 该 Location 是否仍是未回填终点的退化点区间
pub kimo loc_is_point(loc: Location) -> int {
    if (loc.end_line != loc.line) { return 0; }
    if (loc.end_col != loc.col) { return 0; }
    return 1;
}

// (line, col) 是否落在区间 [start, end) 内（LSP 命中判定；点区间恒不命中）
pub kimo loc_contains(loc: Location, line: int, col: int) -> int {
    if (loc_is_point(loc) == 1) { return 0; }
    if (line < loc.line) { return 0; }
    if (line == loc.line) {
        if (col < loc.col) { return 0; }
    }
    if (line > loc.end_line) { return 0; }
    if (line == loc.end_line) {
        if (col >= loc.end_col) { return 0; }
    }
    return 1;
}

// "行:列-行:列" 形式的区间文本（诊断输出与测试断言）
pub kimo loc_range_str(loc: Location) -> string {
    return int_to_str(loc.line) + ":" + int_to_str(loc.col) + "-" + int_to_str(loc.end_line) + ":" + int_to_str(loc.end_col);
}

// --- NodeId 全局计数器 ---
let g_node_id_counter: int = 0;

// 重置 NodeId 计数器（新编译单元开始时调用）
pub kimo reset_node_ids() -> void {
    g_node_id_counter = 0;
}

// 分配新 NodeId
pub kimo next_node_id() -> int {
    let id = g_node_id_counter;
    let v = g_node_id_counter + 1;
    g_node_id_counter = v;
    return id;
}

// 空 Expr 哨兵（0 指针）
pub kimo mk_expr(kind: int, loc: Location) -> Expr {
    let id = next_node_id();
    let e = Expr { id: id, kind: kind, loc: loc, str1: "", str2: "", intval: 0,
                    floatval: 0.0, child1: 0 as Expr, child2: 0 as Expr, child3: 0 as Expr,
                    items: [], items2: [], str_items: [], stmt_items: [], type_args: [],
                    closure_def: None, bind_types: [], inferred_type: type_none_inner() };
    return e;
}

// 空 Stmt 哨兵（0 指针）
pub kimo mk_stmt(kind: int, loc: Location) -> Stmt {
    let id = next_node_id();
    let s = Stmt { kind: kind, loc: loc, str1: "", str2: "", intval: 0, floatval: 0.0,
                   child1: 0 as Stmt, child2: 0 as Stmt, child3: 0 as Stmt,
                   items: [], items2: [], exprs: [], str_items: [],
                   type1: type_none_inner(), expr1: 0 as Expr, expr2: 0 as Expr,
                   inferred_type: type_none_inner() };
    return s;
}

// 用 token 回填节点区间（Token 本身是 1-based 半开区间）
pub kimo loc_from_token(file: string, t: Token) -> Location {
    return Location { file: file, line: t.line, col: t.col, end_line: t.end_line, end_col: t.end_col };
}

// 字符串前缀判断（宿主无内置，自实现）
pub kimo str_starts_with(s: string, prefix: string) -> int {
    let n = len(s);
    let m = len(prefix);
    if (m > n) { return 0; }
    let i = 0;
    while (i < m) {
        if (s[i] != prefix[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// 字符 → 数字（非数字返回 -1）
pub kimo char_digit(c: string) -> int {
    if (c == "0") { return 0; }
    if (c == "1") { return 1; }
    if (c == "2") { return 2; }
    if (c == "3") { return 3; }
    if (c == "4") { return 4; }
    if (c == "5") { return 5; }
    if (c == "6") { return 6; }
    if (c == "7") { return 7; }
    if (c == "8") { return 8; }
    if (c == "9") { return 9; }
    return -1;
}

// 数字 → double（返回值直接是 double 常量，避免 float 字面量赋给 double 变量——
// 旧宿主的 STMT_ASSIGN 不设 inst.ty，float 存进 i64 slot 只写低 32 位，读 double 高 32 位垃圾）
pub kimo digit_to_double(d: int) -> double {
    if (d == 0) { return 0.0; }
    if (d == 1) { return 1.0; }
    if (d == 2) { return 2.0; }
    if (d == 3) { return 3.0; }
    if (d == 4) { return 4.0; }
    if (d == 5) { return 5.0; }
    if (d == 6) { return 6.0; }
    if (d == 7) { return 7.0; }
    if (d == 8) { return 8.0; }
    if (d == 9) { return 9.0; }
    return 0.0;
}

// 字符串 → double（宿主无内置 str_to_double，手动解析）
// 支持：123 / 123.45 / 1e3 / 1.0e-4 / -0.5
// 规避：数字 → double 一律走 digit_to_double（返回 double 常量），禁止
// `let dd: double = 0.0; dd = 3.0;` 这种 float 字面量赋值（旧宿主 STMT_ASSIGN
// 无 inst.ty → float 存 i64 slot 低 32 位 → 读 double 高 32 位垃圾）。
pub kimo str_to_double(s: string) -> double {
    let n = len(s);
    let i = 0;
    let neg = 0;
    if (i < n) {
        let c0 = s[i];
        if (c0 == "-") { neg = 1; i = i + 1; }
    }
    let int_part: double = 0.0;
    while (i < n) {
        let c = s[i];
        let d = char_digit(c);
        if (d < 0) { break; }
        int_part = int_part * 10.0 + digit_to_double(d);
        i = i + 1;
    }
    let frac: double = 0.0;
    let frac_div: double = 1.0;
    if (i < n) {
        let cdot = s[i];
        if (cdot == ".") {
            i = i + 1;
            while (i < n) {
                let c = s[i];
                let d2 = char_digit(c);
                if (d2 < 0) { break; }
                frac = frac * 10.0 + digit_to_double(d2);
                frac_div = frac_div * 10.0;
                i = i + 1;
            }
        }
    }
    let val = int_part + frac / frac_div;
    // 指数部分 e/E
    if (i < n) {
        let ce = s[i];
        if (ce == "e" || ce == "E") {
            i = i + 1;
            let exp_neg = 0;
            if (i < n) {
                let cs = s[i];
                if (cs == "+" || cs == "-") {
                    if (cs == "-") { exp_neg = 1; }
                    i = i + 1;
                }
            }
            let exp: int = 0;
            while (i < n) {
                let c = s[i];
                let de = char_digit(c);
                if (de < 0) { break; }
                exp = exp * 10 + de;
                i = i + 1;
            }
            let j = 0;
            if (exp_neg == 0) {
                while (j < exp) { val = val * 10.0; j = j + 1; }
            } else {
                while (j < exp) { val = val / 10.0; j = j + 1; }
            }
        }
    }
    if (neg == 1) { val = 0.0 - val; }
    return val;
}

// 空 Type 哨兵构造（TYPE_INFER）
pub kimo type_none_inner() -> Type {
    return Type { kind: TYPE_INFER, name: "", elem_type: 0 as Type,
                  key_type: 0 as Type, val_type: 0 as Type, ret_type: 0 as Type,
                  param_types: [], captured_count: 0 };
}

// 顶层空 Type：字段用有效哨兵填充（一级访问安全）
pub kimo type_none() -> Type {
    return Type { kind: TYPE_INFER, name: "", elem_type: type_none_inner(),
                  key_type: type_none_inner(), val_type: type_none_inner(),
                  ret_type: type_none_inner(), param_types: [], captured_count: 0 };
}

// 构造标量类型
pub kimo mk_type(kind: int) -> Type {
    return Type { kind: kind, name: "", elem_type: type_none_inner(),
                  key_type: type_none_inner(), val_type: type_none_inner(),
                  ret_type: type_none_inner(), param_types: [], captured_count: 0 };
}

// 构造命名类型（struct/enum/别名）
pub kimo mk_named_type(kind: int, name: string) -> Type {
    return Type { kind: kind, name: name, elem_type: type_none_inner(),
                  key_type: type_none_inner(), val_type: type_none_inner(),
                  ret_type: type_none_inner(), param_types: [], captured_count: 0 };
}

// 构造数组类型
pub kimo mk_array_type(elem: Type) -> Type {
    return Type { kind: TYPE_ARRAY, name: "", elem_type: elem, key_type: type_none_inner(),
                  val_type: type_none_inner(), ret_type: type_none_inner(),
                  param_types: [], captured_count: 0 };
}

// 构造字典类型
pub kimo mk_dict_type(key: Type, val: Type) -> Type {
    return Type { kind: TYPE_DICT, name: "", elem_type: type_none_inner(), key_type: key,
                  val_type: val, ret_type: type_none_inner(), param_types: [],
                  captured_count: 0 };
}

// 构造函数类型
pub kimo mk_func_type(params: array<Type>, ret: Type, captured: int) -> Type {
    return Type { kind: TYPE_FUNCTION, name: "", elem_type: type_none_inner(),
                  key_type: type_none_inner(), val_type: type_none_inner(),
                  ret_type: ret, param_types: params, captured_count: captured };
}

// 类型是否为空（未推断）
pub kimo type_is_none(t: Type) -> int {
    let k = t.kind;
    let v = TYPE_INFER;
    if (k == v) { return 1; }
    return 0;
}

// 类型相等（结构比较）
pub kimo type_eq(a: Type, b: Type) -> int {
    let ka0 = a.kind;
    let kb0 = b.kind;
    // ENUM 与 ENUM_PAYLOAD 视为同一族：同一枚举的"无 payload 视图"（parse 原始
    // 类型如 Option<FuncDef>，kind=TYPE_ENUM）与"有 payload 视图"（tc_enum_type_for
    // 返回 TYPE_ENUM_PAYLOAD）应相等。否则 Some(fd) 赋值到 Option<FuncDef> 字段报
    // "cannot assign Option to Option"。
    let a_is_enum = 0;
    if (ka0 == TYPE_ENUM || ka0 == TYPE_ENUM_PAYLOAD) { a_is_enum = 1; }
    let b_is_enum = 0;
    if (kb0 == TYPE_ENUM || kb0 == TYPE_ENUM_PAYLOAD) { b_is_enum = 1; }
    if (a_is_enum == 1 && b_is_enum == 1) {
        if (str_eq(a.name, b.name) != 1) { return 0; }
        return 1;
    }
    if (a.kind != b.kind) { return 0; }
    let k = a.kind;
    let ks = TYPE_STRUCT;
    let ke = TYPE_ENUM;
    let kep = TYPE_ENUM_PAYLOAD;
    let ko = TYPE_OPAQUE;
    if (k == ks || k == ke || k == kep || k == ko) {
        if (str_eq(a.name, b.name) != 1) { return 0; }
    }
    let ka = TYPE_ARRAY;
    if (k == ka) {
        return type_eq(a.elem_type, b.elem_type);
    }
    let kd = TYPE_DICT;
    if (k == kd) {
        if (type_eq(a.key_type, b.key_type) != 1) { return 0; }
        return type_eq(a.val_type, b.val_type);
    }
    return 1;
}

// 空 Expr（0 指针哨兵，AST 无子节点时使用）
// 规避规范 1：return 0 as struct 必须经中间变量。
pub kimo expr_none() -> Expr {
    let e = 0 as Expr;
    return e;
}

// 空 Stmt（0 指针哨兵）
pub kimo stmt_none() -> Stmt {
    let s = 0 as Stmt;
    return s;
}

// 判断 Expr 是否为空（0 指针）。底层判空经 any 转换是唯一必要用途。
// 规避规范 2：return 表达式含 as any 必须经中间变量 + if 分支。
pub kimo expr_is_none(e: Expr) -> int {
    let x = e as any;
    if (x == 0) { return 1; }
    return 0;
}

// 判断 Stmt 是否为空（0 指针）
pub kimo stmt_is_none(s: Stmt) -> int {
    let x = s as any;
    if (x == 0) { return 1; }
    return 0;
}
