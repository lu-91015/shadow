// Shadow 0.5 — core 常量定义
// ============================================================
// 语法完全复刻 shadow-0.3：dsb 模块声明 + pub let 全局常量。
// 常量跨模块可见（P0.4-1 全局 pub 回退），模块内直接引用无需 import。
// 字符串拼接遵循原则 9：禁止裸 + 链，统一 str_join。
dsb const;

// ============ 类型种类 TYPE_* ============
pub let TYPE_VOID: int = 0;
pub let TYPE_INT: int = 1;
pub let TYPE_LONG: int = 2;
pub let TYPE_FLOAT: int = 3;
pub let TYPE_DOUBLE: int = 4;
pub let TYPE_BOOL: int = 5;
pub let TYPE_STRING: int = 6;
