// ============ 表达式种类 EXPR_* ============
pub let EXPR_INT: int = 1;
pub let EXPR_LONG: int = 2;
pub let EXPR_FLOAT: int = 3;
pub let EXPR_STRING: int = 4;
pub let EXPR_BOOL: int = 5;
pub let EXPR_NULL: int = 6;
pub let EXPR_VAR: int = 7;
pub let EXPR_BINARY: int = 8;
pub let EXPR_UNARY: int = 9;
pub let EXPR_CALL: int = 10;
pub let EXPR_INDEX: int = 11;
pub let EXPR_MEMBER: int = 12;
pub let EXPR_CAST: int = 13;
pub let EXPR_ARRAY_LIT: int = 14;
pub let EXPR_STRUCT_LIT: int = 15;
pub let EXPR_ASSIGN: int = 16;
pub let EXPR_MATCH: int = 17;
pub let EXPR_NEW: int = 18;
pub let EXPR_IF: int = 19;
// enum 变体构造/解构模式：str1=变体名，items=负载值/绑定名
pub let EXPR_ENUM_VARIANT: int = 20;
// 闭包字面量 kimo(params) -> ret { body }：closure_def=FuncDef
pub let EXPR_CLOSURE: int = 21;
// 错误传播 `?` 后缀：child1=被包裹表达式
pub let EXPR_QUESTION: int = 22;
// 元组字面量 (e1, e2, ...)：items=元素
pub let EXPR_TUPLE: int = 23;
// for range 字面量 a..b：child1=start, child2=end
pub let EXPR_RANGE: int = 24;
// 协程 spawn：str1=函数名，items=可选参数
pub let EXPR_SPAWN: int = 25;
// await：child1=Future 表达式
pub let EXPR_AWAIT: int = 26;
// 自增/自减 ++/--：intval=0 增 1 减；str1="pre"/"post" 前缀/后缀；child1=目标
pub let EXPR_INCDEC: int = 27;

