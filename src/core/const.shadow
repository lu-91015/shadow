pub let TYPE_STRUCT: int = 8;
pub let TYPE_ENUM: int = 9;
pub let TYPE_ANY: int = 10;
pub let TYPE_FUNCTION: int = 11;
pub let TYPE_CHAR: int = 12;
pub let TYPE_SHORT: int = 13;
pub let TYPE_DICT: int = 14;
pub let TYPE_INFER: int = 15;
pub let TYPE_UNIT: int = 16;
pub let TYPE_DATE: int = 17;
pub let TYPE_TIMESTAMP: int = 18;
pub let TYPE_NANOTIMESTAMP: int = 19;
pub let TYPE_OPAQUE: int = 20;
pub let TYPE_ENUM_PAYLOAD: int = 21;
pub let TYPE_TUPLE: int = 22;
pub let TYPE_SET: int = 23;
pub let TYPE_FUTURE: int = 24;
pub let TYPE_TRAIT_OBJECT: int = 25; // dyn Trait 运行时多态值（数据指针 + vtable 指针）

