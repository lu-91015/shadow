// Shadow 0.5 — LLVM-C API Codegen（MIR → LLVM Module）
// ============================================================
// 使用 @extern 声明的 LLVM-C API 构建 LLVM Module（LLVM-C 为编译期工具链依赖，
// 产物 shadow.exe 运行时无需 LLVM-C.dll）。禁止字符串拼接 IR，所有 IR 通过 LLVM-C builder 生成。
// 运行时 ABI：聚合类型（string/array/dict/struct/any）统一为 i8* 句柄。
//
// 与 0.3 的差异（0.5 架构）：
//   - MirFunc.params 为 array<MirParam>（slot/type_kind 具体字段）
//   - MirBlock.terminator 为 MirInst（0 as MirInst = 无）
//   - MirInst.ty 为 Type（0 as Type = 无）
//   - 全局变量为 GlobalVar 结构（name/type_ref/init/is_pub/is_mut）
//   - 读 long 字段（mi.longval）一律 as int（跨模块 long 高 32 位规避）
dsb codegen;

import core.ast;
import core.const;
import core.utils;
import type_checker.type_checker;

// ============ LLVM-C API 桥接（@extern，64 位句柄必须用 any） ============
@extern("shadow_env_get") kimo cg_env_get(name: string) -> string { return ""; }

// 安全点预扫描诊断：SHADOW_SP_DBG=<函数名|*>。用于定位"预扫描判为安全点、
// 运行时其实不发调用"的假阳性（假阳性 = 白建 GC 帧 + 每 def 一次 spill）。
let cg_sp_dbg_name: string = "";
let cg_sp_dbg_read: int = -1;
pub kimo cg_sp_dbg_want() -> string {
    if (cg_sp_dbg_read < 0) {
        cg_sp_dbg_name = cg_env_get("SHADOW_SP_DBG");
        cg_sp_dbg_read = 1;
    }
    return cg_sp_dbg_name;
}

// dyn 装箱走桩开关（0=正常发射；1=直接发 NULL 对象，用于隔离装箱代码）
let cg_dyn_box_stub: int = 0;
pub kimo cg_dbg(msg: string) -> void {}

