// Shadow 0.5 — LLVM-C API Codegen（MIR → LLVM Module）
// ============================================================
// 使用 @extern 声明的 LLVM-C API 构建 LLVM Module（LLVM-C 为编译期工具链依赖，
// 产物 shadow.exe 运行时无需 LLVM-C.dll）。禁止字符串拼接 IR，所有 IR 通过 LLVM-C builder 生成。
// 运行时 ABI：聚合类型（string/array/dict/struct/any）统一为 i8* 句柄。
//
// 与 0.3 的差异（0.5 架构）：
//   - MirFunc.params 为 array<MirParam>（slot/type_kind 具体字段）
//   - MirBlock.terminator 为 MirInst（0 as MirInst = 无）
//   - MirInst.ty 为 Type（0 as Type = 无）
//   - 全局变量为 GlobalVar 结构（name/type_ref/init/is_pub/is_mut）
//   - 读 long 字段（mi.longval）一律 as int（跨模块 long 高 32 位规避）
dsb codegen;

import core.ast;
import core.const;
import core.utils;

// ============ LLVM-C API 桥接（@extern，64 位句柄必须用 any） ============
@extern("LLVMContextCreate") kimo llvm_ctx_create() -> any { return 0 as any; }
