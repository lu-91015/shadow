// ============ Codegen 全局状态 ============
let cg_ctx: any = 0 as any;
let cg_mod: any = 0 as any;
let cg_builder: any = 0 as any;
let cg_func: any = 0 as any;
let cg_cur_ret_kind: int = 0;
let cg_cur_ret_default: any = 0 as any;
let cg_cur_ret_is_void: int = 0;
let cg_gc_frame_marker: any = 0 as any;
let cg_gc_frame_active: int = 0;            // 1 = 本函数需要 GC 帧（有活指针/指针参数）
// GC 类型注册缓存（0.4 GC v1：按 名称+大小+位图 复用 type_id，首次生成 register_type 调用）
let cg_gc_type_keys: array<string> = [];
let cg_gc_type_ids: array<int> = [];
let cg_gc_type_counter: int = 100;
let cg_regs: array<any> = [];
let cg_reg_types: array<int> = [];
let cg_slots: array<any> = [];
// §5.2.4 精确根集：每函数 shadow frame（对标 Go stack map）
let cg_sf_alloca: any = 0 as any;        // [N x i64] 数组 alloca
let cg_sf_n: int = 0;                    // 槽数
let cg_sf_reg_slot: array<int> = [];     // reg → sf 槽号（-1 = 无需保活）
let cg_sf_intr_seq: array<int> = [];     // 内部临时槽号（按指令序，codegen 时逐个取）
let cg_sf_intr_idx: int = 0;             // cg_sf_intr_seq 游标
let cg_block_labels: array<string> = [];
let cg_block_ptrs: array<any> = [];
let cg_cur_bb: any = 0 as any;
let cg_cur_blk_idx: int = 0;         // 当前基本块在 cg_block_labels 中的序号（§5.2.4 回边判定）
let cg_poll_flag_g: any = 0 as any;  // g_gc_poll_flag 外部全局（懒创建，内联轮询 volatile 加载）
let cg_poll_counter: int = 0;        // 内联 poll 块命名计数器（每函数重置，保证 IR 确定性）
let cg_poll_skip_bb: any = 0 as any; // 最近一次内联 poll 的 skip 块（入口 poll 时 block 0 续接）
let cg_str_keys: array<string> = [];
let cg_str_vals: array<any> = [];
let cg_extern_names: array<string> = [];
let cg_extern_syms: array<string> = [];
let cg_all_blocks: array<array<MirBlock>> = [];
let cg_global_names: array<string> = [];
let cg_global_ptrs: array<any> = [];
let cg_global_kinds: array<int> = [];

// LLVM 比较/实数谓词常量
pub let LLVM_INT_EQ: int = 32;
pub let LLVM_INT_NE: int = 33;
pub let LLVM_INT_UGT: int = 34;
pub let LLVM_INT_UGE: int = 35;
pub let LLVM_INT_ULT: int = 36;
pub let LLVM_INT_ULE: int = 37;
pub let LLVM_INT_SGT: int = 38;
pub let LLVM_INT_SGE: int = 39;
pub let LLVM_INT_SLT: int = 40;
pub let LLVM_INT_SLE: int = 41;
pub let LLVM_REAL_OEQ: int = 1;
pub let LLVM_REAL_OGT: int = 2;
pub let LLVM_REAL_OGE: int = 3;
pub let LLVM_REAL_OLT: int = 4;
pub let LLVM_REAL_OLE: int = 5;
pub let LLVM_REAL_ONE: int = 6;

// 按名查找全局变量指针
pub kimo cg_global_lookup(name: string) -> any {
    let i = 0;
    while (i < len(cg_global_names)) {
        let n = cg_global_names[i] as string;
        if (str_eq(n, name) == 1) { return cg_global_ptrs[i]; }
        i = i + 1;
    }
    return 0 as any;
}

pub kimo cg_global_kind(name: string) -> int {
    let i = 0;
    while (i < len(cg_global_names)) {
        let n = cg_global_names[i] as string;
        if (str_eq(n, name) == 1) { return cg_global_kinds[i] as int; }
        i = i + 1;
    }
    return TYPE_INT;
}

// 内置函数名映射（自举时 Shadow 源码调用 len/str_eq 等，映射到 shadow_* 运行时）
pub kimo cg_resolve_extern_name(name: string) -> string {
    let i = 0;
    while (i < len(cg_extern_names)) {
        let n = cg_extern_names[i] as string;
        if (str_eq(n, name) == 1) {
            return cg_extern_names[i + 1] as string;
        }
        i = i + 2;
    }
    if (str_eq(name, "len") == 1) { return "shadow_array_len"; }
    if (str_eq(name, "str_eq") == 1) { return "shadow_string_eq"; }
    if (str_eq(name, "int_to_str") == 1) { return "shadow_int_to_str"; }
    if (str_eq(name, "long_to_str") == 1) { return "shadow_long_to_str"; }
    if (str_eq(name, "float_to_str") == 1) { return "shadow_float_to_str"; }
    if (str_eq(name, "bool_to_str") == 1) { return "shadow_bool_to_str"; }
    if (str_eq(name, "date_to_str") == 1) { return "shadow_date_to_str"; }
    if (str_eq(name, "timestamp_to_str") == 1) { return "shadow_timestamp_to_str"; }
    if (str_eq(name, "nanotimestamp_to_str") == 1) { return "shadow_nanotimestamp_to_str"; }
    if (str_eq(name, "parse_int") == 1) { return "shadow_parse_int"; }
    if (str_eq(name, "parse_long") == 1) { return "shadow_parse_long"; }
    if (str_eq(name, "parse_float") == 1) { return "shadow_parse_float"; }
    if (str_eq(name, "parse_bool") == 1) { return "shadow_parse_bool"; }
    if (str_eq(name, "println") == 1) { return "shadow_println_str"; }
    if (str_eq(name, "print") == 1) { return "shadow_print_str"; }
    if (str_eq(name, "to_string") == 1) { return "shadow_any_to_string"; }
    if (str_eq(name, "array_push") == 1) { return "shadow_array_push_ptr"; }
    if (str_eq(name, "array_pop") == 1) { return "shadow_array_pop"; }
    // 字符串处理全套 → 0.4 自研 runtime（shadow_* 0.4 命名，避免与 runtime_for_selfhost.o
    // 的 C++ shadow_string_* 符号重复定义；语义与 0.3 C++ 实现一致）
    if (str_eq(name, "str_join") == 1) { return "shadow_sjoin"; }
    if (str_eq(name, "str_format") == 1) { return "shadow_format"; }
    if (str_eq(name, "str_contains") == 1) { return "shadow_contains"; }
    if (str_eq(name, "str_index_of") == 1) { return "shadow_index_of_fast"; }
    if (str_eq(name, "str_replace") == 1) { return "shadow_str_replace"; }
    if (str_eq(name, "str_trim") == 1) { return "shadow_trim"; }
    if (str_eq(name, "str_to_upper") == 1) { return "shadow_supper"; }
    if (str_eq(name, "str_to_lower") == 1) { return "shadow_slower"; }
    if (str_eq(name, "str_char_at") == 1) { return "shadow_schar"; }
    if (str_eq(name, "str_split") == 1) { return "shadow_ssplit"; }
    if (str_eq(name, "substr2") == 1) { return "shadow_substr"; }
    if (str_eq(name, "file_read") == 1) { return "shadow_read_file"; }
    if (str_eq(name, "file_write") == 1) { return "shadow_write_file"; }
    if (str_eq(name, "file_exists") == 1) { return "shadow_file_exists"; }
    if (str_eq(name, "file_delete") == 1) { return "shadow_delete_file"; }
    if (str_eq(name, "file_list_dir") == 1) { return "shadow_list_dir"; }
    if (str_eq(name, "dir_create") == 1) { return "shadow_mkdir"; }
    if (str_eq(name, "dir_delete") == 1) { return "shadow_rmdir"; }
    if (str_eq(name, "path_exists") == 1) { return "shadow_path_exists"; }
    if (str_eq(name, "path_join") == 1) { return "shadow_path_join"; }
    if (str_eq(name, "path_dirname") == 1) { return "shadow_path_dirname"; }
    if (str_eq(name, "path_basename") == 1) { return "shadow_path_basename"; }
    if (str_eq(name, "path_normalize") == 1) { return "shadow_path_normalize"; }
    if (str_eq(name, "zip_pack") == 1) { return "shadow_zip_pack"; }
    if (str_eq(name, "zip_unpack") == 1) { return "shadow_zip_unpack"; }
    if (str_eq(name, "zip_list") == 1) { return "shadow_zip_list"; }
    if (str_eq(name, "content_hash") == 1) { return "shadow_content_hash"; }
    if (str_eq(name, "hashmap_new") == 1) { return "shadow_hashmap_new"; }
    if (str_eq(name, "hashmap_insert") == 1) { return "shadow_hashmap_insert"; }
    if (str_eq(name, "hashmap_get") == 1) { return "shadow_hashmap_get"; }
    if (str_eq(name, "hashmap_contains") == 1) { return "shadow_hashmap_contains"; }
    if (str_eq(name, "hashmap_remove") == 1) { return "shadow_hashmap_remove"; }
    if (str_eq(name, "hashmap_size") == 1) { return "shadow_hashmap_size"; }
    if (str_eq(name, "hashmap_free") == 1) { return "shadow_hashmap_free"; }
    if (str_eq(name, "set_new") == 1) { return "shadow_set_new"; }
    if (str_eq(name, "set_add") == 1) { return "shadow_set_add"; }
    if (str_eq(name, "set_contains") == 1) { return "shadow_set_contains"; }
    if (str_eq(name, "set_remove") == 1) { return "shadow_set_remove"; }
    if (str_eq(name, "set_size") == 1) { return "shadow_set_size"; }
    if (str_eq(name, "set_free") == 1) { return "shadow_set_free"; }
    if (str_eq(name, "rt_spawn_nullary") == 1) { return "shadow_spawn_nullary"; }
    if (str_eq(name, "rt_spawn_thunk") == 1) { return "shadow_spawn_thunk"; }
    if (str_eq(name, "rt_future_await") == 1) { return "shadow_future_await"; }
    if (str_eq(name, "rt_sched_run") == 1) { return "shadow_sched_run"; }
    if (str_eq(name, "rt_sched_init") == 1) { return "shadow_sched_init"; }
    if (str_eq(name, "rt_future_new") == 1) { return "shadow_future_new"; }
    if (str_eq(name, "rt_future_complete") == 1) { return "shadow_future_complete"; }
    // C ABI 原语（@extern 的 extern_name）
    if (str_eq(name, "rt_malloc") == 1) { return "__rt_shadow_malloc"; }
    if (str_eq(name, "rt_store_int") == 1) { return "__rt_shadow_store_int"; }
    if (str_eq(name, "rt_store_long") == 1) { return "__rt_shadow_store_long"; }
    if (str_eq(name, "rt_store_float") == 1) { return "__rt_shadow_store_float"; }
    if (str_eq(name, "rt_store_ptr") == 1) { return "__rt_shadow_store_ptr"; }
    if (str_eq(name, "rt_load_int") == 1) { return "__rt_shadow_load_int"; }
    if (str_eq(name, "rt_load_long") == 1) { return "__rt_shadow_load_long"; }
    if (str_eq(name, "rt_load_float") == 1) { return "__rt_shadow_load_float"; }
    if (str_eq(name, "rt_load_ptr") == 1) { return "__rt_shadow_load_ptr"; }
    if (str_eq(name, "rt_str_cmp") == 1) { return "__rt_shadow_str_cmp"; }
    if (str_eq(name, "rt_puts") == 1) { return "__rt_shadow_puts"; }
    if (str_eq(name, "rt_throw_str") == 1) { return "shadow_throw_str"; }
    if (str_eq(name, "rt_sys_args") == 1) { return "shadow_sys_args"; }
    if (str_eq(name, "rt_sys_exec") == 1) { return "shadow_sys_exec"; }
    // GC 原语
    if (str_eq(name, "rt_gc_register_type") == 1) { return "shadow_gc_register_type"; }
    if (str_eq(name, "rt_gc_alloc") == 1) { return "shadow_gc_alloc"; }
    if (str_eq(name, "rt_gc_register") == 1) { return "shadow_gc_register"; }
    if (str_eq(name, "rt_gc_collect") == 1) { return "shadow_gc_collect"; }
    if (str_eq(name, "rt_gc_minor_collect") == 1) { return "shadow_gc_minor_collect"; }
    if (str_eq(name, "rt_gc_set_finalizer") == 1) { return "shadow_gc_set_finalizer"; }
    if (str_eq(name, "rt_gc_write_barrier") == 1) { return "shadow_gc_write_barrier"; }
    if (str_eq(name, "rt_gc_frame_enter") == 1) { return "shadow_gc_frame_enter"; }
    if (str_eq(name, "rt_gc_frame_leave") == 1) { return "shadow_gc_frame_leave"; }
    if (str_eq(name, "rt_gc_root_add") == 1) { return "shadow_gc_root_add"; }
    if (str_eq(name, "rt_gc_root_set") == 1) { return "shadow_gc_root_set"; }
    if (str_eq(name, "rt_gc_root_range") == 1) { return "shadow_gc_root_range"; }
    if (str_eq(name, "rt_gc_poll") == 1) { return "shadow_gc_poll"; }
    if (str_eq(name, "rt_gc_global_root_set") == 1) { return "shadow_gc_global_root_set"; }
    if (str_eq(name, "rt_gc_disable") == 1) { return "shadow_gc_disable"; }
    if (str_eq(name, "rt_gc_enable") == 1) { return "shadow_gc_enable"; }
    return name;
}

// ============ 类型映射 ============
pub kimo cg_llvm_type_kind(k: int) -> any {
    if (k == TYPE_VOID) { return llvm_void_ty(cg_ctx); }
    if (k == TYPE_UNIT) { return llvm_void_ty(cg_ctx); }
    if (k == TYPE_BOOL) { return llvm_i1(cg_ctx); }
    if (k == TYPE_CHAR) { return llvm_i8(cg_ctx); }
    if (k == TYPE_SHORT) { return llvm_i16(cg_ctx); }
    if (k == TYPE_INT) { return llvm_i32(cg_ctx); }
    if (k == TYPE_LONG) { return llvm_i64(cg_ctx); }
    if (k == TYPE_FLOAT) { return llvm_float_ty(cg_ctx); }
    if (k == TYPE_DOUBLE) { return llvm_double_ty(cg_ctx); }
    if (k == TYPE_ENUM) { return llvm_i32(cg_ctx); }
    if (k == TYPE_DATE) { return llvm_i32(cg_ctx); }
    if (k == TYPE_TIMESTAMP) { return llvm_i64(cg_ctx); }
    if (k == TYPE_NANOTIMESTAMP) { return llvm_i64(cg_ctx); }
    if (k == TYPE_OPAQUE) { return llvm_ptr_ty(llvm_i8(cg_ctx), 0); }
    if (k == TYPE_ENUM_PAYLOAD) { return llvm_ptr_ty(llvm_i8(cg_ctx), 0); }
    return llvm_ptr_ty(llvm_i8(cg_ctx), 0);
}

pub kimo cg_llvm_type(t: Type) -> any {
    if ((t as any) == 0) { return llvm_ptr_ty(llvm_i8(cg_ctx), 0); }
    return cg_llvm_type_kind(t.kind);
}

pub kimo cg_type_kind(t: Type) -> int {
    if ((t as any) == 0) { return TYPE_INT; }
    return t.kind;
}

pub kimo cg_is_float_kind(k: int) -> int {
    if (k == TYPE_FLOAT) { return 1; }
    if (k == TYPE_DOUBLE) { return 1; }
    return 0;
}

pub kimo cg_is_int_kind(k: int) -> int {
    if (k == TYPE_INT) { return 1; }
    if (k == TYPE_LONG) { return 1; }
    if (k == TYPE_SHORT) { return 1; }
    if (k == TYPE_CHAR) { return 1; }
    if (k == TYPE_BOOL) { return 1; }
    if (k == TYPE_ENUM) { return 1; }
    if (k == TYPE_DATE) { return 1; }
    if (k == TYPE_TIMESTAMP) { return 1; }
    if (k == TYPE_NANOTIMESTAMP) { return 1; }
    return 0;
}

pub kimo cg_int_width(k: int) -> int {
    if (k == TYPE_BOOL) { return 1; }
    if (k == TYPE_CHAR) { return 8; }
    if (k == TYPE_SHORT) { return 16; }
    if (k == TYPE_INT || k == TYPE_ENUM) { return 32; }
    if (k == TYPE_LONG) { return 64; }
    if (k == TYPE_DATE) { return 32; }
    if (k == TYPE_TIMESTAMP) { return 64; }
    if (k == TYPE_NANOTIMESTAMP) { return 64; }
    return 32;
}

pub kimo cg_is_ptr_kind(k: int) -> int {
    if (k == TYPE_STRING) { return 1; }
    if (k == TYPE_ARRAY) { return 1; }
    if (k == TYPE_DICT) { return 1; }
    if (k == TYPE_SET) { return 1; }
    if (k == TYPE_STRUCT) { return 1; }
    if (k == TYPE_ANY) { return 1; }
    if (k == TYPE_FUNCTION) { return 1; }
    if (k == TYPE_OPAQUE) { return 1; }
    if (k == TYPE_ENUM_PAYLOAD) { return 1; }
    return 0;
}

// 把 LLVM 值从 src_k cast 到 dst_k
pub kimo cg_cast_val(val: any, src_k: int, dst_k: int) -> any {
    if (src_k == dst_k) { return val; }
    let dst_ty = cg_llvm_type_kind(dst_k);
    if (cg_is_ptr_kind(src_k) == 1) {
        if (cg_is_ptr_kind(dst_k) == 1) { return val; }
        if (cg_is_int_kind(dst_k) == 1) { return llvm_ptrtoint(cg_builder, val, dst_ty, "ccast"); }
        let tmp = llvm_ptrtoint(cg_builder, val, llvm_i64(cg_ctx), "ccast");
        return llvm_sitofp(cg_builder, tmp, dst_ty, "ccast");
    }
    if (cg_is_int_kind(src_k) == 1) {
        if (cg_is_ptr_kind(dst_k) == 1) { return llvm_inttoptr(cg_builder, val, dst_ty, "ccast"); }
        if (cg_is_int_kind(dst_k) == 1) {
            if (dst_k == TYPE_BOOL && src_k != TYPE_BOOL) { return llvm_trunc(cg_builder, val, dst_ty, "ccast"); }
            if (src_k == TYPE_BOOL && dst_k != TYPE_BOOL) { return llvm_zext(cg_builder, val, dst_ty, "ccast"); }
            let src_w = cg_int_width(src_k);
            let dst_w = cg_int_width(dst_k);
            if (src_w == dst_w) { return val; }
            if (dst_w > src_w) { return llvm_sext(cg_builder, val, dst_ty, "ccast"); }
            if (dst_w < src_w) { return llvm_trunc(cg_builder, val, dst_ty, "ccast"); }
            return val;
        }
        if (cg_is_float_kind(dst_k) == 1) { return llvm_sitofp(cg_builder, val, dst_ty, "ccast"); }
    }
    if (cg_is_float_kind(src_k) == 1) {
        if (cg_is_float_kind(dst_k) == 1) {
            if (dst_k == TYPE_DOUBLE && src_k != TYPE_DOUBLE) { return llvm_fpext(cg_builder, val, dst_ty, "ccast"); }
            if (dst_k != TYPE_DOUBLE && src_k == TYPE_DOUBLE) { return llvm_fptrunc(cg_builder, val, dst_ty, "ccast"); }
            return val;
        }
        if (cg_is_int_kind(dst_k) == 1) { return llvm_fptosi(cg_builder, val, dst_ty, "ccast"); }
    }
    return val;
}

// ============ 基本块查找 / 字符串全局（去重） ============
pub kimo cg_find_block(label: string) -> any {
    let i = 0;
    while (i < len(cg_block_labels)) {
        let l = cg_block_labels[i] as string;
        if (str_eq(l, label) == 1) {
            return cg_block_ptrs[i];
        }
        i = i + 1;
    }
    return 0 as any;
}

// §5.2.4 协作式安全点：label 在 cg_block_labels 中的序号（-1 = 未找到）
pub kimo cg_blk_index(label: string) -> int {
    let i = 0;
    while (i < len(cg_block_labels)) {
        let l = cg_block_labels[i] as string;
        if (str_eq(l, label) == 1) { return i; }
        i = i + 1;
    }
    return -1;
}

// §5.2.4 协作式安全点：在函数入口 / 循环回边插入 poll（编译器生成，对标 Go preemptible）
// 内联 volatile 加载 g_gc_poll_flag：快路径（标志为 0）零函数调用开销，仅当标志置位
// 才调用 shadow_gc_poll 慢路径（STW 协作 / 触发检查）。实验（poll_cost.sh）显示
// volatile 加载比函数调用形式快 ~2x（sum_loop 51ms→26ms）。
pub kimo cg_get_poll_flag_global() -> any {
    if ((cg_poll_flag_g as any) == 0) {
        cg_poll_flag_g = llvm_add_global(cg_mod, llvm_i32(cg_ctx), "g_gc_poll_flag");
    }
    return cg_poll_flag_g;
}

pub kimo cg_emit_poll() -> void {
    let i32_ty = llvm_i32(cg_ctx);
    let flag = llvm_load(cg_builder, i32_ty, cg_get_poll_flag_global(), "pollflag");
    llvm_set_volatile(flag, 1);
    let zero = llvm_const_int(i32_ty, 0, 1);
    let cmp = llvm_icmp(cg_builder, LLVM_INT_EQ, flag, zero, "pollcmp");
    cg_poll_counter = cg_poll_counter + 1;
    let cn = int_to_str(cg_poll_counter);
    let call_bb = llvm_append_bb(cg_func, "poll_call" + cn);
    let skip_bb = llvm_append_bb(cg_func, "poll_skip" + cn);
    llvm_cond_br(cg_builder, cmp, skip_bb, call_bb);
    llvm_pos_builder_end(cg_builder, call_bb);
    let pa: array<any> = [];
    cg_call_named("rt_gc_poll", TYPE_VOID, pa);
    llvm_br(cg_builder, skip_bb);
    llvm_pos_builder_end(cg_builder, skip_bb);
    cg_cur_bb = skip_bb;
    cg_poll_skip_bb = skip_bb;
}

pub kimo cg_string_global(s: string) -> any {
    let i = 0;
    while (i < len(cg_str_keys)) {
        let k = cg_str_keys[i] as string;
        if (str_eq(k, s) == 1) { return cg_str_vals[i]; }
        i = i + 1;
    }
    let const_arr = llvm_const_str(s, len(s), 0);
    let arr_ty = llvm_type_of(const_arr);
    let name = ".str." + int_to_str(len(cg_str_keys));
    let g = llvm_add_global(cg_mod, arr_ty, name);
    llvm_set_init(g, const_arr);
    llvm_set_linkage(g, 9);  // LLVMPrivateLinkage
    let i8_ptr_ty = llvm_ptr_ty(llvm_i8(cg_ctx), 0);
    let ptr = llvm_const_bitcast(g, i8_ptr_ty);
    cg_str_keys = array_push(cg_str_keys, s);
    cg_str_vals = array_push(cg_str_vals, ptr);
    return ptr;
}


// ============ 缓冲区桥：call ============
pub kimo cg_emit_call(callee: any, ret_kind: int, arg_vals: array<any>) -> any {
    buf_reset();
    let i = 0;
    while (i < len(arg_vals)) {
        buf_push(arg_vals[i]);
        i = i + 1;
    }
    let fn_ty = llvm_global_get_value_type(callee);
    let nm = "calltmp";
    if (ret_kind == TYPE_VOID || ret_kind == TYPE_UNIT) { nm = ""; }
    return llvm_call(cg_builder, fn_ty, callee, len(arg_vals), nm);
}

// ============ 寄存器 / slot 读写 ============
pub kimo cg_set_reg(idx: int, val: any, ty_kind: int) -> void {
    cg_regs[idx] = val;
    cg_reg_types[idx] = ty_kind;
    // §5.2.4：该 reg 需要跨安全点保活 → 同时写入 shadow frame（无函数调用）
    if (idx >= 0 && idx < len(cg_sf_reg_slot)) {
        let sslot = cg_sf_reg_slot[idx];
        if (sslot >= 0) {
            cg_sf_store(sslot, val, ty_kind);
        }
    }
}

// §5.2.4 shadow frame：把值写入 [N x i64] 数组的 slot 号槽位（ptrtoint+add+inttoptr 模拟 GEP）
pub kimo cg_sf_store(slot: int, val: any, kind: int) -> void {
    if ((cg_sf_alloca as any) == 0) { return; }
    if (slot < 0) { return; }
    let i64_ty = llvm_i64(cg_ctx);
    let base_i = llvm_ptrtoint(cg_builder, cg_sf_alloca, i64_ty, "sfb");
    let off = llvm_const_int(i64_ty, slot * 8, 1);
    let addr = llvm_add(cg_builder, base_i, off, "sfa");
    let ptr = llvm_inttoptr(cg_builder, addr, llvm_ptr_ty(i64_ty, 0), "sfp");
    let iv = cg_val_to_i64(val, kind);
    llvm_store(cg_builder, iv, ptr);
}

// 取下一个内部临时槽号（预扫描时按指令序分配，codegen 时顺序消费）
pub kimo cg_sf_intr_next() -> int {
    let s = -1;
    if (cg_sf_intr_idx < len(cg_sf_intr_seq)) {
        s = cg_sf_intr_seq[cg_sf_intr_idx];
    }
    cg_sf_intr_idx = cg_sf_intr_idx + 1;
    return s;
}

pub kimo cg_get_reg(idx: int) -> any {
    return cg_regs[idx];
}

pub kimo cg_get_reg_kind(idx: int) -> int {
    return cg_reg_types[idx] as int;
}

// 查找函数；若未声明则按实参类型 + 返回 kind 现场声明
pub kimo cg_get_or_declare_fn(name: string, ret_kind: int, arg_vals: array<any>) -> any {
    let callee = llvm_get_fn(cg_mod, name);
    if ((callee as any) != 0) { return callee; }
    buf_reset();
    let i = 0;
    while (i < len(arg_vals)) {
        buf_push(llvm_type_of(arg_vals[i]));
        i = i + 1;
    }
    let ret_ty = cg_llvm_type_kind(ret_kind);
    let fn_ty = llvm_fn_ty(ret_ty, len(arg_vals), 0);
    return llvm_add_fn(cg_mod, name, fn_ty);
}

pub kimo cg_call_named(name: string, ret_kind: int, arg_vals: array<any>) -> any {
    let resolved_name = cg_resolve_extern_name(name);
    let callee = cg_get_or_declare_fn(resolved_name, ret_kind, arg_vals);
    return cg_emit_call(callee, ret_kind, arg_vals);
}

// §5.2.4 免 GC 帧的纯运行时函数：不分配、不触发 GC、无安全点，仅做内存读写。
// 这些函数在 runtime_lib.shadow 中实现，编译进每个用户程序；给它们免帧后
// 体积足够小，opt -O2 可内联进调用方，消除热循环里的帧 enter/leave/root 开销。
pub kimo cg_is_nogc_fn(name: string) -> int {
    if (str_eq(name, "shadow_array_get_ptr") == 1) { return 1; }
    if (str_eq(name, "shadow_array_get_int") == 1) { return 1; }
    if (str_eq(name, "shadow_array_get_long") == 1) { return 1; }
    if (str_eq(name, "shadow_array_get_float") == 1) { return 1; }
    if (str_eq(name, "shadow_array_set_int") == 1) { return 1; }
    if (str_eq(name, "shadow_array_set_long") == 1) { return 1; }
    if (str_eq(name, "shadow_array_set_float") == 1) { return 1; }
    if (str_eq(name, "shadow_array_set_ptr") == 1) { return 1; }
    if (str_eq(name, "shadow_array_len") == 1) { return 1; }
    if (str_eq(name, "shadow_array_cap") == 1) { return 1; }
    if (str_eq(name, "shadow_array_elem_size") == 1) { return 1; }
    if (str_eq(name, "shadow_array_pop") == 1) { return 1; }
    if (str_eq(name, "shadow_string_len") == 1) { return 1; }
    if (str_eq(name, "shadow_string_eq") == 1) { return 1; }
    if (str_eq(name, "shadow_string_ne") == 1) { return 1; }
    // 字符串拼接/单字符：纯 rt_malloc（非 GC 堆）+ memcpy，输入由调用方帧 root，
    // 结果非 GC 对象无需 root；免帧后可被 opt -O2 内联进热循环（str_reverse/str_concat）。
    if (str_eq(name, "shadow_string_concat") == 1) { return 1; }
    if (str_eq(name, "shadow_string_concat_inplace") == 1) { return 1; }
    if (str_eq(name, "shadow_subscript") == 1) { return 1; }
    if (str_eq(name, "shadow_schar") == 1) { return 1; }
    // 字符串查找：纯字节读取（rt_get_byte），无分配无 GC 交互（string_find 热循环）。
    if (str_eq(name, "shadow_index_of") == 1) { return 1; }
    if (str_eq(name, "shadow_contains") == 1) { return 1; }
    return 0;
}

// 热点运行时函数加 alwaysinline：opt -O2 强制内联进热循环，消除调用开销。
// 仅对免 GC 帧的小函数启用（体积小，内联不会显著膨胀代码）。
pub kimo cg_maybe_alwaysinline(fn: any, name: string) -> void {
    if (cg_is_nogc_fn(name) == 1) {
        llvm_set_alwaysinline(cg_ctx, fn);
    }
}

// 按元素 kind 选择数组/字典/存储函数
pub kimo cg_array_get_fn(ek: int) -> string {
    if (ek == TYPE_INT || ek == TYPE_CHAR || ek == TYPE_SHORT || ek == TYPE_BOOL || ek == TYPE_ENUM) { return "shadow_array_get_int"; }
    if (ek == TYPE_LONG) { return "shadow_array_get_long"; }
    if (ek == TYPE_FLOAT || ek == TYPE_DOUBLE) { return "shadow_array_get_float"; }
    if (ek == TYPE_DATE) { return "shadow_array_get_int"; }
    if (ek == TYPE_TIMESTAMP || ek == TYPE_NANOTIMESTAMP) { return "shadow_array_get_long"; }
    return "shadow_array_get_ptr";
}

pub kimo cg_array_set_fn(ek: int) -> string {
    if (ek == TYPE_INT || ek == TYPE_CHAR || ek == TYPE_SHORT || ek == TYPE_BOOL || ek == TYPE_ENUM) { return "shadow_array_set_int"; }
    if (ek == TYPE_LONG) { return "shadow_array_set_long"; }
    if (ek == TYPE_FLOAT || ek == TYPE_DOUBLE) { return "shadow_array_set_float"; }
    if (ek == TYPE_DATE) { return "shadow_array_set_int"; }
    if (ek == TYPE_TIMESTAMP || ek == TYPE_NANOTIMESTAMP) { return "shadow_array_set_long"; }
    return "shadow_array_set_ptr";
}

pub kimo cg_array_push_fn(ek: int) -> string {
    if (ek == TYPE_INT || ek == TYPE_CHAR || ek == TYPE_SHORT || ek == TYPE_BOOL || ek == TYPE_ENUM) { return "shadow_array_push_int_fast"; }
    if (ek == TYPE_LONG) { return "shadow_array_push_long_fast"; }
    if (ek == TYPE_FLOAT || ek == TYPE_DOUBLE) { return "shadow_array_push_float_fast"; }
    if (ek == TYPE_DATE) { return "shadow_array_push_int_fast"; }
    if (ek == TYPE_TIMESTAMP || ek == TYPE_NANOTIMESTAMP) { return "shadow_array_push_long_fast"; }
    return "shadow_array_push_ptr_fast";
}

// array_push 按数组静态元素类型分派 typed push（array<int>→shadow_array_push_int 等）。
// 独立小函数：避免 cg_gen_call 过大触发旧宿主 slot 上限致自举产物崩溃。
pub kimo cg_array_push_resolve(mi: MirInst, fallback: string) -> string {
    let arr_ty = mi.ty;
    if ((arr_ty as any) != 0 && arr_ty.kind == TYPE_ARRAY) {
        let elem_ty = arr_ty.elem_type;
        if ((elem_ty as any) != 0) {
            let pfn = cg_array_push_fn(elem_ty.kind);
            if (str_eq(pfn, "shadow_array_push_ptr") == 0) {
                return pfn;
            }
        }
    }
    return fallback;
}

pub kimo cg_elem_size(ek: int) -> int {
    if (ek == TYPE_INT || ek == TYPE_CHAR || ek == TYPE_SHORT || ek == TYPE_BOOL || ek == TYPE_ENUM) { return 4; }
    if (ek == TYPE_DATE) { return 4; }
    return 8;
}

// 静态类型数组直接 GEP+load/store：绕过 shadow_array_get_*/set_* 运行时函数，
// 消除热循环里每次访问的 elem_size 动态加载、es==4 分支与 __rt_shadow_load_int 调用。
// 标量元素（int/long/double 等）与固定 8 字节指针元素（嵌套数组/字符串/结构体等）
// 均启用；any 元素仍走运行时函数（裸句柄 + 协变赋值可能造成 es 与静态类型不一致）。
// 仅当索引为 int/long 时启用。指针元素直接 store 需写屏障（由 cg_gen_array_store_direct 补发）。
pub kimo cg_array_direct_ok(ek: int) -> int {
    if (ek == TYPE_INT || ek == TYPE_CHAR || ek == TYPE_SHORT || ek == TYPE_BOOL || ek == TYPE_ENUM) { return 1; }
    if (ek == TYPE_LONG) { return 1; }
    if (ek == TYPE_FLOAT || ek == TYPE_DOUBLE) { return 1; }
    if (ek == TYPE_DATE) { return 1; }
    if (ek == TYPE_TIMESTAMP || ek == TYPE_NANOTIMESTAMP) { return 1; }
    // 固定 8 字节指针元素：嵌套数组（array<array<int>>）、字符串、结构体、函数
    if (ek == TYPE_ARRAY) { return 1; }
    if (ek == TYPE_STRING) { return 1; }
    if (ek == TYPE_STRUCT) { return 1; }
    if (ek == TYPE_FUNCTION) { return 1; }
    return 0;
}

// 计算数组元素地址（i64）：base + 12 + idx*es
pub kimo cg_array_elem_addr(arr_val: any, idx_val: any, ik: int, es: int) -> any {
    let i64_ty = llvm_i64(cg_ctx);
    let base_i = llvm_ptrtoint(cg_builder, arr_val, i64_ty, "arrbase");
    let idx64 = idx_val;
    if (ik != TYPE_LONG) { idx64 = llvm_sext(cg_builder, idx_val, i64_ty, "idx64"); }
    let scaled = llvm_mul(cg_builder, idx64, llvm_const_int(i64_ty, es, 1), "idxscaled");
    let addr = llvm_add(cg_builder, llvm_add(cg_builder, base_i, llvm_const_int(i64_ty, 12, 1), "arrhdr"), scaled, "arraddr");
    return addr;
}

// 直接 GEP+load 数组元素（char/short/bool 以 4 字节槽存储，读后截断到实际宽度）
pub kimo cg_gen_array_load_direct(dst: int, arr_val: any, idx_val: any, ik: int, ek: int) -> void {
    let es = cg_elem_size(ek);
    let addr = cg_array_elem_addr(arr_val, idx_val, ik, es);
    let slot_ty = llvm_i32(cg_ctx);
    if (es == 8) {
        if (cg_is_float_kind(ek) == 1) { slot_ty = llvm_double_ty(cg_ctx); }
        else if (cg_is_ptr_kind(ek) == 1) { slot_ty = llvm_ptr_ty(llvm_i8(cg_ctx), 0); }
        else { slot_ty = llvm_i64(cg_ctx); }
    }
    let ptr = llvm_inttoptr(cg_builder, addr, llvm_ptr_ty(slot_ty, 0), "arrptr");
    let val = llvm_load(cg_builder, slot_ty, ptr, "arrval");
    if (ek == TYPE_CHAR) { val = llvm_trunc(cg_builder, val, llvm_i8(cg_ctx), "chtrunc"); }
    else if (ek == TYPE_SHORT) { val = llvm_trunc(cg_builder, val, llvm_i16(cg_ctx), "shtrunc"); }
    else if (ek == TYPE_BOOL) { val = llvm_trunc(cg_builder, val, llvm_i1(cg_ctx), "booltrunc"); }
    else if (ek == TYPE_FLOAT) { val = llvm_fptrunc(cg_builder, val, llvm_float_ty(cg_ctx), "fltrunc"); }
    cg_set_reg(dst, val, ek);
    return;
}

// 直接 GEP+store 数组元素（标量无需写屏障；char/short/bool 扩展回 4 字节槽；
// 指针元素补发 rt_gc_write_barrier——分代 GC 需把 old→young 引用记入 remembered set）
pub kimo cg_gen_array_store_direct(arr_val: any, idx_val: any, ik: int, ek: int, val_val: any, vk: int) -> void {
    let es = cg_elem_size(ek);
    let addr = cg_array_elem_addr(arr_val, idx_val, ik, es);
    let slot_ty = llvm_i32(cg_ctx);
    if (es == 8) {
        if (cg_is_float_kind(ek) == 1) { slot_ty = llvm_double_ty(cg_ctx); }
        else if (cg_is_ptr_kind(ek) == 1) { slot_ty = llvm_ptr_ty(llvm_i8(cg_ctx), 0); }
        else { slot_ty = llvm_i64(cg_ctx); }
    }
    let ptr = llvm_inttoptr(cg_builder, addr, llvm_ptr_ty(slot_ty, 0), "arrptr");
    let sv = cg_cast_val(val_val, vk, ek);
    if (ek == TYPE_CHAR) { sv = llvm_zext(cg_builder, sv, llvm_i32(cg_ctx), "chzext"); }
    else if (ek == TYPE_SHORT) { sv = llvm_zext(cg_builder, sv, llvm_i32(cg_ctx), "shzext"); }
    else if (ek == TYPE_BOOL) { sv = llvm_zext(cg_builder, sv, llvm_i32(cg_ctx), "boolzext"); }
    else if (ek == TYPE_FLOAT) { sv = llvm_fpext(cg_builder, sv, llvm_double_ty(cg_ctx), "flzext"); }
    llvm_store(cg_builder, sv, ptr);
    if (cg_is_ptr_kind(vk) == 1) {
        let wb_args: array<any> = [];
        wb_args = array_push(wb_args, arr_val);
        wb_args = array_push(wb_args, val_val);
        cg_call_named("rt_gc_write_barrier", TYPE_VOID, wb_args);
    }
    return;
}

pub kimo cg_store_fn(vk: int) -> string {
    if (vk == TYPE_INT || vk == TYPE_CHAR || vk == TYPE_SHORT || vk == TYPE_BOOL || vk == TYPE_ENUM) { return "rt_store_int"; }
    if (vk == TYPE_LONG) { return "rt_store_long"; }
    if (vk == TYPE_FLOAT || vk == TYPE_DOUBLE) { return "rt_store_float"; }
    if (vk == TYPE_DATE) { return "rt_store_int"; }
    if (vk == TYPE_TIMESTAMP || vk == TYPE_NANOTIMESTAMP) { return "rt_store_long"; }
    return "rt_store_ptr";
}

pub kimo cg_load_fn(vk: int) -> string {
    if (vk == TYPE_INT || vk == TYPE_CHAR || vk == TYPE_SHORT || vk == TYPE_BOOL || vk == TYPE_ENUM) { return "rt_load_int"; }
    if (vk == TYPE_LONG) { return "rt_load_long"; }
    if (vk == TYPE_FLOAT || vk == TYPE_DOUBLE) { return "rt_load_float"; }
    if (vk == TYPE_DATE) { return "rt_load_int"; }
    if (vk == TYPE_TIMESTAMP || vk == TYPE_NANOTIMESTAMP) { return "rt_load_long"; }
    return "rt_load_ptr";
}

pub kimo cg_is_str_eq_op(lk: int, rk: int, binop: int) -> int {
    if (binop == BIN_EQ) {
        if (lk == TYPE_STRING) { return 1; }
        if (rk == TYPE_STRING) { return 1; }
    }
    if (binop == BIN_NE) {
        if (lk == TYPE_STRING) { return 1; }
        if (rk == TYPE_STRING) { return 1; }
    }
    if (binop == BIN_LT || binop == BIN_GT || binop == BIN_LE || binop == BIN_GE) {
        if (lk == TYPE_STRING) { return 1; }
        if (rk == TYPE_STRING) { return 1; }
    }
    return 0;
}

pub kimo cg_is_comparison_op(binop: int) -> int {
    if (binop == BIN_EQ) { return 1; }
    if (binop == BIN_NE) { return 1; }
    if (binop == BIN_LT) { return 1; }
    if (binop == BIN_GT) { return 1; }
    if (binop == BIN_LE) { return 1; }
    if (binop == BIN_GE) { return 1; }
    return 0;
}

pub kimo cg_lub_kind(lk: int, rk: int) -> int {
    if (lk == TYPE_DATE) { lk = TYPE_INT; }
    if (lk == TYPE_TIMESTAMP || lk == TYPE_NANOTIMESTAMP) { lk = TYPE_LONG; }
    if (rk == TYPE_DATE) { rk = TYPE_INT; }
    if (rk == TYPE_TIMESTAMP || rk == TYPE_NANOTIMESTAMP) { rk = TYPE_LONG; }
    if (lk == rk) { return lk; }
    if (cg_is_ptr_kind(lk) == 1 || cg_is_ptr_kind(rk) == 1) { return TYPE_ANY; }
    if (cg_is_float_kind(lk) == 1 || cg_is_float_kind(rk) == 1) {
        if (lk == TYPE_DOUBLE || rk == TYPE_DOUBLE) { return TYPE_DOUBLE; }
        return TYPE_FLOAT;
    }
    if (cg_is_int_kind(lk) == 1 && cg_is_int_kind(rk) == 1) {
        if (lk == TYPE_LONG || rk == TYPE_LONG) { return TYPE_LONG; }
        return TYPE_INT;
    }
    return TYPE_INT;
}

// 隐式返回（MIR_RET arg1<0）
pub kimo cg_emit_ret_default() -> void {
    cg_gc_leave_frame();
    if (cg_cur_ret_is_void == 1) {
        llvm_ret_void(cg_builder);
        return;
    }
    llvm_ret(cg_builder, cg_cur_ret_default);
}

// GC root frame（0.4 GC v1/v2 完成前沿用 0.3 符号）
pub kimo cg_gc_enter_frame() -> void {
    if (cg_gc_frame_active == 0) {
        cg_gc_frame_marker = 0 as any;
        return;
    }
    let no_args: array<any> = [];
    cg_gc_frame_marker = cg_call_named("rt_gc_frame_enter", TYPE_INT, no_args);
}

pub kimo cg_gc_leave_frame() -> void {
    if (cg_gc_frame_active == 0) { return; }
    let args: array<any> = [];
    args = array_push(args, cg_gc_frame_marker);
    cg_call_named("rt_gc_frame_leave", TYPE_INT, args);
}

pub kimo cg_gc_root_set_if_ptr(slot_ptr: any, val: any, kind: int) -> void {
    if (cg_is_ptr_kind(kind) == 0) { return; }
    let args: array<any> = [];
    args = array_push(args, slot_ptr);
    args = array_push(args, val);
    cg_call_named("rt_gc_root_set", TYPE_INT, args);
}

// GC 类型注册：按 (名称#大小#位图) 复用 type_id；首次生成 shadow_gc_register_type 调用
pub kimo cg_gc_type_get(type_name: string, size: int, bitmap: long) -> int {
    let key = type_name + "#" + int_to_str(size) + "#" + long_to_str(bitmap);
    let i = 0;
    while (i < len(cg_gc_type_keys)) {
        if (str_eq(cg_gc_type_keys[i] as string, key) == 1) {
            return cg_gc_type_ids[i] as int;
        }
        i = i + 1;
    }
    let tid = cg_gc_type_counter;
    cg_gc_type_counter = cg_gc_type_counter + 1;
    cg_gc_type_keys = array_push(cg_gc_type_keys, key);
    cg_gc_type_ids = array_push(cg_gc_type_ids, tid);
    let args: array<any> = [];
    args = array_push(args, llvm_const_int(llvm_i32(cg_ctx), tid, 1));
    args = array_push(args, llvm_const_int(llvm_i32(cg_ctx), size, 1));
    args = array_push(args, llvm_const_int(llvm_i64(cg_ctx), bitmap, 0));
    cg_call_named("rt_gc_register_type", TYPE_INT, args);
    return tid;
}

// 计算 n 字段的指针位图（bit i = 字段 i 是指针）；regs 为寄存器索引数组
pub kimo cg_gc_bitmap_of_fields(regs: array<int>) -> long {
    let nf = len(regs);
    let bm: long = 0;
    let bi = 0;
    while (bi < nf) {
        let fk = cg_get_reg_kind(regs[bi] as int);
        if (cg_is_ptr_kind(fk) == 1) {
            let pow: long = 1;
            let pj = 0;
            while (pj < bi) { pow = pow * 2; pj = pj + 1; }
            bm = bm + pow;
        }
        bi = bi + 1;
    }
    return bm;
}

pub kimo cg_to_string_of_reg(reg: int) -> any {
    let k = cg_get_reg_kind(reg);
    let v = cg_get_reg(reg);
    if (k == TYPE_STRING) { return v; }
    if (k == TYPE_INT) {
        let a: array<any> = [];
        a = array_push(a, v);
        return cg_call_named("shadow_to_string_int", TYPE_STRING, a);
    }
    if (k == TYPE_LONG) {
        let a: array<any> = [];
        a = array_push(a, v);
        return cg_call_named("shadow_to_string_long", TYPE_STRING, a);
    }
    if (k == TYPE_FLOAT || k == TYPE_DOUBLE) {
        let a: array<any> = [];
        a = array_push(a, v);
        return cg_call_named("shadow_to_string_float", TYPE_STRING, a);
    }
    if (k == TYPE_BOOL) {
        let a: array<any> = [];
        a = array_push(a, v);
        return cg_call_named("shadow_to_string_bool", TYPE_STRING, a);
    }
    let a: array<any> = [];
    a = array_push(a, v);
    return cg_call_named("shadow_any_to_string", TYPE_STRING, a);
}

// 任意 kind 的值 → i64（AnyBox.value）
pub kimo cg_val_to_i64(val: any, k: int) -> any {
    let i64_ty = llvm_i64(cg_ctx);
    if (cg_is_int_kind(k) == 1) {
        let w = cg_int_width(k);
        if (w >= 64) { return val; }
        if (w == 1) { return llvm_zext(cg_builder, val, i64_ty, "zext64"); }
        return llvm_sext(cg_builder, val, i64_ty, "sext64");
    }
    if (cg_is_float_kind(k) == 1) {
        let d_ty = llvm_double_ty(cg_ctx);
        let d_val = val;
        if (k == TYPE_FLOAT) {
            d_val = llvm_fpext(cg_builder, val, d_ty, "fpext64");
        }
        return llvm_bitcast(cg_builder, d_val, i64_ty, "dbl2i64");
    }
    if (cg_is_ptr_kind(k) == 1) {
        return llvm_ptrtoint(cg_builder, val, i64_ty, "ptr2i64");
    }
    return llvm_const_int(i64_ty, 0, 1);
}

// i64 → 指定 kind
pub kimo cg_i64_to_val(val: any, k: int) -> any {
    let dst_ty = cg_llvm_type_kind(k);
    if (cg_is_int_kind(k) == 1) {
        let w = cg_int_width(k);
        if (w >= 64) { return val; }
        return llvm_trunc(cg_builder, val, dst_ty, "trunc64");
    }
    if (cg_is_float_kind(k) == 1) {
        let d_ty = llvm_double_ty(cg_ctx);
        let d_val = llvm_bitcast(cg_builder, val, d_ty, "i642dbl");
        if (k == TYPE_FLOAT) {
            return llvm_fptrunc(cg_builder, d_val, dst_ty, "fptrunc32");
        }
        return d_val;
    }
    if (cg_is_ptr_kind(k) == 1) {
        return llvm_inttoptr(cg_builder, val, dst_ty, "i642ptr");
    }
    return val;
}


// ============ 单条 MIR 指令 codegen ============
pub kimo cg_gen_inst(inst: MirInst) -> void {
    let mi = inst;
    let op = mi.op;

    if (op == MIR_CONST_INT) {
        let k = cg_type_kind(mi.ty);
        let ty = cg_llvm_type(mi.ty);
        if (cg_is_int_kind(k) == 1) {
            // ⚠️ long 常量不可 cast int（截断）：1000000000000L 局部赋值会溢出成 3567587328。
            // longval 是 long（64 位），llvm_const_int 接受 long，直接传入。
            let v = llvm_const_int(ty, mi.longval, 1);
            cg_set_reg(mi.dst, v, k);
        } else {
            let v = llvm_const_null(ty);
            cg_set_reg(mi.dst, v, k);
        }
        return;
    }

    if (op == MIR_CONST_FLOAT) {
        let k = cg_type_kind(mi.ty);
        if (cg_is_float_kind(k) == 0) { k = TYPE_DOUBLE; }
        let ty = cg_llvm_type_kind(k);
        let v = llvm_const_float(ty, mi.floatval);
        cg_set_reg(mi.dst, v, k);
        return;
    }

    if (op == MIR_CONST_STR) {
        let v = cg_string_global(mi.strval);
        cg_set_reg(mi.dst, v, TYPE_STRING);
        return;
    }

    if (op == MIR_CONST_BOOL) {
        let v = llvm_const_int(llvm_i1(cg_ctx), mi.longval as int, 0);
        cg_set_reg(mi.dst, v, TYPE_BOOL);
        return;
    }

    if (op == MIR_CONST_NULL) {
        let i8_ptr = llvm_ptr_ty(llvm_i8(cg_ctx), 0);
        let v = llvm_const_null(i8_ptr);
        cg_set_reg(mi.dst, v, TYPE_ANY);
        return;
    }

    if (op == MIR_LOAD_VAR) {
        if (mi.arg1 < 0) {
            let gk = cg_global_kind(mi.strval);
            let gty = cg_llvm_type_kind(gk);
            let gptr = cg_global_lookup(mi.strval);
            let gv = llvm_load(cg_builder, gty, gptr, "gloadtmp");
            cg_set_reg(mi.dst, gv, gk);
            return;
        }
        let slot_ptr = cg_slots[mi.arg1];
        let k = cg_type_kind(mi.ty);
        let ty = cg_llvm_type(mi.ty);
        let v = llvm_load(cg_builder, ty, slot_ptr, "loadtmp");
        cg_set_reg(mi.dst, v, k);
        return;
    }

    if (op == MIR_STORE_VAR) {
        let val = cg_get_reg(mi.arg1);
        let src_k = cg_get_reg_kind(mi.arg1);
        let dst_k = cg_type_kind(mi.ty);
        let gc_kind = dst_k;
        if (cg_is_ptr_kind(gc_kind) == 0 && cg_is_ptr_kind(src_k) == 1) {
            gc_kind = src_k;
        }
        if (src_k != dst_k) {
            if (cg_is_float_kind(src_k) == 1 && cg_is_float_kind(dst_k) == 1) {
                val = cg_cast_val(val, src_k, dst_k);
            } else if (cg_is_int_kind(src_k) == 1 && cg_is_int_kind(dst_k) == 1) {
                val = cg_cast_val(val, src_k, dst_k);
            }
        }
        if (mi.arg2 < 0) {
            let gptr = cg_global_lookup(mi.strval);
            llvm_store(cg_builder, val, gptr);
            let gkind = cg_global_kind(mi.strval);
            if (cg_is_ptr_kind(gkind) == 0 && cg_is_ptr_kind(src_k) == 1) {
                gkind = src_k;
            }
            if (cg_is_ptr_kind(gkind) == 1) {
                let gc_args: array<any> = [];
                gc_args = array_push(gc_args, gptr);
                gc_args = array_push(gc_args, val);
                cg_call_named("rt_gc_global_root_set", TYPE_INT, gc_args);
            }
            return;
        }
        let slot_ptr = cg_slots[mi.arg2];
        llvm_store(cg_builder, val, slot_ptr);
        // §5.2.4：源寄存器已有 shadow frame 槽（值已随 cg_set_reg 写入 range-root 帧）时，
        // 跳过带互斥锁的 shadow_gc_root_set——frame 已保证跨安全点保活，消除每次赋值锁开销
        // （array_push 热循环 2M 次 push = 2M 次锁操作）。frame_active==1 守卫排除 nogc 免帧函数。
        let skip_root = 0;
        if (cg_gc_frame_active == 1 && mi.arg1 >= 0 && mi.arg1 < len(cg_sf_reg_slot)) {
            if (cg_sf_reg_slot[mi.arg1] >= 0) { skip_root = 1; }
        }
        if (skip_root == 0) {
            cg_gc_root_set_if_ptr(slot_ptr, val, gc_kind);
        }
        return;
    }

    if (op == MIR_BINOP) { cg_gen_binop(mi); return; }
    if (op == MIR_UNOP) {
        let operand = cg_get_reg(mi.arg1);
        let unop = mi.longval as int;
        if (unop == UN_NEG) {
            let k = cg_type_kind(mi.ty);
            if (cg_is_float_kind(k) == 1) {
                let ty = cg_llvm_type(mi.ty);
                let zero = llvm_const_float(ty, 0.0);
                cg_set_reg(mi.dst, llvm_fsub(cg_builder, zero, operand, "negtmp"), k);
            } else {
                cg_set_reg(mi.dst, llvm_neg(cg_builder, operand, "negtmp"), k);
            }
            return;
        }
        if (unop == UN_NOT) {
            cg_set_reg(mi.dst, llvm_not(cg_builder, operand, "nottmp"), TYPE_BOOL);
            return;
        }
        if (unop == UN_BITNOT) {
            cg_set_reg(mi.dst, llvm_not(cg_builder, operand, "bitnottmp"), k);
            return;
        }
        return;
    }

    if (op == MIR_CALL) {
        if (file_exists("build/.qdbg") == 1) {
            let r1c = cg_get_reg(1);
            let r1cn = 0;
            if ((r1c as any) == 0) { r1cn = 1; }
            println("DBG MIR_CALL pre reg1null=" + int_to_str(r1cn) + " fn=" + mi.strval);
        }
        cg_gen_call(mi); return; }
    if (op == MIR_MAKE_CLOSURE) { cg_gen_closure(mi); return; }
    if (op == MIR_CALL_INDIRECT) {
        if (file_exists("build/.qdbg") == 1) {
            let r1d = cg_get_reg(1);
            let r1dn = 0;
            if ((r1d as any) == 0) { r1dn = 1; }
            println("DBG MIR_CALL_IND pre reg1null=" + int_to_str(r1dn));
        }
        cg_gen_call_indirect(mi); return; }
    if (op == MIR_SPAWN) { cg_gen_spawn(mi); return; }
    if (op == MIR_AWAIT) { cg_gen_await(mi); return; }
    if (op == MIR_CAST) { cg_gen_cast(mi); return; }
    if (op == MIR_RET) {
        if (file_exists("build/.qdbg") == 1) {
            let r1b = cg_get_reg(1);
            let r1bn = 0;
            if ((r1b as any) == 0) { r1bn = 1; }
            println("DBG MIR_RET reg1null=" + int_to_str(r1bn) + " arg1=" + int_to_str(mi.arg1));
        }
        if (mi.arg1 >= 0) {
            let val = cg_get_reg(mi.arg1);
            let src_k = cg_get_reg_kind(mi.arg1);
            let dst_k = cg_cur_ret_kind;
            let rv = cg_cast_val(val, src_k, dst_k);
            cg_gc_leave_frame();
            llvm_ret(cg_builder, rv);
        } else {
            cg_emit_ret_default();
        }
        return;
    }

    if (op == MIR_BR) {
        // §5.2.4 协作式安全点：循环回边插 poll（目标块序 < 当前块序 = 回跳）
        let tidx = cg_blk_index(mi.strval);
        if (tidx >= 0 && tidx < cg_cur_blk_idx) { cg_emit_poll(); }
        let target = cg_find_block(mi.strval);
        llvm_br(cg_builder, target);
        return;
    }

    if (op == MIR_CONDBR) {
        // §5.2.4 协作式安全点：条件回边（then 或 else 任一回跳）插 poll
        let tidx1 = cg_blk_index(mi.strval);
        let tidx2 = cg_blk_index(mi.strval2);
        if ((tidx1 >= 0 && tidx1 < cg_cur_blk_idx) || (tidx2 >= 0 && tidx2 < cg_cur_blk_idx)) {
            cg_emit_poll();
        }
        let cond = cg_get_reg(mi.arg1);
        let ck = cg_get_reg_kind(mi.arg1);
        let then_bb = cg_find_block(mi.strval);
        let else_bb = cg_find_block(mi.strval2);
        if (ck != TYPE_BOOL) {
            if (ck == TYPE_INT || ck == TYPE_CHAR || ck == TYPE_SHORT || ck == TYPE_LONG || ck == TYPE_ENUM) {
                let zty = cg_llvm_type_kind(ck);
                let zero = llvm_const_int(zty, 0, 1);
                cond = llvm_icmp(cg_builder, LLVM_INT_NE, cond, zero, "condne");
            } else {
                let nullp = llvm_const_null(cg_llvm_type_kind(ck));
                cond = llvm_icmp(cg_builder, LLVM_INT_NE, cond, nullp, "condptr");
            }
        }
        llvm_cond_br(cg_builder, cond, then_bb, else_bb);
        return;
    }

    // MIR_INDEX: arr[idx] → dst
    if (op == MIR_INDEX) {
        let arr_val = cg_get_reg(mi.arg1);
        let idx_val = cg_get_reg(mi.arg2);
        let ek = cg_type_kind(mi.ty);
        let base_kind = cg_get_reg_kind(mi.arg1);
        if (base_kind == TYPE_DICT) {
            let dict_fn = "shadow_dict_get";
            if (ek == TYPE_INT || ek == TYPE_CHAR || ek == TYPE_SHORT || ek == TYPE_ENUM || ek == TYPE_DATE) {
                dict_fn = "shadow_dict_get_int";
            } else if (ek == TYPE_LONG || ek == TYPE_TIMESTAMP || ek == TYPE_NANOTIMESTAMP) {
                dict_fn = "shadow_dict_get_int";
            } else if (ek == TYPE_STRING) {
                dict_fn = "shadow_dict_get_string";
            }
            let arg_vals: array<any> = [];
            arg_vals = array_push(arg_vals, arr_val);
            arg_vals = array_push(arg_vals, idx_val);
            let result = cg_call_named(dict_fn, ek, arg_vals);
            if (ek == TYPE_BOOL) {
                let i1_ty = llvm_i1(cg_ctx);
                result = llvm_trunc(cg_builder, result, i1_ty, "booltrunc");
            }
            cg_set_reg(mi.dst, result, ek);
            return;
        }
        let fn_name = cg_array_get_fn(ek);
        if (base_kind == TYPE_STRING) {
            fn_name = "shadow_subscript";
        }
        // 静态类型标量数组 → 直接 GEP+load，绕过运行时函数
        let ik = cg_get_reg_kind(mi.arg2);
        if (base_kind == TYPE_ARRAY && cg_array_direct_ok(ek) == 1 && (ik == TYPE_INT || ik == TYPE_LONG)) {
            cg_gen_array_load_direct(mi.dst, arr_val, idx_val, ik, ek);
            return;
        }
        let arg_vals: array<any> = [];
        arg_vals = array_push(arg_vals, arr_val);
        arg_vals = array_push(arg_vals, idx_val);
        let result = cg_call_named(fn_name, ek, arg_vals);
        if (ek == TYPE_BOOL) {
            let i1_ty = llvm_i1(cg_ctx);
            result = llvm_trunc(cg_builder, result, i1_ty, "booltrunc");
        }
        cg_set_reg(mi.dst, result, ek);
        return;
    }

    // MIR_MEMBER: obj.field → dst（每字段 8 字节，offset = field_idx * 8）
    if (op == MIR_MEMBER) {
        let obj_val = cg_get_reg(mi.arg1);
        let fk = cg_type_kind(mi.ty);
        let field_idx = mi.longval as int;
        let offset = field_idx * 8;
        let off_val = llvm_const_int(llvm_i32(cg_ctx), offset, 1);
        let fn_name = cg_load_fn(fk);
        let arg_vals: array<any> = [];
        arg_vals = array_push(arg_vals, obj_val);
        arg_vals = array_push(arg_vals, off_val);
        let result = cg_call_named(fn_name, fk, arg_vals);
        if (fk == TYPE_BOOL) {
            let i1_ty = llvm_i1(cg_ctx);
            result = llvm_trunc(cg_builder, result, i1_ty, "booltrunc");
        }
        cg_set_reg(mi.dst, result, fk);
        return;
    }

    // MIR_ARRAY_LIT
    if (op == MIR_ARRAY_LIT) {
        let arr_ty = mi.ty;
        let ek = TYPE_ANY;
        if ((arr_ty as any) != 0) {
            let elem_ty = arr_ty.elem_type;
            if ((elem_ty as any) != 0) { ek = elem_ty.kind; }
        }
        let es = cg_elem_size(ek);
        let elems = mi.args;
        let n_elems = len(elems);
        let es_val = llvm_const_int(llvm_i32(cg_ctx), es, 1);
        let cap_val = llvm_const_int(llvm_i32(cg_ctx), n_elems, 1);
        let new_args: array<any> = [];
        new_args = array_push(new_args, es_val);
        new_args = array_push(new_args, cap_val);
        let arr_ptr = cg_call_named("shadow_array_new", TYPE_ANY, new_args);
        // §5.2.4：arr_ptr 在 push 循环的多个 call 之间没有其他根指向它，必须写入 sf
        let aslot = cg_sf_reg_slot[mi.dst];
        if (aslot >= 0) { cg_sf_store(aslot, arr_ptr, TYPE_ARRAY); }
        let i = 0;
        while (i < n_elems) {
            let elem_reg = elems[i] as int;
            let elem_val = cg_get_reg(elem_reg);
            let push_fn = cg_array_push_fn(ek);
            let push_args: array<any> = [];
            push_args = array_push(push_args, arr_ptr);
            push_args = array_push(push_args, elem_val);
            arr_ptr = cg_call_named(push_fn, TYPE_ANY, push_args);
            if (aslot >= 0) { cg_sf_store(aslot, arr_ptr, TYPE_ARRAY); }
            i = i + 1;
        }
        cg_set_reg(mi.dst, arr_ptr, TYPE_ARRAY);
        return;
    }

    // MIR_STRUCT_LIT: Name{...} → dst
    if (op == MIR_STRUCT_LIT) {
        let fields = mi.args;
        let n_fields = len(fields);
        let total = n_fields * 8;
        let total_val = llvm_const_int(llvm_i32(cg_ctx), total, 1);
        let has_drop = 0;
        let drop_fn_name = "";
        if (len(mi.strval) > 0) {
            drop_fn_name = "__impl__" + mi.strval + "__Drop__drop";
            if ((llvm_get_fn(cg_mod, drop_fn_name) as any) != 0) {
                has_drop = 1;
            }
        }
        let alloc_args: array<any> = [];
        alloc_args = array_push(alloc_args, total_val);
        let gctype_bm = cg_gc_bitmap_of_fields(fields);
        let gctype_id = cg_gc_type_get(mi.strval, total, gctype_bm);
        let kind_val = llvm_const_int(llvm_i32(cg_ctx), gctype_id, 1);
        alloc_args = array_push(alloc_args, kind_val);
        let obj_ptr = cg_call_named("rt_gc_alloc", TYPE_ANY, alloc_args);
        // §5.2.4：obj_ptr 在逐字段 store 的多个 call 之间没有其他根指向它
        let oslot = cg_sf_reg_slot[mi.dst];
        if (oslot >= 0) { cg_sf_store(oslot, obj_ptr, TYPE_STRUCT); }
        let i = 0;
        while (i < n_fields) {
            let field_reg = fields[i] as int;
            let field_val = cg_get_reg(field_reg);
            let vk = cg_get_reg_kind(field_reg);
            if (cg_is_float_kind(vk) == 1) {
                field_val = cg_cast_val(field_val, vk, TYPE_DOUBLE);
            }
            let offset = i * 8;
            let off_val = llvm_const_int(llvm_i32(cg_ctx), offset, 1);
            let store_fn = cg_store_fn(vk);
            let store_args: array<any> = [];
            store_args = array_push(store_args, obj_ptr);
            store_args = array_push(store_args, off_val);
            store_args = array_push(store_args, field_val);
            cg_call_named(store_fn, TYPE_VOID, store_args);
            i = i + 1;
        }
        if (has_drop == 1) {
            let drop_fn_val = llvm_get_fn(cg_mod, drop_fn_name);
            let fin_args: array<any> = [];
            fin_args = array_push(fin_args, obj_ptr);
            fin_args = array_push(fin_args, drop_fn_val);
            fin_args = array_push(fin_args, obj_ptr);
            cg_call_named("rt_gc_set_finalizer", TYPE_VOID, fin_args);
        }
        let result_kind = TYPE_STRUCT;
        if (len(mi.strval) == 0) { result_kind = TYPE_TUPLE; }
        cg_set_reg(mi.dst, obj_ptr, result_kind);
        return;
    }

    // MIR_STORE_INDEX: arr[idx]=val
    if (op == MIR_STORE_INDEX) {
        let arr_val = cg_get_reg(mi.arg1);
        let idx_val = cg_get_reg(mi.arg2);
        let val_reg = mi.args[0] as int;
        let val_val = cg_get_reg(val_reg);
        let vk = cg_get_reg_kind(val_reg);
        let base_kind = cg_get_reg_kind(mi.arg1);
        if (base_kind == TYPE_DICT) {
            let tag = 4;
            if (vk == TYPE_INT || vk == TYPE_CHAR || vk == TYPE_SHORT || vk == TYPE_ENUM || vk == TYPE_DATE) {
                tag = 0;
            } else if (vk == TYPE_LONG || vk == TYPE_TIMESTAMP || vk == TYPE_NANOTIMESTAMP) {
                tag = 0;
            } else if (vk == TYPE_FLOAT || vk == TYPE_DOUBLE) {
                tag = 1;
            } else if (vk == TYPE_STRING) {
                tag = 2;
            } else if (vk == TYPE_BOOL) {
                tag = 3;
            }
            let tag_val = llvm_const_int(llvm_i32(cg_ctx), tag, 1);
            let arg_vals: array<any> = [];
            arg_vals = array_push(arg_vals, arr_val);
            arg_vals = array_push(arg_vals, idx_val);
            arg_vals = array_push(arg_vals, tag_val);
            arg_vals = array_push(arg_vals, val_val);
            cg_call_named("shadow_dict_set", TYPE_VOID, arg_vals);
            return;
        }
        let set_fn = cg_array_set_fn(vk);
        // 静态类型标量数组 → 直接 GEP+store（标量无需写屏障），绕过运行时函数
        let ek = cg_type_kind(mi.ty);
        let ik = cg_get_reg_kind(mi.arg2);
        if (base_kind == TYPE_ARRAY && cg_array_direct_ok(ek) == 1 && (ik == TYPE_INT || ik == TYPE_LONG)) {
            cg_gen_array_store_direct(arr_val, idx_val, ik, ek, val_val, vk);
            return;
        }
        let arg_vals: array<any> = [];
        arg_vals = array_push(arg_vals, arr_val);
        arg_vals = array_push(arg_vals, idx_val);
        arg_vals = array_push(arg_vals, val_val);
        cg_call_named(set_fn, TYPE_VOID, arg_vals);
        if (cg_is_ptr_kind(vk) == 1) {
            let wb_args: array<any> = [];
            wb_args = array_push(wb_args, arr_val);
            wb_args = array_push(wb_args, val_val);
            cg_call_named("rt_gc_write_barrier", TYPE_VOID, wb_args);
        }
        return;
    }

    // MIR_STORE_MEMBER: obj.f=val
    if (op == MIR_STORE_MEMBER) {
        let obj_val = cg_get_reg(mi.arg1);
        let val_reg = mi.args[0] as int;
        let val_val = cg_get_reg(val_reg);
        let vk = cg_get_reg_kind(val_reg);
        let dst_k = cg_type_kind(mi.ty);
        if (cg_is_float_kind(vk) == 1 && cg_is_float_kind(dst_k) == 1) {
            val_val = cg_cast_val(val_val, vk, dst_k);
        }
        let field_idx = mi.longval as int;
        let offset = field_idx * 8;
        let off_val = llvm_const_int(llvm_i32(cg_ctx), offset, 1);
        let store_fn = cg_store_fn(vk);
        let arg_vals: array<any> = [];
        arg_vals = array_push(arg_vals, obj_val);
        arg_vals = array_push(arg_vals, off_val);
        arg_vals = array_push(arg_vals, val_val);
        cg_call_named(store_fn, TYPE_VOID, arg_vals);
        if (cg_is_ptr_kind(vk) == 1) {
            let wb_args: array<any> = [];
            wb_args = array_push(wb_args, obj_val);
            wb_args = array_push(wb_args, val_val);
            cg_call_named("rt_gc_write_barrier", TYPE_VOID, wb_args);
        }
        return;
    }

    // MIR_ENUM_CONSTRUCT: AnyBox { magic(4) | tag(4) | value(8) }
    if (op == MIR_ENUM_CONSTRUCT) { cg_gen_enum_construct(mi); return; }
    if (op == MIR_ENUM_GET_TAG) { cg_gen_enum_gettag(mi); return; }
    if (op == MIR_ENUM_GET_PAYLOAD) { cg_gen_enum_getpayload(mi); return; }
}

// 动态 any 操作数加减（从 cg_gen_binop 拆出独立 helper）：cg_gen_binop 过大触发旧宿主 slot 上限
// （历史约束，见本拆分注释），故把 any+any/sub 拦截逻辑独立成小函数以免自举产物寄存器越界崩溃。
// 同为 Bug1：`add ptr %x,%y` / `sub ptr` 在 LLVM 中非法（llc 拒绝）。仅 k==TYPE_ANY 且任一操作数
// 为指针类才改写（字符串 k==TYPE_STRING 不劫持，否则自举阶段 str+str 被当 i64 相加、字符串全毁、
// 固定点漂移）；按 i64 语义生成并登记 TYPE_LONG（保持 64 位不截断），返回 1 表示已处理。
pub kimo cg_gen_binop_any_arith(mi: MirInst, binop: int, lhs_raw: any, lk: int, rhs_raw: any, rk: int, k: int) -> int {
    if (binop != BIN_ADD && binop != BIN_SUB) { return 0; }
    if (k != TYPE_ANY) { return 0; }
    if (cg_is_float_kind(k) == 1) { return 0; }
    if (cg_is_str_eq_op(lk, rk, binop) == 1) { return 0; }
    if (cg_is_ptr_kind(lk) != 1 && cg_is_ptr_kind(rk) != 1) { return 0; }
    let pi_l = cg_cast_val(lhs_raw, lk, TYPE_LONG);
    let pi_r = cg_cast_val(rhs_raw, rk, TYPE_LONG);
    if (binop == BIN_ADD) {
        cg_set_reg(mi.dst, llvm_add(cg_builder, pi_l, pi_r, "addtmp"), TYPE_LONG);
        return 1;
    }
    cg_set_reg(mi.dst, llvm_sub(cg_builder, pi_l, pi_r, "subtmp"), TYPE_LONG);
    return 1;
}

// ============ cg_gen_inst 拆分 helpers ============
// 拆分 helper：cg_gen_inst 过大触发旧宿主 slot 上限（历史约束）
pub kimo cg_gen_binop(mi: MirInst) -> void {
        let lhs_raw = cg_get_reg(mi.arg1);
        let rhs_raw = cg_get_reg(mi.arg2);
        let binop = mi.longval as int;
        let k = cg_type_kind(mi.ty);
        let is_f = cg_is_float_kind(k);
        let lk = cg_get_reg_kind(mi.arg1);
        let rk = cg_get_reg_kind(mi.arg2);
        let is_str_eq = cg_is_str_eq_op(lk, rk, binop);
        let operand_k = k;
        if (cg_is_comparison_op(binop) == 1) {
            operand_k = cg_lub_kind(lk, rk);
        }
        let is_f_cmp = cg_is_float_kind(operand_k);
        let lhs = lhs_raw;
        let rhs = rhs_raw;
        if (k != TYPE_STRING) {
            if (is_str_eq == 0) {
                lhs = cg_cast_val(lhs_raw, lk, operand_k);
                rhs = cg_cast_val(rhs_raw, rk, operand_k);
            }
        }
        // 动态(ptr/any)操作数乘法：寄存器 SSA 型是 ptr，而 `mul ptr` 在 LLVM 中非法（Bug1 根因）。
        if (is_f == 0 && is_str_eq == 0 && cg_is_ptr_kind(operand_k) == 1 && binop == BIN_MUL) {
            // Bug1 修复：两个动态(ptr/any)值相乘在 LLVM 中 `mul ptr` 非法（llc 拒绝编译）。动态里存
            // 的是裸整值，按 i64 乘法语义计算后 trunc 为 int 并登记为整型寄存器（TYPE_INT）：既避免
            // 非法 IR，又避免把整型乘积当指针登记进 shadow frame——否则 GC 会视其为指针并解引用，
            // 运行时 AV 崩溃（实测矩阵乘法 pre-fix 即如此）。回归用例 ex_mat_mult_dyn 现输出 134。
            let pi_l = cg_cast_val(lhs_raw, lk, TYPE_LONG);
            let pi_r = cg_cast_val(rhs_raw, rk, TYPE_LONG);
            let res_v = llvm_mul(cg_builder, pi_l, pi_r, "multmp");
            let res_int = llvm_trunc(cg_builder, res_v, cg_llvm_type_kind(TYPE_INT), "multmp");
            cg_set_reg(mi.dst, res_int, TYPE_INT);
            return;
        }
        // 动态 any 操作数加减：同根 Bug1，`add ptr %x,%y` / `sub ptr` 在 LLVM 中非法（llc 拒绝）。
        // 只有 k==TYPE_ANY（如 c[0][0]+c[0][1] 两个裸 any 元素相加，探查确认生成 add ptr）才需要改写。
        // 反例：字符串拼接 k==TYPE_STRING 也是 ptr 类，若一并拦截会把 str+str 当 i64 相加，自举阶段
        // 编译自身源码时字符串全毁、stage2.exe 崩溃/固定点漂移。且编译器自身源码里不存在 k==TYPE_ANY
        // 的 ADD/SUB（否则旧 codegen 会早已生成非法 add ptr），故本分支在自举时不触发，固定点稳定。
        // 按 i64 语义生成并登记 TYPE_LONG（保持 64 位不截断）：裸 any 整值 42+7+19=68 成立，
        // 下游按 int 消费时自会截断；对含真实指针的 any 值保留地址位。
        if (cg_gen_binop_any_arith(mi, binop, lhs_raw, lk, rhs_raw, rk, k) == 1) { return; }

        if (binop == BIN_ADD) {
            if (k == TYPE_STRING) {
                let sl_slot = cg_sf_intr_next();
                let sr_slot = cg_sf_intr_next();
                let sl = cg_to_string_of_reg(mi.arg1);
                if (sl_slot >= 0) { cg_sf_store(sl_slot, sl, TYPE_STRING); }
                let sr = cg_to_string_of_reg(mi.arg2);
                if (sr_slot >= 0) { cg_sf_store(sr_slot, sr, TYPE_STRING); }
                let cargs: array<any> = [];
                cargs = array_push(cargs, sl);
                cargs = array_push(cargs, sr);
                let cv = cg_call_named("shadow_string_concat", TYPE_STRING, cargs);
                cg_set_reg(mi.dst, cv, TYPE_STRING);
                return;
            }
            if (is_f == 1) { cg_set_reg(mi.dst, llvm_fadd(cg_builder, lhs, rhs, "addtmp"), k); }
            else { cg_set_reg(mi.dst, llvm_add(cg_builder, lhs, rhs, "addtmp"), k); }
            return;
        }
        if (binop == BIN_SUB) {
            if (is_f == 1) { cg_set_reg(mi.dst, llvm_fsub(cg_builder, lhs, rhs, "subtmp"), k); }
            else { cg_set_reg(mi.dst, llvm_sub(cg_builder, lhs, rhs, "subtmp"), k); }
            return;
        }
        if (binop == BIN_MUL) {
            if (is_f == 1) { cg_set_reg(mi.dst, llvm_fmul(cg_builder, lhs, rhs, "multmp"), k); }
            else { cg_set_reg(mi.dst, llvm_mul(cg_builder, lhs, rhs, "multmp"), k); }
            return;
        }
        if (binop == BIN_DIV) {
            if (is_f == 1) { cg_set_reg(mi.dst, llvm_fdiv(cg_builder, lhs, rhs, "divtmp"), k); }
            else { cg_set_reg(mi.dst, llvm_sdiv(cg_builder, lhs, rhs, "divtmp"), k); }
            return;
        }
        if (binop == BIN_REM) {
            cg_set_reg(mi.dst, llvm_srem(cg_builder, lhs, rhs, "remtmp"), k);
            return;
        }
        if (binop == BIN_EQ) {
            if (is_str_eq == 1) {
                let cargs: array<any> = [];
                cargs = array_push(cargs, lhs_raw);
                cargs = array_push(cargs, rhs_raw);
                let cv = cg_call_named("shadow_string_eq", TYPE_INT, cargs);
                cg_set_reg(mi.dst, cg_cast_val(cv, TYPE_INT, TYPE_BOOL), TYPE_BOOL);
                return;
            }
            if (is_f_cmp == 1) { cg_set_reg(mi.dst, llvm_fcmp(cg_builder, LLVM_REAL_OEQ, lhs, rhs, "eqtmp"), TYPE_BOOL); }
            else { cg_set_reg(mi.dst, llvm_icmp(cg_builder, LLVM_INT_EQ, lhs, rhs, "eqtmp"), TYPE_BOOL); }
            return;
        }
        if (binop == BIN_NE) {
            if (is_str_eq == 1) {
                let cargs: array<any> = [];
                cargs = array_push(cargs, lhs_raw);
                cargs = array_push(cargs, rhs_raw);
                let cv = cg_call_named("shadow_string_eq", TYPE_INT, cargs);
                let eq_bool = cg_cast_val(cv, TYPE_INT, TYPE_BOOL);
                cg_set_reg(mi.dst, llvm_not(cg_builder, eq_bool, "netmp"), TYPE_BOOL);
                return;
            }
            if (is_f_cmp == 1) { cg_set_reg(mi.dst, llvm_fcmp(cg_builder, LLVM_REAL_ONE, lhs, rhs, "netmp"), TYPE_BOOL); }
            else { cg_set_reg(mi.dst, llvm_icmp(cg_builder, LLVM_INT_NE, lhs, rhs, "netmp"), TYPE_BOOL); }
            return;
        }
        if (binop == BIN_LT) {
            if (is_str_eq == 1) {
                let cargs: array<any> = [];
                cargs = array_push(cargs, lhs_raw);
                cargs = array_push(cargs, rhs_raw);
                let cmp_val = cg_call_named("rt_str_cmp", TYPE_INT, cargs);
                let zero = llvm_const_int(cg_llvm_type_kind(TYPE_INT), 0, 1);
                cg_set_reg(mi.dst, llvm_icmp(cg_builder, LLVM_INT_SLT, cmp_val, zero, "lttmp"), TYPE_BOOL);
                return;
            }
            if (is_f_cmp == 1) { cg_set_reg(mi.dst, llvm_fcmp(cg_builder, LLVM_REAL_OLT, lhs, rhs, "lttmp"), TYPE_BOOL); }
            else { cg_set_reg(mi.dst, llvm_icmp(cg_builder, LLVM_INT_SLT, lhs, rhs, "lttmp"), TYPE_BOOL); }
            return;
        }
        if (binop == BIN_GT) {
            if (is_str_eq == 1) {
                let cargs: array<any> = [];
                cargs = array_push(cargs, lhs_raw);
                cargs = array_push(cargs, rhs_raw);
                let cmp_val = cg_call_named("rt_str_cmp", TYPE_INT, cargs);
                let zero = llvm_const_int(cg_llvm_type_kind(TYPE_INT), 0, 1);
                cg_set_reg(mi.dst, llvm_icmp(cg_builder, LLVM_INT_SGT, cmp_val, zero, "gttmp"), TYPE_BOOL);
                return;
            }
            if (is_f_cmp == 1) { cg_set_reg(mi.dst, llvm_fcmp(cg_builder, LLVM_REAL_OGT, lhs, rhs, "gttmp"), TYPE_BOOL); }
            else { cg_set_reg(mi.dst, llvm_icmp(cg_builder, LLVM_INT_SGT, lhs, rhs, "gttmp"), TYPE_BOOL); }
            return;
        }
        if (binop == BIN_LE) {
            if (is_str_eq == 1) {
                let cargs: array<any> = [];
                cargs = array_push(cargs, lhs_raw);
                cargs = array_push(cargs, rhs_raw);
                let cmp_val = cg_call_named("rt_str_cmp", TYPE_INT, cargs);
                let zero = llvm_const_int(cg_llvm_type_kind(TYPE_INT), 0, 1);
                cg_set_reg(mi.dst, llvm_icmp(cg_builder, LLVM_INT_SLE, cmp_val, zero, "letmp"), TYPE_BOOL);
                return;
            }
            if (is_f_cmp == 1) { cg_set_reg(mi.dst, llvm_fcmp(cg_builder, LLVM_REAL_OLE, lhs, rhs, "letmp"), TYPE_BOOL); }
            else { cg_set_reg(mi.dst, llvm_icmp(cg_builder, LLVM_INT_SLE, lhs, rhs, "letmp"), TYPE_BOOL); }
            return;
        }
        if (binop == BIN_GE) {
            if (is_str_eq == 1) {
                let cargs: array<any> = [];
                cargs = array_push(cargs, lhs_raw);
                cargs = array_push(cargs, rhs_raw);
                let cmp_val = cg_call_named("rt_str_cmp", TYPE_INT, cargs);
                let zero = llvm_const_int(cg_llvm_type_kind(TYPE_INT), 0, 1);
                cg_set_reg(mi.dst, llvm_icmp(cg_builder, LLVM_INT_SGE, cmp_val, zero, "getmp"), TYPE_BOOL);
                return;
            }
            if (is_f_cmp == 1) { cg_set_reg(mi.dst, llvm_fcmp(cg_builder, LLVM_REAL_OGE, lhs, rhs, "getmp"), TYPE_BOOL); }
            else { cg_set_reg(mi.dst, llvm_icmp(cg_builder, LLVM_INT_SGE, lhs, rhs, "getmp"), TYPE_BOOL); }
            return;
        }
        if (binop == BIN_AND) {
            cg_set_reg(mi.dst, llvm_and(cg_builder, lhs, rhs, "andtmp"), TYPE_BOOL);
            return;
        }
        if (binop == BIN_OR) {
            cg_set_reg(mi.dst, llvm_or(cg_builder, lhs, rhs, "ortmp"), TYPE_BOOL);
            return;
        }
        if (binop == BIN_BITAND) {
            cg_set_reg(mi.dst, llvm_and(cg_builder, lhs, rhs, "bandtmp"), k);
            return;
        }
        if (binop == BIN_BITOR) {
            cg_set_reg(mi.dst, llvm_or(cg_builder, lhs, rhs, "bortmp"), k);
            return;
        }
        if (binop == BIN_BITXOR) {
            cg_set_reg(mi.dst, llvm_xor(cg_builder, lhs, rhs, "xortmp"), k);
            return;
        }
        if (binop == BIN_SHL) {
            cg_set_reg(mi.dst, llvm_shl(cg_builder, lhs, rhs, "shltmp"), k);
            return;
        }
        if (binop == BIN_SHR) {
            cg_set_reg(mi.dst, llvm_ashr(cg_builder, lhs, rhs, "shrtmp"), k);
            return;
        }
        return;
}

// 拆分 helper：cg_gen_inst 过大触发旧宿主 slot 上限（历史约束）
pub kimo cg_gen_call(mi: MirInst) -> void {
        let resolved_name = cg_resolve_extern_name(mi.strval);
        // array_push：按数组静态元素类型分派 typed push（array<int>→shadow_array_push_int 等）。
        // mi.ty 由 mir 侧携带第一个实参的数组类型；typed push 使静态类型数组以
        // 4/8 字节槽存储（es 与直接 GEP 优化一致），并消除 push 的 es 动态分支。
        if (str_eq(mi.strval, "array_push") == 1) {
            resolved_name = cg_array_push_resolve(mi, resolved_name);
        }
        let k = cg_type_kind(mi.ty);
        let arg_vals: array<any> = [];
        let args = mi.args;
        let i = 0;
        while (i < len(args)) {
            let reg = args[i] as int;
            let reg_val = cg_get_reg(reg);
            arg_vals = array_push(arg_vals, reg_val);
            i = i + 1;
        }
        // typed push 形参宽度固定（push_long=long、push_float=double），
        // 值类型不匹配时需显式转换，否则 call 以窄类型喂宽形参 → LLVM 类型不匹配。
        if (len(args) >= 2) {
            let vk = cg_get_reg_kind(args[1] as int);
            if (str_eq(resolved_name, "shadow_array_push_long") == 1 && cg_is_int_kind(vk) == 1 && vk != TYPE_LONG) {
                let ext_val = cg_cast_val(arg_vals[1], vk, TYPE_LONG);
                let new_args: array<any> = [arg_vals[0]];
                new_args = array_push(new_args, ext_val);
                arg_vals = new_args;
            }
            else if (str_eq(resolved_name, "shadow_array_push_float") == 1 && vk == TYPE_FLOAT) {
                let ext_val = cg_cast_val(arg_vals[1], TYPE_FLOAT, TYPE_DOUBLE);
                let new_args: array<any> = [arg_vals[0]];
                new_args = array_push(new_args, ext_val);
                arg_vals = new_args;
            }
        }
        if (str_eq(mi.strval, "len") == 1 && len(args) > 0) {
            let arg0_kind = cg_get_reg_kind(args[0] as int);
            if (arg0_kind == TYPE_STRING) {
                resolved_name = "shadow_string_len";
            }
        }
        // typeof：编译期类型内省——按参数静态类型发射字符串常量，不产生运行时调用。
        // 避免与编译器自身 runtime_for_selfhost_wk.o 的 shadow_typeof 强符号重复定义。
        if (str_eq(mi.strval, "typeof") == 1 && len(args) > 0) {
            let a0k = cg_get_reg_kind(args[0] as int);
            let tname = "unknown";
            if (a0k == TYPE_INT || a0k == TYPE_LONG || a0k == TYPE_CHAR || a0k == TYPE_SHORT || a0k == TYPE_DATE) { tname = "number"; }
            else if (a0k == TYPE_FLOAT || a0k == TYPE_DOUBLE) { tname = "float"; }
            else if (a0k == TYPE_BOOL) { tname = "bool"; }
            else if (a0k == TYPE_STRING) { tname = "string"; }
            else if (a0k == TYPE_ARRAY) { tname = "array"; }
            else if (a0k == TYPE_DICT) { tname = "dict"; }
            else if (a0k == TYPE_SET) { tname = "set"; }
            else if (a0k == TYPE_ANY) { tname = "any"; }
            let sptr = cg_string_global(tname);
            if (mi.dst >= 0) { cg_set_reg(mi.dst, sptr, TYPE_STRING); }
            return;
        }
        if (len(args) > 0) {
            let a0k = cg_get_reg_kind(args[0] as int);
            if (str_eq(mi.strval, "println") == 1) {
                if (a0k == TYPE_INT) { resolved_name = "shadow_println_int"; }
                else if (a0k == TYPE_LONG) { resolved_name = "shadow_println_long"; }
                else if (a0k == TYPE_FLOAT || a0k == TYPE_DOUBLE) { resolved_name = "shadow_println_float"; }
                else if (a0k == TYPE_BOOL) { resolved_name = "shadow_println_bool"; }
                else if (a0k == TYPE_STRING) { resolved_name = "shadow_println_str"; }
                else if (a0k == TYPE_DATE) { resolved_name = "shadow_println_int"; }
                else if (a0k == TYPE_TIMESTAMP || a0k == TYPE_NANOTIMESTAMP) { resolved_name = "shadow_println_long"; }
                // char/short：底层是 i8/i16 整数，语义上就是小整数。
                // 落到 shadow_any_println（期望 boxed 指针）会把 65 当地址解引用 → AV 崩溃。
                else if (a0k == TYPE_CHAR || a0k == TYPE_SHORT) { resolved_name = "shadow_println_int"; }
                else { resolved_name = "shadow_any_println"; }
            }
            else if (str_eq(mi.strval, "print") == 1) {
                if (a0k == TYPE_INT) { resolved_name = "shadow_print_int"; }
                else if (a0k == TYPE_LONG) { resolved_name = "shadow_print_long"; }
                else if (a0k == TYPE_FLOAT || a0k == TYPE_DOUBLE) { resolved_name = "shadow_print_float"; }
                else if (a0k == TYPE_BOOL) { resolved_name = "shadow_print_bool"; }
                else if (a0k == TYPE_STRING) { resolved_name = "shadow_print_str"; }
                else if (a0k == TYPE_DATE) { resolved_name = "shadow_print_int"; }
                else if (a0k == TYPE_TIMESTAMP || a0k == TYPE_NANOTIMESTAMP) { resolved_name = "shadow_print_long"; }
                else if (a0k == TYPE_CHAR || a0k == TYPE_SHORT) { resolved_name = "shadow_print_int"; }
                else { resolved_name = "shadow_any_print"; }
            }
            else if (str_eq(mi.strval, "to_string") == 1) {
                if (a0k == TYPE_INT) { resolved_name = "shadow_to_string_int"; }
                else if (a0k == TYPE_LONG) { resolved_name = "shadow_to_string_long"; }
                else if (a0k == TYPE_FLOAT || a0k == TYPE_DOUBLE) { resolved_name = "shadow_to_string_float"; }
                else if (a0k == TYPE_BOOL) { resolved_name = "shadow_to_string_bool"; }
                else if (a0k == TYPE_STRING) { resolved_name = "shadow_to_string_str"; }
                else if (a0k == TYPE_DATE) { resolved_name = "shadow_to_string_int"; }
                else if (a0k == TYPE_TIMESTAMP || a0k == TYPE_NANOTIMESTAMP) { resolved_name = "shadow_to_string_long"; }
                else if (a0k == TYPE_CHAR || a0k == TYPE_SHORT) { resolved_name = "shadow_to_string_int"; }
                else { resolved_name = "shadow_any_to_string"; }
            }
            // char/short 走 *_int 运行时入口，但 IR 值宽度是 i8/i16，
            // 直接喂给 i32 形参会按 i8/i16 声明函数 → 与运行时 ABI 不符。
            // 这里统一 sext 到 i32（char/short 都是有符号小整数）。
            if (a0k == TYPE_CHAR || a0k == TYPE_SHORT) {
                if (str_eq(mi.strval, "println") == 1 || str_eq(mi.strval, "print") == 1 ||
                    str_eq(mi.strval, "to_string") == 1) {
                    let wv = cg_cast_val(arg_vals[0], a0k, TYPE_INT);
                    let wargs: array<any> = [wv];
                    let wi = 1;
                    while (wi < len(arg_vals)) {
                        wargs = array_push(wargs, arg_vals[wi]);
                        wi = wi + 1;
                    }
                    arg_vals = wargs;
                }
            }
        }
        if (len(args) == 2 &&
            (str_eq(mi.strval, "set_add") == 1 ||
             str_eq(mi.strval, "set_contains") == 1 ||
             str_eq(mi.strval, "set_remove") == 1)) {
            let vk = cg_get_reg_kind(args[1] as int);
            if (vk == TYPE_INT || vk == TYPE_LONG || vk == TYPE_DATE
                || vk == TYPE_TIMESTAMP || vk == TYPE_NANOTIMESTAMP
                || vk == TYPE_BOOL) {
                if (str_eq(mi.strval, "set_add") == 1) { resolved_name = "shadow_set_add_int"; }
                else if (str_eq(mi.strval, "set_contains") == 1) { resolved_name = "shadow_set_contains_int"; }
                else { resolved_name = "shadow_set_remove_int"; }
                if (vk != TYPE_LONG) {
                    let ext_val = cg_cast_val(arg_vals[1], vk, TYPE_LONG);
                    let new_args: array<any> = [arg_vals[0]];
                    new_args = array_push(new_args, ext_val);
                    arg_vals = new_args;
                }
            }
        }
        if (len(args) == 3 && str_eq(mi.strval, "hashmap_insert") == 1) {
            let hvk = cg_get_reg_kind(args[2] as int);
            if (hvk == TYPE_INT || hvk == TYPE_LONG || hvk == TYPE_DATE
                || hvk == TYPE_TIMESTAMP || hvk == TYPE_NANOTIMESTAMP
                || hvk == TYPE_BOOL) {
                resolved_name = "shadow_hashmap_insert_int";
                if (hvk != TYPE_LONG) {
                    let hext_val = cg_cast_val(arg_vals[2], hvk, TYPE_LONG);
                    let hnew_args: array<any> = [arg_vals[0]];
                    hnew_args = array_push(hnew_args, arg_vals[1]);
                    hnew_args = array_push(hnew_args, hext_val);
                    arg_vals = hnew_args;
                }
            }
        }
        let callee = cg_get_or_declare_fn(resolved_name, k, arg_vals);
        let result = cg_emit_call(callee, k, arg_vals);
        // dst=-1（void 调用：rt_throw_str 等 MIR_CALL 无目标寄存器）绝不能写 cg_regs——
        // 负索引写坏数组结构，后续 cg_get_reg 读到垃圾/null（曾致 ? 解包的 GET_PAYLOAD
        // 读寄存器 1 得 null → IR `<null operand!>` → llc 崩溃）。
        if (mi.dst >= 0) { cg_set_reg(mi.dst, result, k); }
        return;

}

// 拆分 helper：cg_gen_inst 过大触发旧宿主 slot 上限（历史约束）
pub kimo cg_gen_closure(mi: MirInst) -> void {
        let fn_name = mi.strval;
        let fn_ptr = llvm_get_fn(cg_mod, fn_name);
        if ((fn_ptr as any) == 0) {
            let ret_ty = llvm_i32(cg_ctx);
            let fn_ty = llvm_fn_ty(ret_ty, 0, 1);
            fn_ptr = llvm_add_fn(cg_mod, fn_name, fn_ty);
        }
        let cap_regs = mi.args;
        let n_cap = len(cap_regs);
        let closure_size_val = llvm_const_int(llvm_i32(cg_ctx), 16, 1);
        let closure_alloc_args: array<any> = [];
        closure_alloc_args = array_push(closure_alloc_args, closure_size_val);
        closure_alloc_args = array_push(closure_alloc_args, llvm_const_int(llvm_i32(cg_ctx), 5, 1));
        let closure_ptr = cg_call_named("rt_gc_alloc", TYPE_ANY, closure_alloc_args);
        // §5.2.4：closure 与 env 在后续多个 call 之间都没有其他根指向，必须写入 sf
        let cslot = cg_sf_reg_slot[mi.dst];
        if (cslot >= 0) { cg_sf_store(cslot, closure_ptr, TYPE_FUNCTION); }
        let eslot = cg_sf_intr_next();
        let off0 = llvm_const_int(llvm_i32(cg_ctx), 0, 1);
        let store_fn_args: array<any> = [];
        store_fn_args = array_push(store_fn_args, closure_ptr);
        store_fn_args = array_push(store_fn_args, off0);
        store_fn_args = array_push(store_fn_args, fn_ptr);
        cg_call_named("rt_store_ptr", TYPE_VOID, store_fn_args);
        let env_ptr = llvm_const_null(llvm_ptr_ty(llvm_i8(cg_ctx), 0));
        if (n_cap > 0) {
            let env_size = n_cap * 8;
            let env_size_val = llvm_const_int(llvm_i32(cg_ctx), env_size, 1);
            let env_alloc_args: array<any> = [];
            env_alloc_args = array_push(env_alloc_args, env_size_val);
            let env_bm = cg_gc_bitmap_of_fields(cap_regs);
            let env_tid = cg_gc_type_get("__env__" + fn_name, env_size, env_bm);
            env_alloc_args = array_push(env_alloc_args, llvm_const_int(llvm_i32(cg_ctx), env_tid, 1));
            env_ptr = cg_call_named("rt_gc_alloc", TYPE_ANY, env_alloc_args);
            if (eslot >= 0) { cg_sf_store(eslot, env_ptr, TYPE_STRUCT); }
            let i = 0;
            while (i < n_cap) {
                let cap_reg = cap_regs[i] as int;
                let cap_val = cg_get_reg(cap_reg);
                let vk = cg_get_reg_kind(cap_reg);
                if (cg_is_float_kind(vk) == 1) {
                    cap_val = cg_cast_val(cap_val, vk, TYPE_DOUBLE);
                }
                let offset = i * 8;
                let off_val = llvm_const_int(llvm_i32(cg_ctx), offset, 1);
                let store_fn = cg_store_fn(vk);
                let sargs: array<any> = [];
                sargs = array_push(sargs, env_ptr);
                sargs = array_push(sargs, off_val);
                sargs = array_push(sargs, cap_val);
                cg_call_named(store_fn, TYPE_VOID, sargs);
                i = i + 1;
            }
        }
        let off8 = llvm_const_int(llvm_i32(cg_ctx), 8, 1);
        let store_env_args: array<any> = [];
        store_env_args = array_push(store_env_args, closure_ptr);
        store_env_args = array_push(store_env_args, off8);
        store_env_args = array_push(store_env_args, env_ptr);
        cg_call_named("rt_store_ptr", TYPE_VOID, store_env_args);
        cg_set_reg(mi.dst, closure_ptr, TYPE_FUNCTION);
        return;
}

// 拆分 helper：cg_gen_inst 过大触发旧宿主 slot 上限（历史约束）
pub kimo cg_gen_call_indirect(mi: MirInst) -> void {
        let closure_val = cg_get_reg(mi.arg1);
        let ret_kind = TYPE_VOID;
        let captured_count = 0;
        let param_types: array<Type> = [];
        if ((mi.ty as any) != 0) {
            let closure_ty = mi.ty;
            if (closure_ty.kind == TYPE_FUNCTION) {
                let rt_ty = closure_ty.ret_type;
                if ((rt_ty as any) != 0) { ret_kind = rt_ty.kind; }
                captured_count = closure_ty.captured_count;
                param_types = closure_ty.param_types;
            } else if (closure_ty.kind == TYPE_ANY) {
                ret_kind = TYPE_ANY;
            }
        }
        let ret_ty = cg_llvm_type_kind(ret_kind);
        let arg_vals: array<any> = [];
        let off0 = llvm_const_int(llvm_i32(cg_ctx), 0, 1);
        let load_fn_args: array<any> = [];
        load_fn_args = array_push(load_fn_args, closure_val);
        load_fn_args = array_push(load_fn_args, off0);
        let fn_ptr = cg_call_named("rt_load_ptr", TYPE_ANY, load_fn_args);
        if (captured_count > 0) {
            let off8 = llvm_const_int(llvm_i32(cg_ctx), 8, 1);
            let load_env_args: array<any> = [];
            load_env_args = array_push(load_env_args, closure_val);
            load_env_args = array_push(load_env_args, off8);
            let env_ptr = cg_call_named("rt_load_ptr", TYPE_ANY, load_env_args);
            let ci = 0;
            while (ci < captured_count) {
                let cap_ty = param_types[ci] as Type;
                let cap_kind = cap_ty.kind;
                let load_fn = cg_load_fn(cap_kind);
                let cap_off = ci * 8;
                let cap_off_val = llvm_const_int(llvm_i32(cg_ctx), cap_off, 1);
                let load_args: array<any> = [];
                load_args = array_push(load_args, env_ptr);
                load_args = array_push(load_args, cap_off_val);
                let cap_val = cg_call_named(load_fn, cap_kind, load_args);
                if (cap_kind == TYPE_FLOAT) {
                    cap_val = cg_cast_val(cap_val, TYPE_DOUBLE, TYPE_FLOAT);
                }
                arg_vals = array_push(arg_vals, cap_val);
                ci = ci + 1;
            }
        }
        let args = mi.args;
        let i = 0;
        while (i < len(args)) {
            let reg = args[i] as int;
            let reg_val = cg_get_reg(reg);
            arg_vals = array_push(arg_vals, reg_val);
            i = i + 1;
        }
        buf_reset();
        let j = 0;
        while (j < len(arg_vals)) {
            buf_push(llvm_type_of(arg_vals[j]));
            j = j + 1;
        }
        let fn_ty = llvm_fn_ty(ret_ty, len(arg_vals), 0);
        buf_reset();
        let k2 = 0;
        while (k2 < len(arg_vals)) {
            buf_push(arg_vals[k2]);
            k2 = k2 + 1;
        }
        let nm = "calltmp";
        if (ret_kind == TYPE_VOID || ret_kind == TYPE_UNIT) { nm = ""; }
        let result = llvm_call(cg_builder, fn_ty, fn_ptr, len(arg_vals), nm);
        cg_set_reg(mi.dst, result, ret_kind);
        return;

}

// 拆分 helper：cg_gen_inst 过大触发旧宿主 slot 上限（历史约束）
pub kimo cg_gen_spawn(mi: MirInst) -> void {
        let fn_name = cg_resolve_extern_name(mi.strval);
        let arg_regs = mi.args;
        let n_args = len(arg_regs);
        if (n_args == 0) {
            let fn_val = llvm_get_fn(cg_mod, fn_name);
            if ((fn_val as any) == 0) {
                let ptr_ty = llvm_ptr_ty(llvm_i8(cg_ctx), 0);
                let fn_ty = llvm_fn_ty(ptr_ty, 0, 0);
                fn_val = llvm_add_fn(cg_mod, fn_name, fn_ty);
            }
            let spawn_args: array<any> = [];
            spawn_args = array_push(spawn_args, fn_val);
            let fut = cg_call_named("rt_spawn_nullary", TYPE_ANY, spawn_args);
            cg_set_reg(mi.dst, fut, TYPE_ANY);
            return;
        }
        let fn_ty2 = mi.ty;
        let params = fn_ty2.param_types;
        let ret_ty2 = fn_ty2.ret_type;
        let ret_kind2 = ret_ty2.kind;
        let env_size = n_args * 8;
        let env_size_val = llvm_const_int(llvm_i32(cg_ctx), env_size, 1);
        let env_alloc_args: array<any> = [];
        env_alloc_args = array_push(env_alloc_args, env_size_val);
        let env_bm2 = cg_gc_bitmap_of_fields(arg_regs);
        let env_tid2 = cg_gc_type_get("__spawn_env__" + fn_name, env_size, env_bm2);
        env_alloc_args = array_push(env_alloc_args, llvm_const_int(llvm_i32(cg_ctx), env_tid2, 1));
        let env_ptr = cg_call_named("rt_gc_alloc", TYPE_ANY, env_alloc_args);
        // §5.2.4：env 在 store 循环与 rt_spawn_thunk 之间没有其他根指向它
        let esslot = cg_sf_intr_next();
        if (esslot >= 0) { cg_sf_store(esslot, env_ptr, TYPE_STRUCT); }
        let ai = 0;
        while (ai < n_args) {
            let arg_reg = arg_regs[ai] as int;
            let arg_val = cg_get_reg(arg_reg);
            let vk = cg_get_reg_kind(arg_reg);
            if (cg_is_float_kind(vk) == 1) {
                arg_val = cg_cast_val(arg_val, vk, TYPE_DOUBLE);
            }
            let offset = ai * 8;
            let off_val = llvm_const_int(llvm_i32(cg_ctx), offset, 1);
            let store_fn = cg_store_fn(vk);
            let sargs: array<any> = [];
            sargs = array_push(sargs, env_ptr);
            sargs = array_push(sargs, off_val);
            sargs = array_push(sargs, arg_val);
            cg_call_named(store_fn, TYPE_VOID, sargs);
            ai = ai + 1;
        }
        let thunk_name = "__spawn_thunk__" + fn_name;
        let thunk_fn = llvm_get_fn(cg_mod, thunk_name);
        if ((thunk_fn as any) == 0) {
            let saved_func = cg_func;
            let saved_bb = cg_cur_bb;
            let i8_ty = llvm_i8(cg_ctx);
            let i8p_ty = llvm_ptr_ty(i8_ty, 0);
            buf_reset();
            buf_push(i8p_ty);
            let thunk_fn_ty = llvm_fn_ty(i8p_ty, 1, 0);
            thunk_fn = llvm_add_fn(cg_mod, thunk_name, thunk_fn_ty);
            let thunk_bb = llvm_append_bb(thunk_fn, "entry");
            llvm_pos_builder_end(cg_builder, thunk_bb);
            let env_param = llvm_get_param(thunk_fn, 0);
            let thunk_args: array<any> = [];
            let ti = 0;
            while (ti < n_args) {
                let param = params[ti] as Type;
                let pk = param.kind;
                let load_fn = cg_load_fn(pk);
                let toff = llvm_const_int(llvm_i32(cg_ctx), ti * 8, 1);
                let largs: array<any> = [];
                largs = array_push(largs, env_param);
                largs = array_push(largs, toff);
                let loaded = cg_call_named(load_fn, pk, largs);
                if (pk == TYPE_FLOAT) {
                    loaded = cg_cast_val(loaded, TYPE_DOUBLE, TYPE_FLOAT);
                }
                thunk_args = array_push(thunk_args, loaded);
                ti = ti + 1;
            }
            let target_fn = llvm_get_fn(cg_mod, fn_name);
            if ((target_fn as any) == 0) {
                let target_ret_ty = cg_llvm_type_kind(ret_kind2);
                buf_reset();
                let pi = 0;
                while (pi < n_args) {
                    let pp = params[pi] as Type;
                    buf_push(cg_llvm_type_kind(pp.kind));
                    pi = pi + 1;
                }
                target_fn = llvm_add_fn(cg_mod, fn_name, llvm_fn_ty(target_ret_ty, n_args, 0));
            }
            let target_ret_ty = cg_llvm_type_kind(ret_kind2);
            buf_reset();
            let pi2 = 0;
            while (pi2 < n_args) {
                let pp2 = params[pi2] as Type;
                buf_push(cg_llvm_type_kind(pp2.kind));
                pi2 = pi2 + 1;
            }
            let target_fn_ty = llvm_fn_ty(target_ret_ty, n_args, 0);
            buf_reset();
            let ci = 0;
            while (ci < n_args) {
                buf_push(thunk_args[ci]);
                ci = ci + 1;
            }
            // 目标返回 void 时：调用不能带名字（LLVM 规则：void 指令不可命名），
            // thunk 自身仍须返回 i8*（签名固定）→ 返回 null 指针。
            let call_name = "thunk_result";
            if (ret_kind2 == TYPE_VOID || ret_kind2 == TYPE_UNIT) { call_name = ""; }
            let result_val = llvm_call(cg_builder, target_fn_ty, target_fn, n_args, call_name);
            if (ret_kind2 == TYPE_VOID || ret_kind2 == TYPE_UNIT) {
                let void_ret = llvm_const_null(llvm_ptr_ty(llvm_i8(cg_ctx), 0));
                llvm_ret(cg_builder, void_ret);
            } else {
                let ret_as_ptr = cg_cast_val(result_val, ret_kind2, TYPE_ANY);
                llvm_ret(cg_builder, ret_as_ptr);
            }
            cg_func = saved_func;
            llvm_pos_builder_end(cg_builder, saved_bb);
        }
        let thunk_ptr_ty = llvm_ptr_ty(llvm_i8(cg_ctx), 0);
        let spawn_args2: array<any> = [];
        spawn_args2 = array_push(spawn_args2, thunk_fn);
        spawn_args2 = array_push(spawn_args2, env_ptr);
        let fut2 = cg_call_named("rt_spawn_thunk", TYPE_ANY, spawn_args2);
        cg_set_reg(mi.dst, fut2, TYPE_ANY);
        return;

}

// 拆分 helper：cg_gen_inst 过大触发旧宿主 slot 上限（历史约束）
pub kimo cg_gen_await(mi: MirInst) -> void {
        let fut_val = cg_get_reg(mi.arg1);
        let await_args: array<any> = [];
        await_args = array_push(await_args, fut_val);
        let result = cg_call_named("rt_future_await", TYPE_ANY, await_args);
        cg_set_reg(mi.dst, result, TYPE_ANY);
        return;
}

// 拆分 helper：cg_gen_inst 过大触发旧宿主 slot 上限（历史约束）
pub kimo cg_gen_cast(mi: MirInst) -> void {
        let val = cg_get_reg(mi.arg1);
        let dst_k = cg_type_kind(mi.ty);
        let src_k = cg_get_reg_kind(mi.arg1);
        let dst_ty = cg_llvm_type(mi.ty);
        if (src_k == TYPE_STRING && dst_k == TYPE_STRING) {
            cg_set_reg(mi.dst, val, dst_k);
            return;
        }
        if (src_k == TYPE_STRING && dst_k == TYPE_ANY) {
            cg_set_reg(mi.dst, val, dst_k);
            return;
        }
        if (src_k == TYPE_ANY && dst_k == TYPE_STRING) {
            cg_set_reg(mi.dst, val, dst_k);
            return;
        }
        if (src_k == TYPE_STRING) {
            let parse_fn = "";
            if (dst_k == TYPE_BOOL) {
                parse_fn = "shadow_parse_bool";
            } else if (dst_k == TYPE_FLOAT || dst_k == TYPE_DOUBLE) {
                parse_fn = "shadow_parse_float";
            } else if (dst_k == TYPE_LONG || dst_k == TYPE_TIMESTAMP || dst_k == TYPE_NANOTIMESTAMP) {
                parse_fn = "shadow_parse_long";
            } else {
                parse_fn = "shadow_parse_int";
            }
            let arg_vals: array<any> = [];
            arg_vals = array_push(arg_vals, val);
            let ret_kind = dst_k;
            if (dst_k == TYPE_DATE) { ret_kind = TYPE_INT; }
            else if (dst_k == TYPE_TIMESTAMP || dst_k == TYPE_NANOTIMESTAMP) { ret_kind = TYPE_LONG; }
            else if (dst_k == TYPE_CHAR || dst_k == TYPE_SHORT || dst_k == TYPE_ENUM) { ret_kind = TYPE_INT; }
            let callee = cg_get_or_declare_fn(parse_fn, ret_kind, arg_vals);
            let call_val = cg_emit_call(callee, ret_kind, arg_vals);
            cg_set_reg(mi.dst, call_val, dst_k);
            return;
        }
        if (cg_is_ptr_kind(src_k) == 1) {
            if (cg_is_ptr_kind(dst_k) == 1) {
                cg_set_reg(mi.dst, llvm_bitcast(cg_builder, val, dst_ty, "casttmp"), dst_k);
                return;
            }
            if (cg_is_int_kind(dst_k) == 1) {
                cg_set_reg(mi.dst, llvm_ptrtoint(cg_builder, val, dst_ty, "casttmp"), dst_k);
                return;
            }
            let as_int = llvm_ptrtoint(cg_builder, val, llvm_i64(cg_ctx), "castint");
            cg_set_reg(mi.dst, llvm_sitofp(cg_builder, as_int, dst_ty, "casttmp"), dst_k);
            return;
        }
        if (cg_is_int_kind(src_k) == 1) {
            if (cg_is_ptr_kind(dst_k) == 1) {
                cg_set_reg(mi.dst, llvm_inttoptr(cg_builder, val, dst_ty, "casttmp"), dst_k);
                return;
            }
        }
        if (cg_is_float_kind(src_k) == 1) {
            if (cg_is_float_kind(dst_k) == 1) {
                if (dst_k == TYPE_DOUBLE) {
                    cg_set_reg(mi.dst, llvm_fpext(cg_builder, val, dst_ty, "casttmp"), dst_k);
                } else {
                    cg_set_reg(mi.dst, llvm_fptrunc(cg_builder, val, dst_ty, "casttmp"), dst_k);
                }
            } else {
                cg_set_reg(mi.dst, llvm_fptosi(cg_builder, val, dst_ty, "casttmp"), dst_k);
            }
        } else {
            if (cg_is_float_kind(dst_k) == 1) {
                cg_set_reg(mi.dst, llvm_sitofp(cg_builder, val, dst_ty, "casttmp"), dst_k);
            } else {
                if (dst_k == TYPE_LONG) {
                    cg_set_reg(mi.dst, llvm_sext(cg_builder, val, dst_ty, "casttmp"), dst_k);
                } else {
                    cg_set_reg(mi.dst, llvm_trunc(cg_builder, val, dst_ty, "casttmp"), dst_k);
                }
            }
        }
        return;
}

// 拆分 helper：cg_gen_inst 过大触发旧宿主 slot 上限（历史约束）
pub kimo cg_gen_enum_construct(mi: MirInst) -> void {
        let tag_val = llvm_const_int(llvm_i32(cg_ctx), mi.longval as int, 1);
        let i64_val = llvm_const_int(llvm_i64(cg_ctx), 0, 1);
        let payloads = mi.args;
        let n_payloads = len(payloads);
        if (n_payloads == 1) {
            let payload_reg = payloads[0] as int;
            let pval = cg_get_reg(payload_reg);
            let pk = cg_get_reg_kind(payload_reg);
            i64_val = cg_val_to_i64(pval, pk);
        }
        if (n_payloads > 1) {
            let buf_sz = n_payloads * 8;
            let sz_val = llvm_const_int(llvm_i32(cg_ctx), buf_sz, 1);
            let alloc_args: array<any> = [];
            alloc_args = array_push(alloc_args, sz_val);
            let payload_bm = cg_gc_bitmap_of_fields(payloads);
            let buf_tid = cg_gc_type_get("__enum_payload__", buf_sz, payload_bm);
            alloc_args = array_push(alloc_args, llvm_const_int(llvm_i32(cg_ctx), buf_tid, 1));
            let buf_ptr = cg_call_named("rt_gc_alloc", TYPE_ANY, alloc_args);
            // §5.2.4：buf_ptr 在 rt_store_long 循环的多个 call 之间必须保活
            let bslot = cg_sf_reg_slot[mi.dst];
            if (bslot >= 0) { cg_sf_store(bslot, buf_ptr, TYPE_ENUM_PAYLOAD); }
            let pi = 0;
            while (pi < n_payloads) {
                let payload_reg = payloads[pi] as int;
                let pval = cg_get_reg(payload_reg);
                let pk = cg_get_reg_kind(payload_reg);
                let p64 = cg_val_to_i64(pval, pk);
                let poff = pi * 8;
                let off_v = llvm_const_int(llvm_i32(cg_ctx), poff, 1);
                let st_args: array<any> = [];
                st_args = array_push(st_args, buf_ptr);
                st_args = array_push(st_args, off_v);
                st_args = array_push(st_args, p64);
                cg_call_named("rt_store_long", TYPE_VOID, st_args);
                pi = pi + 1;
            }
            i64_val = llvm_ptrtoint(cg_builder, buf_ptr, llvm_i64(cg_ctx), "pbuf2i64");
        }
        let box_args: array<any> = [];
        box_args = array_push(box_args, tag_val);
        box_args = array_push(box_args, i64_val);
        let box_ptr = cg_call_named("shadow_any_box", TYPE_ENUM_PAYLOAD, box_args);
        cg_set_reg(mi.dst, box_ptr, TYPE_ENUM_PAYLOAD);
        return;

}

// 拆分 helper：cg_gen_inst 过大触发旧宿主 slot 上限（历史约束）
pub kimo cg_gen_enum_gettag(mi: MirInst) -> void {
        let box_ptr = cg_get_reg(mi.arg1);
        if (file_exists("build/.qdbg") == 1) {
            let bn = 0;
            if ((box_ptr as any) == 0) { bn = 1; }
            println("DBG gettag arg1=" + int_to_str(mi.arg1) + " dst=" + int_to_str(mi.dst) + " boxnull=" + int_to_str(bn));
        }
        let off_val = llvm_const_int(llvm_i32(cg_ctx), 4, 1);
        let load_args: array<any> = [];
        load_args = array_push(load_args, box_ptr);
        load_args = array_push(load_args, off_val);
        let tag = cg_call_named("rt_load_int", TYPE_INT, load_args);
        cg_set_reg(mi.dst, tag, TYPE_INT);
        if (file_exists("build/.qdbg") == 1) {
            let r1 = cg_get_reg(1);
            let r1n = 0;
            if ((r1 as any) == 0) { r1n = 1; }
            println("DBG gettag-tail reg1null=" + int_to_str(r1n));
        }
        return;

}

// 拆分 helper：cg_gen_inst 过大触发旧宿主 slot 上限（历史约束）
pub kimo cg_gen_enum_getpayload(mi: MirInst) -> void {
        let box_ptr = cg_get_reg(mi.arg1);
        if (file_exists("build/.qdbg") == 1) {
            let bn2 = 0;
            if ((box_ptr as any) == 0) { bn2 = 1; }
            println("DBG getpayload arg1=" + int_to_str(mi.arg1) + " arg2=" + int_to_str(mi.arg2) + " boxnull=" + int_to_str(bn2) + " blk=" + int_to_str(cg_cur_blk_idx));
        }
        let off_val = llvm_const_int(llvm_i32(cg_ctx), 8, 1);
        let load_args: array<any> = [];
        load_args = array_push(load_args, box_ptr);
        load_args = array_push(load_args, off_val);
        let raw_i64 = cg_call_named("rt_load_long", TYPE_LONG, load_args);
        if (mi.arg2 > 1) {
            let buf_ptr2 = llvm_inttoptr(cg_builder, raw_i64, llvm_ptr_ty(llvm_i8(cg_ctx), 0), "i642pbuf");
            let pidx = mi.longval as int;
            let poff2 = pidx * 8;
            let off_v2 = llvm_const_int(llvm_i32(cg_ctx), poff2, 1);
            let ld2_args: array<any> = [];
            ld2_args = array_push(ld2_args, buf_ptr2);
            ld2_args = array_push(ld2_args, off_v2);
            raw_i64 = cg_call_named("rt_load_long", TYPE_LONG, ld2_args);
        }
        let payload_k = cg_type_kind(mi.ty);
        let result = cg_i64_to_val(raw_i64, payload_k);
        cg_set_reg(mi.dst, result, payload_k);
        return;
}

// ============ §5.2.4 精确根集：活跃性预扫描（对标 Go stack map） ============
// 安全点：该 MIR opcode 的 codegen 会生成 runtime 调用，可能触发 GC。
pub kimo cg_safepoint_op(op: int) -> int {
    if (op == MIR_CALL || op == MIR_CALL_INDIRECT) { return 1; }
    if (op == MIR_SPAWN || op == MIR_AWAIT) { return 1; }
    if (op == MIR_ARRAY_LIT || op == MIR_STRUCT_LIT) { return 1; }
    if (op == MIR_INDEX || op == MIR_MEMBER) { return 1; }
    if (op == MIR_BINOP || op == MIR_CAST) { return 1; }
    if (op == MIR_ENUM_CONSTRUCT || op == MIR_ENUM_GET_TAG || op == MIR_ENUM_GET_PAYLOAD) { return 1; }
    if (op == MIR_MAKE_CLOSURE) { return 1; }
    if (op == MIR_STORE_INDEX || op == MIR_STORE_MEMBER) { return 1; }
    return 0;
}

// 内部临时指针必须保活：该 opcode 的 codegen 在多个 call 之间持有中间指针
// （array_lit 的 arr_ptr、struct_lit 的 obj_ptr、enum 的 buf、closure 的 env），
// 只有指令结束才写入 dst reg —— 中途没有任何根指向它们，必须强制分配 sf 槽。
pub kimo cg_force_slot_op(op: int) -> int {
    if (op == MIR_ARRAY_LIT || op == MIR_STRUCT_LIT) { return 1; }
    if (op == MIR_ENUM_CONSTRUCT || op == MIR_MAKE_CLOSURE) { return 1; }
    return 0;
}

// 需要额外内部临时槽的数量（每个独立中间指针一个槽）
pub kimo cg_intr_slot_count(op: int, inst: MirInst) -> int {
    if (op == MIR_MAKE_CLOSURE || op == MIR_SPAWN) { return 1; }   // env
    if (op == MIR_BINOP) {
        if (cg_type_kind(inst.ty) == TYPE_STRING) { return 2; }   // sl, sr
    }
    return 0;
}

// §5.2.4 协作式安全点：label 在 blocks 中的序号（-1 = 未找到）
pub kimo cg_ana_blk_index(label: string, blocks: array<MirBlock>, n: int) -> int {
    let i = 0;
    while (i < n) {
        let b = blocks[i];
        if (str_eq(b.label, label) == 1) { return i; }
        i = i + 1;
    }
    return -1;
}

// 预扫描函数 MIR：计算哪些指针 reg 跨越安全点需要保活 + 内部临时槽。
// 返回 shadow frame 槽总数；填充 cg_sf_reg_slot（reg→槽，-1=无）、cg_sf_intr_seq。
//
// 活跃性规则（保守超集，只多 spill 绝不漏标）：
//   need[r] = 指针类型 且 有 def 且 有 use
//             且（def 之后遇过安全点 或 first_use 线性在 def 之前[跨块/回边]）
//   —— 即"def 后任意安全点之后 reg 仍可能被 use"一律保活，不试图区分
//      use 在安全点前还是后（循环回边会复用同一 use，精确区分必须做
//      真正的区间分析，成本高收益小；多 spill 的代价只是每 def 一条 store）。
pub kimo cg_analyze_liveness(mf: MirFunc, blocks_arg: array<MirBlock>) -> int {
    let n_regs = mf.n_regs;
    if (n_regs <= 0) { n_regs = 1; }
    let kinds: array<int> = [];
    let has_use: array<int> = [];
    let first_use: array<int> = [];
    let last_def: array<int> = [];
    let forced: array<int> = [];
    let safepoint_after_def: array<int> = [];
    let i = 0;
    while (i < n_regs) {
        kinds = array_push(kinds, TYPE_ANY);       // 空 ty 保守当指针
        has_use = array_push(has_use, 0);
        first_use = array_push(first_use, -1);
        last_def = array_push(last_def, -1);
        forced = array_push(forced, 0);
        safepoint_after_def = array_push(safepoint_after_def, 0);
        i = i + 1;
    }
    let blocks = blocks_arg;
    let n_blks = len(blocks);
    let seq = 0;
    let bi = 0;
    while (bi < n_blks) {
        let blk = blocks[bi];
        let insts = blk.insts;
        let n_insts = len(insts);
        let j = 0;
        while (j < n_insts) {
            let mi = insts[j];
            // uses（保守：slot 号混入无害，只多 spill）
            if (mi.arg1 >= 0 && mi.arg1 < n_regs) {
                has_use[mi.arg1] = 1;
                if (first_use[mi.arg1] < 0) { first_use[mi.arg1] = seq; }
            }
            if (mi.arg2 >= 0 && mi.arg2 < n_regs) {
                has_use[mi.arg2] = 1;
                if (first_use[mi.arg2] < 0) { first_use[mi.arg2] = seq; }
            }
            let ai = 0;
            while (ai < len(mi.args)) {
                let ar = mi.args[ai] as int;
                if (ar >= 0 && ar < n_regs) {
                    has_use[ar] = 1;
                    if (first_use[ar] < 0) { first_use[ar] = seq; }
                }
                ai = ai + 1;
            }
            // defs
            if (mi.dst >= 0 && mi.dst < n_regs) {
                last_def[mi.dst] = seq;
                if ((mi.ty as any) != 0) { kinds[mi.dst] = mi.ty.kind; }
                if (cg_force_slot_op(mi.op) == 1) { forced[mi.dst] = 1; }
            }
            // 安全点：def 后遇过安全点的 reg 全部置位
            if (cg_safepoint_op(mi.op) == 1) {
                let ri = 0;
                while (ri < n_regs) {
                    if (last_def[ri] >= 0) { safepoint_after_def[ri] = 1; }
                    ri = ri + 1;
                }
            }
            seq = seq + 1;
            j = j + 1;
        }
        let term = blk.terminator;
        if ((term as any) != 0) {
            let mt = term;
            if (mt.arg1 >= 0 && mt.arg1 < n_regs) {
                has_use[mt.arg1] = 1;
                if (first_use[mt.arg1] < 0) { first_use[mt.arg1] = seq; }
            }
            if (mt.arg2 >= 0 && mt.arg2 < n_regs) {
                has_use[mt.arg2] = 1;
                if (first_use[mt.arg2] < 0) { first_use[mt.arg2] = seq; }
            }
            let ai2 = 0;
            while (ai2 < len(mt.args)) {
                let ar2 = mt.args[ai2] as int;
                if (ar2 >= 0 && ar2 < n_regs) {
                    has_use[ar2] = 1;
                    if (first_use[ar2] < 0) { first_use[ar2] = seq; }
                }
                ai2 = ai2 + 1;
            }
            if (mt.dst >= 0 && mt.dst < n_regs) {
                last_def[mt.dst] = seq;
                if ((mt.ty as any) != 0) { kinds[mt.dst] = mt.ty.kind; }
                if (cg_force_slot_op(mt.op) == 1) { forced[mt.dst] = 1; }
            }
            // 安全点：runtime 调用 opcode，或循环回边（§5.2.4 协作式 poll 点）
            let mt_sp = 0;
            if (cg_safepoint_op(mt.op) == 1) { mt_sp = 1; }
            if (mt.op == MIR_BR || mt.op == MIR_CONDBR) {
                let ta = cg_ana_blk_index(mt.strval, blocks, n_blks);
                let tb = cg_ana_blk_index(mt.strval2, blocks, n_blks);
                if ((ta >= 0 && ta < bi) || (tb >= 0 && tb < bi)) { mt_sp = 1; }
            }
            if (mt_sp == 1) {
                let ri2 = 0;
                while (ri2 < n_regs) {
                    if (last_def[ri2] >= 0) { safepoint_after_def[ri2] = 1; }
                    ri2 = ri2 + 1;
                }
            }
            seq = seq + 1;
        }
        bi = bi + 1;
    }
    // 活跃性判定 + 槽分配（reg 升序）
    cg_sf_reg_slot = [];
    let a2 = 0;
    while (a2 < n_regs) {
        cg_sf_reg_slot = array_push(cg_sf_reg_slot, -1);
        a2 = a2 + 1;
    }
    let slot = 0;
    let r = 0;
    while (r < n_regs) {
        let need = 0;
        if (forced[r] == 1) {
            need = 1;
        } else if (cg_is_ptr_kind(kinds[r]) == 1 && has_use[r] == 1 && last_def[r] >= 0) {
            if (safepoint_after_def[r] == 1 || first_use[r] < last_def[r]) {
                need = 1;
            }
        }
        if (need == 1) {
            cg_sf_reg_slot[r] = slot;
            slot = slot + 1;
        }
        r = r + 1;
    }
    // 内部临时槽（按指令序分配，codegen 时 cg_sf_intr_next 顺序消费）
    cg_sf_intr_seq = [];
    cg_sf_intr_idx = 0;
    let bi2 = 0;
    while (bi2 < n_blks) {
        let blk2 = blocks[bi2];
        let insts2 = blk2.insts;
        let n_insts2 = len(insts2);
        let j2 = 0;
        while (j2 < n_insts2) {
            let mi2 = insts2[j2];
            let ni = cg_intr_slot_count(mi2.op, mi2);
            let ki = 0;
            while (ki < ni) {
                cg_sf_intr_seq = array_push(cg_sf_intr_seq, slot);
                slot = slot + 1;
                ki = ki + 1;
            }
            j2 = j2 + 1;
        }
        let term2 = blk2.terminator;
        if ((term2 as any) != 0) {
            let mt2 = term2;
            let nt = cg_intr_slot_count(mt2.op, mt2);
            let kt = 0;
            while (kt < nt) {
                cg_sf_intr_seq = array_push(cg_sf_intr_seq, slot);
                slot = slot + 1;
                kt = kt + 1;
            }
        }
        bi2 = bi2 + 1;
    }
    return slot;
}

// ============ 函数 codegen ============
pub kimo cg_gen_func(mf: MirFunc, blocks_arg: array<MirBlock>) -> void {
    if (cg_is_extern_sym(mf.name) == 1) {
        let n_blks = len(blocks_arg);
        if (n_blks == 0) { return; }
    }
    // §5.2.4：活跃性预扫描，确定 shadow frame 布局（需在分配 reg/slot 前）
    cg_sf_alloca = 0 as any;
    cg_sf_n = 0;
    cg_sf_intr_idx = 0;
    let sf_n = cg_analyze_liveness(mf, blocks_arg);
    let param_tys: array<any> = [];
    let params = mf.params;
    let n_params = len(params);
    let is_main = 0;
    let n_llvm_params = n_params;
    if (str_eq(mf.name, "main") == 1) {
        is_main = 1;
        n_llvm_params = n_params + 2;
    }
    // §5.2.4 GC 帧跳过：无活指针（sf_n==0）且无指针参数（且非 main）的函数
    // 不需要帧 enter/leave 与根集登记，仅保留入口/回边 poll（协作 STW 仍成立）。
    // 纯运行时函数（cg_is_nogc_fn）强制免帧：不分配不触发 GC，内联后消除热循环开销。
    let frame_needed = 0;
    if (sf_n > 0) { frame_needed = 1; }
    if (is_main == 1) { frame_needed = 1; }
    let pi = 0;
    while (pi < n_params) {
        let pp = params[pi];
        if (cg_is_ptr_kind(pp.type_kind) == 1) { frame_needed = 1; }
        pi = pi + 1;
    }
    if (cg_is_nogc_fn(mf.name) == 1) { frame_needed = 0; }
    cg_gc_frame_active = frame_needed;
    // 内联轮询状态：每函数重置（入口 poll 的 skip 块供 block 0 续接；计数器保证块名确定性）
    cg_poll_skip_bb = 0 as any;
    cg_poll_counter = 0;
    let i = 0;
    while (i < n_params) {
        let p = params[i];
        param_tys = array_push(param_tys, cg_llvm_type_kind(p.type_kind));
        i = i + 1;
    }
    if (is_main == 1) {
        param_tys = array_push(param_tys, cg_llvm_type_kind(TYPE_INT));
        param_tys = array_push(param_tys, cg_llvm_type_kind(TYPE_ANY));
    }
    let ret_ty = cg_llvm_type_kind(mf.return_type_kind);
    cg_cur_ret_kind = mf.return_type_kind;
    cg_cur_ret_default = llvm_const_int(ret_ty, 0, 1);
    if (cg_is_ptr_kind(mf.return_type_kind) == 1) {
        cg_cur_ret_default = llvm_const_null(ret_ty);
    }
    cg_cur_ret_is_void = 0;
    if (mf.return_type_kind == TYPE_VOID) { cg_cur_ret_is_void = 1; }
    if (mf.return_type_kind == TYPE_UNIT) { cg_cur_ret_is_void = 1; }

    buf_reset();
    i = 0;
    while (i < n_llvm_params) {
        buf_push(param_tys[i]);
        i = i + 1;
    }
    let fn_ty = llvm_fn_ty(ret_ty, n_llvm_params, 0);
    let existing = llvm_get_fn(cg_mod, mf.name);
    if ((existing as any) != 0) {
        cg_func = existing;
    } else {
        cg_func = llvm_add_fn(cg_mod, mf.name, fn_ty);
    }
    cg_maybe_alwaysinline(cg_func, mf.name);

    cg_block_labels = [];
    cg_block_ptrs = [];
    let blocks = blocks_arg;
    let n_blocks = len(blocks);
    i = 0;
    while (i < n_blocks) {
        let blk = blocks[i];
        let bb = llvm_append_bb(cg_func, blk.label);
        cg_block_labels = array_push(cg_block_labels, blk.label);
        cg_block_ptrs = array_push(cg_block_ptrs, bb);
        i = i + 1;
    }

    let entry_bb = cg_block_ptrs[0];

    cg_regs = [];
    cg_reg_types = [];
    let n_regs_alloc = mf.n_regs;
    if (n_regs_alloc < 256) { n_regs_alloc = 256; }
    i = 0;
    while (i < n_regs_alloc) {
        cg_regs = array_push(cg_regs, 0 as any);
        cg_reg_types = array_push(cg_reg_types, TYPE_INT);
        i = i + 1;
    }

    cg_slots = [];
    i = 0;
    while (i < 256) {
        cg_slots = array_push(cg_slots, 0 as any);
        i = i + 1;
    }

    llvm_pos_builder_end(cg_builder, entry_bb);
    let total_slots = mf.n_slots;
    if (total_slots < 1) { total_slots = 1; }
    if (total_slots > 256) { total_slots = 256; }
    let slot_ty = llvm_i64(cg_ctx);
    i = 0;
    while (i < total_slots) {
        let a = llvm_alloca(cg_builder, slot_ty, "slot");
        cg_slots[i] = a;
        i = i + 1;
    }
    // §5.2.4：shadow frame 数组 [sf_n x i64]，清零，entry 一次性登记为 range 根
    if (frame_needed == 1 && sf_n > 0) {
        let i64_ty = llvm_i64(cg_ctx);
        let sf_ty = llvm_array_ty(i64_ty, sf_n);
        cg_sf_alloca = llvm_alloca(cg_builder, sf_ty, "sf");
        cg_sf_n = sf_n;
        let zero_v = llvm_const_int(llvm_i8(cg_ctx), 0, 1);
        let len_v = llvm_const_int(i64_ty, sf_n * 8, 1);
        llvm_memset(cg_builder, cg_sf_alloca, zero_v, len_v, 8);
    }
    cg_gc_enter_frame();
    if (cg_sf_n > 0) {
        let ra: array<any> = [];
        ra = array_push(ra, cg_sf_alloca);
        ra = array_push(ra, llvm_const_int(llvm_i32(cg_ctx), cg_sf_n, 1));
        cg_call_named("rt_gc_root_range", TYPE_INT, ra);
    }
    if (is_main == 1) {
        let argc_val = llvm_get_param(cg_func, 0);
        let argv_val = llvm_get_param(cg_func, 1);
        let set_args_fn = llvm_get_fn(cg_mod, "shadow_set_cli_args");
        if ((set_args_fn as any) == 0) {
            buf_reset();
            buf_push(cg_llvm_type_kind(TYPE_INT));
            buf_push(cg_llvm_type_kind(TYPE_ANY));
            let set_args_ty = llvm_fn_ty(cg_llvm_type_kind(TYPE_VOID), 2, 0);
            set_args_fn = llvm_add_fn(cg_mod, "shadow_set_cli_args", set_args_ty);
        }
        buf_reset();
        buf_push(argc_val);
        buf_push(argv_val);
        let set_args_ft = llvm_global_get_value_type(set_args_fn);
        llvm_call(cg_builder, set_args_ft, set_args_fn, 2, "");
    }
    i = 0;
    while (i < n_params) {
        let p = params[i];
        let slot = p.slot;
        let param_idx = i;
        if (is_main == 1) { param_idx = i + 2; }
        let param_val = llvm_get_param(cg_func, param_idx);
        llvm_store(cg_builder, param_val, cg_slots[slot]);
        if (frame_needed == 1) {
            cg_gc_root_set_if_ptr(cg_slots[slot], param_val, p.type_kind);
        }
        i = i + 1;
    }
    // §5.2.4 协作式安全点：函数入口 poll（对标 Go 函数序言安全点）。
    // 入口处参数已在 slot / shadow frame，根集完整。
    // 免 GC 帧函数（纯运行时）跳过入口 poll：内联后避免在热循环里注入多余 poll，
    // 未内联时由调用方下一安全点覆盖（纯函数无分配无 GC，短小立即返回）。
    if (frame_needed == 1) {
        cg_emit_poll();
    }

    i = 0;
    while (i < n_blocks) {
        let blk = blocks[i];
        let bb = cg_block_ptrs[i];
        // 入口 poll 已内联（frame_needed==1 时 cg_poll_skip_bb 非空）：entry 块被
        // cond_br 终结，block 0 的指令须续接到 poll 的 skip 块，避免 append 到终结符之后。
        if (i == 0 && (cg_poll_skip_bb as any) != 0) {
            bb = cg_poll_skip_bb;
        }
        llvm_pos_builder_end(cg_builder, bb);
        cg_cur_bb = bb;
        cg_cur_blk_idx = i;
        let insts = blk.insts;
        let n_insts = len(insts);
        let j = 0;
        while (j < n_insts) {
            cg_gen_inst(insts[j]);
            j = j + 1;
        }
        let term = blk.terminator;
        if ((term as any) != 0) {
            cg_gen_inst(term);
        }
        i = i + 1;
    }
}

// ============ 外部函数声明 codegen ============
pub kimo cg_gen_extern(fd: FuncDef) -> void {
    let param_tys: array<any> = [];
    let params = fd.params;
    let n_params = len(params);
    let i = 0;
    while (i < n_params) {
        let p = params[i] as Param;
        param_tys = array_push(param_tys, cg_llvm_type(p.type_ref));
        i = i + 1;
    }
    let ret_ty = cg_llvm_type(fd.return_type);
    buf_reset();
    i = 0;
    while (i < n_params) {
        buf_push(param_tys[i]);
        i = i + 1;
    }
    let fn_ty = llvm_fn_ty(ret_ty, n_params, 0);
    llvm_add_fn(cg_mod, fd.extern_name, fn_ty);
    cg_extern_names = array_push(cg_extern_names, fd.name);
    cg_extern_names = array_push(cg_extern_names, fd.extern_name);
    cg_extern_syms = array_push(cg_extern_syms, fd.extern_name);
}

pub kimo cg_is_extern_sym(name: string) -> int {
    let i = 0;
    while (i < len(cg_extern_syms)) {
        let n = cg_extern_syms[i] as string;
        if (str_eq(n, name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// ============ 全局变量：发射 LLVM global 并按常量初始化 ============
pub kimo cg_emit_globals(globals: array<GlobalVar>) -> void {
    cg_global_names = [];
    cg_global_ptrs = [];
    cg_global_kinds = [];
    let i = 0;
    while (i < len(globals)) {
        let gv = globals[i];
        let name = gv.name;
        let kind = TYPE_INT;
        // 无注解全局：parser 给 type_ref = type_none_inner()（kind=TYPE_INFER 的非空对象）。
        // 必须排除 TYPE_INFER 再走 type_ref.kind，否则未注解全局一律被当 TYPE_INFER → 加载成 any →
        // println(g) 打印 <ptr> / 拼接垃圾（2026-08-13 实测 ex_global_infer）。
        if ((gv.type_ref as any) != 0 && gv.type_ref.kind != TYPE_INFER) {
            kind = gv.type_ref.kind;
        } else if (expr_is_none(gv.init) == 0) {
            let ie0 = gv.init;
            let inner_e = ie0;
            if (ie0.kind == EXPR_UNARY && (ie0.intval as int) == UN_NEG) {
                if (expr_is_none(ie0.child1) == 0) { inner_e = ie0.child1; }
            }
            if (inner_e.kind == EXPR_LONG) { kind = TYPE_LONG; }
            if (inner_e.kind == EXPR_FLOAT) { kind = TYPE_DOUBLE; }
            if (inner_e.kind == EXPR_BOOL) { kind = TYPE_BOOL; }
            if (inner_e.kind == EXPR_STRING) { kind = TYPE_STRING; }
        }
        let llty = cg_llvm_type_kind(kind);
        let g = llvm_add_global(cg_mod, llty, name);
        let init_val = 0 as any;
        if (cg_is_float_kind(kind) == 1) {
            let fv = 0.0;
            if (expr_is_none(gv.init) == 0) {
                let fe = gv.init;
                if (fe.kind == EXPR_UNARY && (fe.intval as int) == UN_NEG) {
                    let inner = fe.child1;
                    if (expr_is_none(inner) == 0 && inner.kind == EXPR_FLOAT) { fv = 0.0 - inner.floatval; }
                } else {
                    if (fe.kind == EXPR_FLOAT) { fv = fe.floatval; }
                }
            }
            init_val = llvm_const_float(llty, fv);
        } else if (cg_is_int_kind(kind) == 1) {
            let iv: long = 0;
            if (expr_is_none(gv.init) == 0) {
                let ce = gv.init;
                if (ce.kind == EXPR_UNARY && (ce.intval as int) == UN_NEG) {
                    let inner = ce.child1;
                    if (expr_is_none(inner) == 0) {
                        let ie = inner;
                        // ⚠️ long 常量不可 cast int（截断）：-1000000000000L 会溢出成 727379968。
                        // intval 本就是 long（64 位），直接参与 long 运算。
                        if (ie.kind == EXPR_INT || ie.kind == EXPR_LONG || ie.kind == EXPR_BOOL) { iv = 0 - ie.intval; }
                    }
                } else {
                    if (ce.kind == EXPR_INT || ce.kind == EXPR_LONG || ce.kind == EXPR_BOOL) { iv = ce.intval; }
                }
            }
            init_val = llvm_const_int(llty, iv, 1);
        } else {
            init_val = 0 as any;
            if (expr_is_none(gv.init) == 0) {
                let see = gv.init;
                if (see.kind == EXPR_STRING) { init_val = cg_string_global(see.str1); }
            }
            if ((init_val as any) == 0) { init_val = llvm_const_null(llty); }
        }
        llvm_set_init(g, init_val);
        cg_global_names = array_push(cg_global_names, name);
        cg_global_ptrs = array_push(cg_global_ptrs, g);
        cg_global_kinds = array_push(cg_global_kinds, kind);
        i = i + 1;
    }
}

// ============ 程序级 codegen ============
// 返回 .ll IR 文本
// 单模块发射核心：把 prog+mfuncs 发射进 caller 已创建的 mod（共享 ctx）。
// 不在此处 print/dispose，由 caller 控制（兼容单模块路径 / 严格态多模块链接合并）。
pub kimo cg_gen_module(prog: Program, mfuncs: array<MirFunc>, ctx: any, mod: any) -> void {
    // 强引用根：防止 GC 中途回收 MirFunc.blocks（0.3 历史 workaround，保留）
    cg_all_blocks = [];
    let cgabi = 0;
    while (cgabi < len(mfuncs)) {
        let cgabmf = mfuncs[cgabi];
        cg_all_blocks = array_push(cg_all_blocks, cgabmf.blocks);
        cgabi = cgabi + 1;
    }
    cg_ctx = ctx;
    cg_mod = mod;
    cg_builder = llvm_new_builder(cg_ctx);
    cg_str_keys = [];
    cg_str_vals = [];
    cg_extern_names = [];
    cg_extern_syms = [];
    cg_poll_flag_g = 0 as any;  // 每模块重建 g_gc_poll_flag 外部全局声明

    cg_emit_globals(prog.globals);

    let funcs = prog.funcs;
    let i = 0;
    while (i < len(funcs)) {
        let fd = funcs[i];
        if (len(fd.extern_name) > 0) {
            cg_gen_extern(fd);
        }
        i = i + 1;
    }

    // 预声明所有非 extern 函数（用自身签名），避免 call site 懒声明错误签名
    i = 0;
    while (i < len(mfuncs)) {
        let mfpd = mfuncs[i];
        let existing_decl = llvm_get_fn(cg_mod, mfpd.name);
        if ((existing_decl as any) == 0) {
            let fp_tys: array<any> = [];
            let fp_params = mfpd.params;
            let fp_n = len(fp_params);
            let fk = 0;
            while (fk < fp_n) {
                let fp = fp_params[fk];
                fp_tys = array_push(fp_tys, cg_llvm_type_kind(fp.type_kind));
                fk = fk + 1;
            }
            let fp_total = fp_n;
            if (str_eq(mfpd.name, "main") == 1) {
                fp_tys = array_push(fp_tys, cg_llvm_type_kind(TYPE_INT));
                fp_tys = array_push(fp_tys, cg_llvm_type_kind(TYPE_ANY));
                fp_total = fp_n + 2;
            }
            buf_reset();
            let fi2 = 0;
            while (fi2 < fp_total) {
                buf_push(fp_tys[fi2]);
                fi2 = fi2 + 1;
            }
            let fret_ty = cg_llvm_type_kind(mfpd.return_type_kind);
            let ffn_ty = llvm_fn_ty(fret_ty, fp_total, 0);
            llvm_add_fn(cg_mod, mfpd.name, ffn_ty);
        }
        i = i + 1;
    }

    // 函数去重（同名最后出现胜出，O(n) 预扫描）
    let cg_last_idx_names: array<string> = [];
    let cg_last_idx_vals: array<int> = [];
    i = 0;
    while (i < len(mfuncs)) {
        let mfi = mfuncs[i];
        let found = 0;
        let k = 0;
        while (k < len(cg_last_idx_names)) {
            let kn = cg_last_idx_names[k] as string;
            if (str_eq(kn, mfi.name) == 1) {
                cg_last_idx_vals[k] = i;
                found = 1;
                k = len(cg_last_idx_names);
            }
            k = k + 1;
        }
        if (found == 0) {
            cg_last_idx_names = array_push(cg_last_idx_names, mfi.name);
            cg_last_idx_vals = array_push(cg_last_idx_vals, i);
        }
        i = i + 1;
    }
    i = 0;
    while (i < len(mfuncs)) {
        let mfi = mfuncs[i];
        let should_gen = 0;
        let k = 0;
        while (k < len(cg_last_idx_names)) {
            let kn = cg_last_idx_names[k] as string;
            if (str_eq(kn, mfi.name) == 1) {
                let lv = cg_last_idx_vals[k] as int;
                if (lv == i) { should_gen = 1; }
                k = len(cg_last_idx_names);
            }
            k = k + 1;
        }
        if (should_gen == 1) {
            cg_gen_func(mfi, cg_all_blocks[i]);
        }
        i = i + 1;
    }

}

// 把 src 链接进 dest（LLVMLinkModules2：Src 被合并进 Dest 并消费）。0=成功。
pub kimo cg_link_modules(dest: any, src: any) -> int {
    return llvm_link_modules2(dest, src);
}

// 兼容单模块路径（行为与原 cg_gen_program 完全一致，输出字节不变）
pub kimo cg_gen_program(prog: Program, mfuncs: array<MirFunc>) -> string {
    let ctx = llvm_ctx_create();
    let mod = llvm_mod_create("shadow_module", ctx);
    cg_gen_module(prog, mfuncs, ctx, mod);
    let ir = llvm_print_mod(mod);
    llvm_del_builder(cg_builder);
    llvm_mod_dispose(mod);
    return ir;
}

// 严格态多模块路径：每模块独立 LLVModuleRef（共享 ctx），LLVMLinkModules2 合并后打印。
// 符号前缀隔离（模块命名空间）在后续里程碑经 prefix 参数接入。
pub kimo cg_gen_program_multi(modules: array<Program>, mfuncs_list: array<any>) -> string {
    let ctx = llvm_ctx_create();
    let final_mod = llvm_mod_create("shadow_program", ctx);
    let bi = 0;
    while (bi < len(modules)) {
        let mod = llvm_mod_create("shadow_module", ctx);
        let mf = mfuncs_list[bi] as array<MirFunc>;
        cg_gen_module(modules[bi], mf, ctx, mod);
        llvm_link_modules2(final_mod, mod);
        bi = bi + 1;
    }
    let ir = llvm_print_mod(final_mod);
    llvm_del_builder(cg_builder);
    llvm_mod_dispose(final_mod);
    return ir;
}
