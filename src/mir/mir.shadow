// Shadow 0.5 — MIR 管道（HIR → MIR：线性指令 + 显式基本块）
// ============================================================
// 将 HIR 树状结构 lower 为线性指令序列，控制流显式化为基本块。
// 每个函数生成若干 MirBlock，每个块以 br/condbr/ret 终止。
//
// 与 0.3 的差异（0.4 架构）：
//   - 无 typemap：指令类型直接读 h.inferred_type（0 as Type = 无）
//   - 无 any 盒子：children/args 全具体类型
//   - 无 payload enum 变体（Red）已在 TC 改写为 EXPR_INT；此处 EXPR_VAR
//     仅处理 TYPE_ENUM_PAYLOAD 的无负载变体（None）→ MIR_ENUM_CONSTRUCT
dsb mir;

import core.ast;
import core.const;
import core.utils;
import type_checker.type_checker;

@extern("shadow_env_get") kimo mir_env_get(name: string) -> string { return ""; }
let mir_dbg_on: int = -1;
pub kimo mir_dbg() -> int {
    if (mir_dbg_on < 0) {
        let v = mir_env_get("SHADOW_MIR_DBG");
        if (len(v) > 0) { mir_dbg_on = 1; } else { mir_dbg_on = 0; }
    }
    return mir_dbg_on;
}

// MIR builder 全局状态（每次 mir_lower_func 重置）
let mir_blocks: array<MirBlock> = [];
let mir_cur_label: string = "";
let mir_cur_insts: array<MirInst> = [];
let mir_cur_terminator: MirInst = 0 as MirInst;
let mir_n_regs: int = 0;
let mir_label_counter: int = 0;
let mir_loop_break_labels: array<string> = [];
let mir_loop_continue_labels: array<string> = [];
let mir_n_slots: int = 0;

// 当前正在 lower 的语句行号：mir_lower_stmt 每进入一条语句置位，
// mir_mk 据此给每条 MirInst 盖上 line（供 codegen debug 元数据用）。
let mir_cur_line: int = 0;

// 就地追加优化所有权跟踪：mir_owned[slot] = 1 表示该 slot 唯一持有其字符串缓冲
// （无其他活引用），可安全就地追加。保守数据流（仅 1→0，不会误判安全）：
//   - let x = 字面量/二元运算 → 新缓冲，owned=1
//   - let x = y（变量复制）/存储/传参/闭包捕获 → 源与目标共享，owned 均清 0
//   - let x = 调用/索引/成员 → 结果可能逃逸/共享，owned=0
//   - 函数调用结果视为逃逸（callee 可能保留/返回全局），owned=0
//   - 循环入口扫描体内别名操作，清除跨迭代共享（否则下一次迭代就地追加会污染别名）
let mir_owned: array<int> = [];

pub kimo mir_owned_clear(slot: int) -> void {
    if (slot >= 0 && slot < len(mir_owned)) {
        mir_owned[slot] = 0;
    }
}

pub kimo mir_owned_is(slot: int) -> int {
    if (slot >= 0 && slot < len(mir_owned)) { return mir_owned[slot]; }
    return 0;
}

pub kimo mir_owned_set(slot: int, v: int) -> void {
    if (slot >= 0 && slot < len(mir_owned)) {
        mir_owned[slot] = v;
    }
}

// 填充循环预分配跟踪：mir_slot_empty[slot]=1 表示该 slot 已知持有空数组（len=0）。
// 仅 let a=[] / a=[] 时置 1，任何其他写入清 0（保守）。供 STMT_WHILE 检测
// while (i < n) { a = array_push(a, v); i = i + 1; } 模式时确认 a 为空可安全预分配。
let mir_slot_empty: array<int> = [];

pub kimo mir_empty_is(slot: int) -> int {
    if (slot >= 0 && slot < len(mir_slot_empty)) { return mir_slot_empty[slot]; }
    return 0;
}

pub kimo mir_empty_set(slot: int, v: int) -> void {
    if (slot >= 0 && slot < len(mir_slot_empty)) {
        mir_slot_empty[slot] = v;
    }
}

// === 数组下标护栏消除：跨调用容量 + 循环界 + 整数下界（v10_s23）===
// 目标：codegen 对 array get/set 每次访问都发 load-cap + cmp + cmov 钳位护栏；
// 若 MIR 已能证明 `0 <= idx < cap(a)`，就标记 inb=1 整条免掉。证明由三件套叠出：
//   (1) 容量事实 cap_lb[arr]=src：arr 的 cap == src 槽的当前值。仅在数组由可数构造
//       （预分配/下标填充循环）建立、且 src 槽只写入一次（constish）时记录。
//   (2) 循环上界：while(cv<B)/while(cv<=B) 把计数变量 cv 的上界压入帧栈。
//   (3) 整数下界 vmin[slot]：slot 值的保守最小下界，经 常量/复制/加法/乘法 传播；
//       再加"cv 在体内单调不减"约束，可证 idx=cv-C >= 0。
// 上界：idx=cv-C，cv<=B，cap==B → idx < B == cap。
// 下界：cv 的循环入口下界 >= C 且 cv 单调不减 → idx >= 0 恒成立。
// 安全纪律：任一条证不出就返回 0（护栏保留）。宁漏证，不冒险——证错会直接堆越界写坏。
let mir_cap_lb_slot: array<int> = [];  // [数组槽]=容量来源槽（值==cap），仅 ok 位为 1 时有效
let mir_cap_lb_ok: array<int> = [];    // 1=该槽的容量事实已确立
let mir_constish: array<int> = [];     // 1=该槽只被写入过一次（let 后未被赋值），可当常量
let mir_vmin_known: array<int> = [];   // 1=vmin[slot] 有效
let mir_vmin: array<int> = [];         // [slot]=保守最小下界
// while 循环界帧栈（并行数组，深度 mir_lf_n）：
let mir_lf_slot: array<int> = [];      // 计数变量槽
let mir_lf_bound: array<int> = [];     // 上界源槽（-1 表示用 bval 常量）
let mir_lf_bval: array<int> = [];      // 上界常量值（bound==-1 时有效）
let mir_lf_inc: array<int> = [];       // 1=<=（含等），0=<（不含）
let mir_lf_mono: array<int> = [];      // 1=计数变量在体内单调不减
let mir_lf_cvmin: array<int> = [];     // 循环入口计数变量的最小下界
let mir_lf_n: int = 0;

// 跨调用容量事实登记表：调用点发现 "形如 cap(实参 a) == 另一实参 b" 时登记
// (fname, a 的形参位, b 的形参位)，被调函数 lowering 前据此把容量播种到形参槽。
// 依赖 LLVM 内联消函数边界：证明在 callee 局部 slot 上进行，靠调用点把 caller
// 侧建立的容量事实（sieve 的 flags 容量==size 即此类）带进 callee 形参槽。
let mir_xc_fn: array<string> = [];
let mir_xc_arr: array<int> = [];
let mir_xc_src: array<int> = [];
let mir_xc_used: int = 0;
let mir_pi_dbg: int = 0;

// main.shadow 两遍 lowering 据此判断是否需要 pass2（跨文件读非 pub 全局的桥）
pub kimo mir_xc_used_check() -> int { return mir_xc_used; }

kimo mir_vmin_unknown() -> int { return -1000000000; }

// 求 HIR 表达式的保守最小下界；无法建模返回未知哨兵。
kimo mir_vmin_hir(h: HirExpr) -> int {
    if ((h as any) == 0) { return mir_vmin_unknown(); }
    let k = h.kind;
    if (k == EXPR_INT) { return h.intval as int; }
    if (k == EXPR_VAR) {
        let s = h.slot;
        if (s >= 0 && s < len(mir_vmin_known) && mir_vmin_known[s] == 1) { return mir_vmin[s]; }
        return mir_vmin_unknown();
    }
    if (k == EXPR_BINARY) {
        let op = h.op;
        let ch = h.children;
        if (len(ch) == 2 && (op == BIN_ADD || op == BIN_MUL)) {
            let a = mir_vmin_hir(ch[0]);
            let b = mir_vmin_hir(ch[1]);
            if (a == mir_vmin_unknown() || b == mir_vmin_unknown()) { return mir_vmin_unknown(); }
            if (op == BIN_ADD) { return a + b; }
            if (a >= 0 && b >= 0) { return a * b; }
            return mir_vmin_unknown();
        }
    }
    return mir_vmin_unknown();
}

kimo mir_vmin_set(slot: int, rhs_h: HirExpr) -> void {
    if (slot >= 0 && slot < len(mir_vmin_known)) {
        let v = mir_vmin_hir(rhs_h);
        if (v != mir_vmin_unknown()) { mir_vmin_known[slot] = 1; mir_vmin[slot] = v; }
        else { mir_vmin_known[slot] = 0; }
    }
}

// 容量事实：cap(arr_slot) == src_slot 的当前值（要求 src 只写一次，否则其值可能已变）。
kimo mir_cap_set(arr_slot: int, src_slot: int) -> void {
    if (arr_slot < 0 || arr_slot >= len(mir_cap_lb_slot)) { return; }
    if (src_slot < 0 || src_slot >= len(mir_constish)) { return; }
    if (mir_constish[src_slot] == 1) {
        mir_cap_lb_slot[arr_slot] = src_slot;
        mir_cap_lb_ok[arr_slot] = 1;
    } else {
        mir_cap_lb_ok[arr_slot] = 0;
    }
}

// 槽被复写：作废其类常量/容量来源状态，并清理所有指向它的容量事实。
kimo mir_mark_reassigned(slot: int) -> void {
    if (slot < 0 || slot >= len(mir_constish)) { return; }
    mir_constish[slot] = 0;
    if (slot < len(mir_cap_lb_ok) && mir_cap_lb_ok[slot] == 1) { mir_cap_lb_ok[slot] = 0; }
    let i = 0;
    while (i < len(mir_cap_lb_slot)) {
        if (mir_cap_lb_ok[i] == 1 && mir_cap_lb_slot[i] == slot) { mir_cap_lb_ok[i] = 0; }
        i = i + 1;
    }
}

// 循环界帧入栈/出栈。push 复用已被 pop 腾出的槽位，避免数组无限增长。
kimo mir_lf_push(cv_slot: int, bound_slot: int, bval: int, inc: int) -> void {
    let cvmin = mir_vmin_unknown();
    if (cv_slot >= 0 && cv_slot < len(mir_vmin_known) && mir_vmin_known[cv_slot] == 1) {
        cvmin = mir_vmin[cv_slot];
    }
    if (mir_lf_n < len(mir_lf_slot)) {
        mir_lf_slot[mir_lf_n] = cv_slot;
        mir_lf_bound[mir_lf_n] = bound_slot;
        mir_lf_bval[mir_lf_n] = bval;
        mir_lf_inc[mir_lf_n] = inc;
        mir_lf_mono[mir_lf_n] = 1;
        mir_lf_cvmin[mir_lf_n] = cvmin;
    } else {
        mir_lf_slot = array_push(mir_lf_slot, cv_slot);
        mir_lf_bound = array_push(mir_lf_bound, bound_slot);
        mir_lf_bval = array_push(mir_lf_bval, bval);
        mir_lf_inc = array_push(mir_lf_inc, inc);
        mir_lf_mono = array_push(mir_lf_mono, 1);
        mir_lf_cvmin = array_push(mir_lf_cvmin, cvmin);
    }
    mir_lf_n = mir_lf_n + 1;
}

kimo mir_lf_pop() -> void {
    if (mir_lf_n > 0) { mir_lf_n = mir_lf_n - 1; }
}

// 循环体内对计数变量 cv 的所有赋值是否单调不减（只允许 cv = cv + rhs，rhs 下界>=0；
// 或 cv = cv * rhs，两者>0）。递归进 if/block。任何别的赋值 → 不单调。
kimo mir_loop_cv_monotone(cv_slot: int, stmts: array<HirStmt>) -> int {
    let i = 0;
    while (i < len(stmts)) {
        let st = stmts[i];
        let k = st.kind;
        if (k == STMT_ASSIGN && (st.child as any) != 0 && (st.rhs as any) != 0) {
            let lhs = st.child;
            let rhs = st.rhs;
            if (lhs.kind == EXPR_VAR && lhs.slot == cv_slot) {
                if (rhs.kind == EXPR_BINARY && (rhs.op == BIN_ADD || rhs.op == BIN_MUL)) {
                    let ch = rhs.children;
                    if (len(ch) == 2 && ch[0].kind == EXPR_VAR && ch[0].slot == cv_slot) {
                        let ov = mir_vmin_hir(ch[1]);
                        if (ov == mir_vmin_unknown()) { return 0; }
                        if (rhs.op == BIN_ADD) {
                            if (ov < 0) { return 0; }
                        } else {
                            // cv = cv * rhs：需 rhs>=1 且 cv>=0 才单调不减
                            if (ov < 1) { return 0; }
                            if (cv_slot >= len(mir_vmin_known) || mir_vmin_known[cv_slot] != 1 ||
                                mir_vmin[cv_slot] < 0) { return 0; }
                        }
                    } else { return 0; }
                } else { return 0; }
            }
        } else if (k == STMT_BLOCK) {
            if (mir_loop_cv_monotone(cv_slot, st.body) == 0) { return 0; }
        } else if (k == STMT_IF) {
            if (mir_loop_cv_monotone(cv_slot, st.body) == 0) { return 0; }
            if (mir_loop_cv_monotone(cv_slot, st.else_body) == 0) { return 0; }
        } else if (k == STMT_WHILE || k == STMT_FOR) {
            // 嵌套循环体内对 cv 的赋值也必须单调（否则外层界证明不安全）：继续递归
            if (mir_loop_cv_monotone(cv_slot, st.body) == 0) { return 0; }
        } else if (k == STMT_MATCH) {
            let blocks = st.arm_blocks;
            let b = 0;
            while (b < len(blocks)) {
                if (mir_loop_cv_monotone(cv_slot, blocks[b].stmts) == 0) { return 0; }
                b = b + 1;
            }
        }
        i = i + 1;
    }
    return 1;
}

// 核心证明器：能否证 `0 <= idx_hir < cap(base_hir)`。
// 仅在最简单的形状（base=变量；idx=变量 或 变量-常量C）上工作。
kimo mir_prove_in_bounds(base_h: HirExpr, idx_h: HirExpr) -> int {
    if ((base_h as any) == 0 || base_h.kind != EXPR_VAR) { return 0; }
    if ((idx_h as any) == 0) { return 0; }
    let base_slot = base_h.slot;
    if (base_slot < 0 || base_slot >= len(mir_cap_lb_ok) || mir_cap_lb_ok[base_slot] != 1) { if (mir_pi_dbg == 1) { println("PI fail base cap base_slot=" + int_to_str(base_slot)); } return 0; }
    // 解析 idx = cv - C。
    let cv_slot = -1;
    let Cc = 0;
    let ik = idx_h.kind;
    if (ik == EXPR_VAR) { cv_slot = idx_h.slot; Cc = 0; }
    else if (ik == EXPR_BINARY && idx_h.op == BIN_SUB) {
        let ch = idx_h.children;
        if (len(ch) == 2 && ch[0].kind == EXPR_VAR && ch[1].kind == EXPR_INT) {
            cv_slot = ch[0].slot; Cc = ch[1].intval as int;
        } else { if (mir_pi_dbg == 1) { println("PI fail idxshape"); } return 0; }
        if (Cc < 0) { if (mir_pi_dbg == 1) { println("PI fail Cc<0"); } return 0; }
    } else { if (mir_pi_dbg == 1) { println("PI fail idxkind"); } return 0; }
    // 找含该计数变量的最内层循环帧。
    let f = -1;
    let j = mir_lf_n - 1;
    while (j >= 0) {
        if (mir_lf_slot[j] == cv_slot) { f = j; j = -1; }
        else { j = j - 1; }
    }
    if (f < 0) { if (mir_pi_dbg == 1) { println("PI fail noframe cv_slot=" + int_to_str(cv_slot)); } return 0; }
    if (mir_lf_mono[f] != 1) { if (mir_pi_dbg == 1) { println("PI fail nmono"); } return 0; }
    // 上界：cap(base) == 帧的上界值。
    let cap_src = mir_cap_lb_slot[base_slot];
    let do_upper = 0;
    if (mir_lf_bound[f] >= 0 && mir_lf_bound[f] == cap_src) { do_upper = 1; }
    if (do_upper == 0) { if (mir_pi_dbg == 1) { println("PI fail bound slot=" + int_to_str(base_slot) + " cap_src=" + int_to_str(cap_src) + " bound=" + int_to_str(mir_lf_bound[f])); } return 0; }
    if (mir_lf_inc[f] == 1 && Cc == 0) { if (mir_pi_dbg == 1) { println("PI fail inc0"); } return 0; }
    let cmin = mir_lf_cvmin[f];
    if (cmin == mir_vmin_unknown() || cmin < Cc) { if (mir_pi_dbg == 1) { println("PI fail cmin cmin=" + int_to_str(cmin) + " Cc=" + int_to_str(Cc)); } return 0; }
    if (mir_pi_dbg == 1) { println("PI OK base=" + int_to_str(base_slot) + " cv=" + int_to_str(cv_slot) + " Cc=" + int_to_str(Cc)); }
    return 1;
}

// 登记跨函数容量事实：fname 的第 arr_pos 个形参数组，其容量 == 第 src_pos 个形参的值。
// 去重（同一函数同一位置登记一次即可）。
kimo mir_xc_record(fname: string, arr_pos: int, src_pos: int) -> void {
    let i = 0;
    while (i < len(mir_xc_fn)) {
        if (str_eq(mir_xc_fn[i], fname) == 1 && mir_xc_arr[i] == arr_pos &&
            mir_xc_src[i] == src_pos) { return; }
        i = i + 1;
    }
    mir_xc_fn = array_push(mir_xc_fn, fname);
    mir_xc_arr = array_push(mir_xc_arr, arr_pos);
    mir_xc_src = array_push(mir_xc_src, src_pos);
    mir_xc_used = 1;
}

// 普通调用点：若某实参是变量且容量事实对应本调用另一实参（cap(a)==另一实参值），登记。
// 只在被调侧播种（callee 形参槽）时兑现；对 array_push 等内建函数登记后会被播种侧过滤掉。
kimo mir_xc_collect(fname: string, args: array<HirExpr>) -> void {
    let i = 0;
    while (i < len(args)) {
        let a = args[i];
        if (a.kind == EXPR_VAR && a.slot >= 0 && a.slot < len(mir_cap_lb_ok) &&
            mir_cap_lb_ok[a.slot] == 1) {
            let src = mir_cap_lb_slot[a.slot];
            let j = 0;
            let found = 0;
            while (j < len(args)) {
                let b = args[j];
                if (j != i && b.kind == EXPR_VAR && b.slot == src) { found = 1; break; }
                j = j + 1;
            }
            if (found == 1) { if (mir_pi_dbg == 1) { println("PI collect " + fname + " arr=" + int_to_str(i) + " src=" + int_to_str(j)); } mir_xc_record(fname, i, j); }
        }
        i = i + 1;
    }
}

// 被调函数入口：形参由调用点赋一次值，视为类常量；再按登记表把容量播种到数组形参槽。
kimo mir_xc_seed_params(hf: HirFunc) -> void {
    if (mir_pi_dbg == 1) { println("PI seedfn " + hf.name + " reg=" + int_to_str(len(mir_xc_fn))); }
    let params = hf.params;
    let j = 0;
    while (j < len(params)) {
        let pslot = params[j].slot;
        if (pslot >= 0 && pslot < len(mir_constish)) { mir_constish[pslot] = 1; }
        j = j + 1;
    }
    let i = 0;
    while (i < len(mir_xc_fn)) {
        if (str_eq(mir_xc_fn[i], hf.name) == 1) {
            let ap = mir_xc_arr[i];
            let sp = mir_xc_src[i];
            if (ap >= 0 && ap < len(params) && sp >= 0 && sp < len(params)) {
                if (mir_pi_dbg == 1) { println("PI seed " + hf.name + " arr=" + int_to_str(ap) + " src=" + int_to_str(sp)); }
                mir_cap_set(params[ap].slot, params[sp].slot);
            }
        }
        i = i + 1;
    }
}

// === 填充循环计数存储强度削减（v10_s18）===
// 适用形状（循环体除下列语句外不得有任何别的东西）：
//     let a: array<T> = [];                        // mir_empty_is(a)=1
//     while (i < n) { a = array_push(a, v); i = i + 1; }
// 预分配把 cap 一次给够，于是每次 push 都是"load len → 判容量 → 写 data[len] →
// store len+1"：len 既是索引又是被更新的状态，构成一条**经过堆的** loop-carried 依赖，
// 每元素至少一次 store→load 转发延迟（实测 sieve 填充环 1.94ns/元素），且 LLVM 无法
// 向量化。改成用归纳变量当下标 `a[i-base] = v`、把 len 的写入挪到循环出口一次，循环体
// 就只剩"一条存储 + 计数器自增"，与 Go 的 make+下标填充同形，可向量化。
//
// 上下文：mir_lower_stmt 处理 STMT_ASSIGN 时查 mir_sred_n；0 表示当前循环体不适用。
let mir_sred_n: int = 0;
let mir_sred_slots: array<int> = [];      // 目标数组槽
let mir_sred_adj: array<int> = [];        // 与 slots 同序：0=该 append 在 i=i+1 之前，1=之后
                                          // （下标要减掉本轮已发生的自增，否则整体错 1 → 越过 cap）
let mir_sred_arr_h: array<HirExpr> = [];  // 每个目标的 a（EXPR_VAR），出口修 len 时复用
let mir_sred_i_h: HirExpr = 0 as HirExpr; // 循环计数器的 EXPR_VAR
let mir_sred_base_reg: int = -1;          // 进入循环时 i 的值（跨块使用：entry 支配循环体）

// 元素槽宽（与 codegen cg_elem_size 同式）：4 字节标量数据区不含指针。
kimo mir_sred_elem4(e_ty: Type) -> int {
    if ((e_ty as any) == 0) { return 0; }
    let ek = e_ty.kind;
    if (ek == TYPE_INT || ek == TYPE_CHAR || ek == TYPE_SHORT || ek == TYPE_BOOL ||
        ek == TYPE_ENUM || ek == TYPE_DATE) { return 1; }
    return 0;
}

// 值表达式是否"纯读、不分配、不逃逸"。数组/结构体字面量、new、闭包、调用都会分配，
// 而**一次分配就是一个安全点**：collect 可能落在 len 还未补的窗口里。放行叶子与
// 二元/一元/索引/成员/转换（只读内存，与逐个 push 时的求值顺序一致）。
kimo mir_sred_pure(h: HirExpr) -> int {
    if ((h as any) == 0) { return 0; }
    let k = h.kind;
    if (k == EXPR_INT || k == EXPR_LONG || k == EXPR_FLOAT || k == EXPR_BOOL ||
        k == EXPR_STRING || k == EXPR_NULL || k == EXPR_VAR) { return 1; }
    if (k == EXPR_BINARY || k == EXPR_UNARY || k == EXPR_INDEX || k == EXPR_MEMBER ||
        k == EXPR_CAST) {
        let ch = h.children;
        let i = 0;
        while (i < len(ch)) {
            if (mir_sred_pure(ch[i]) == 0) { return 0; }
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

// 值表达式是否读了某个目标数组槽。削减后 len 要到循环出口才补上，体内按 len 读 a
// （a[0]、len(a) 等）与逐元素 push 时不同 —— push 后上一轮写入的元素已可见。命中即拒。
kimo mir_sred_reads_slot(h: HirExpr, slots: array<int>) -> int {
    if ((h as any) == 0) { return 0; }
    if (h.kind == EXPR_VAR) {
        let k = 0;
        while (k < len(slots)) {
            if (h.slot == slots[k]) { return 1; }
            k = k + 1;
        }
        return 0;
    }
    let ch = h.children;
    let i = 0;
    while (i < len(ch)) {
        if (mir_sred_reads_slot(ch[i], slots) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// 体内每条语句都必须是"某个目标的 append"或"i = i + 1"，且各出现一次。
// 多出来的语句一律拒：break/continue/return/try/throw 会破坏"push 次数 == 迭代次数"
// 或绕过出口修复；对 i/界变量的额外赋值会让下标越出 cap（那是堆写坏，不是慢）。
kimo mir_sred_body_ok(body: array<HirStmt>, slots: array<int>, i_slot: int) -> int {
    let need = len(slots);
    let got: array<int> = [];
    let gi = 0;
    while (gi < need) {
        got = array_push(got, 0);
        gi = gi + 1;
    }
    let seen_inc = 0;
    let i = 0;
    while (i < len(body)) {
        let st = body[i];
        if (st.kind != STMT_ASSIGN) { return 0; }
        let lhs = st.child;
        let rhs = st.rhs;
        if ((lhs as any) == 0 || (rhs as any) == 0 || lhs.kind != EXPR_VAR) { return 0; }
        if (rhs.kind == EXPR_BINARY && rhs.op == BIN_ADD) {
            if (seen_inc == 1 || lhs.slot != i_slot) { return 0; }
            let rc = rhs.children;
            if (len(rc) != 2) { return 0; }
            if (rc[0].kind != EXPR_VAR || rc[0].slot != i_slot) { return 0; }
            if (rc[1].kind != EXPR_INT || rc[1].intval != 1) { return 0; }
            seen_inc = 1;
            i = i + 1;
            continue;
        }
        if (rhs.kind == EXPR_CALL && str_eq(rhs.str1, "array_push") == 1) {
            let args = rhs.children;
            if (len(args) != 2) { return 0; }
            if (args[0].kind != EXPR_VAR || args[0].slot != lhs.slot) { return 0; }
            if (mir_sred_pure(args[1]) == 0) { return 0; }
            if (mir_sred_reads_slot(args[1], slots) == 1) { return 0; }
            // es 必须是 4：指针型数据区里"已写但 len 未补"的元素在 GC 扫描范围外，
            // 会被当成不可达而回收。
            let aty = args[0].inferred_type;
            if ((aty as any) == 0 || mir_sred_elem4(aty.elem_type) == 0) { return 0; }
            let k = 0;
            let hit = -1;
            while (k < need) {
                if (slots[k] == lhs.slot) { hit = k; }
                k = k + 1;
            }
            if (hit < 0 || got[hit] == 1) { return 0; }
            got[hit] = 1;
            // 体内遇到目标的次序必须与 slots 的收集次序一致，否则下面两份并行数组会
            // 错位（出口把 len 补到另一个数组上）。不一致就直接拒。
            if (len(mir_sred_arr_h) != hit) { return 0; }
            // 记下 a 的 EXPR_VAR：出口处还要按同样的类型读它
            mir_sred_arr_h = array_push(mir_sred_arr_h, args[0]);
            mir_sred_adj = array_push(mir_sred_adj, seen_inc);
            i = i + 1;
            continue;
        }
        return 0;
    }
    if (seen_inc != 1) { return 0; }
    let j = 0;
    while (j < need) {
        if (got[j] != 1) { return 0; }
        j = j + 1;
    }
    return 1;
}

// 能否把这个类型安全地拓宽成 long（i64）？拓宽用于把"循环写入数"放到 64 位里算，
// 所以必须是宽度确定的整型；类型缺失的一律拒（宁可不优化，也不能拿未知宽度当 64 位用）。
kimo mir_sred_widen_ty_ok(ty: Type) -> int {
    if ((ty as any) == 0) { return 0; }
    let k = ty.kind;
    if (k == TYPE_LONG || k == TYPE_INT || k == TYPE_CHAR || k == TYPE_SHORT ||
        k == TYPE_BOOL || k == TYPE_ENUM || k == TYPE_DATE) { return 1; }
    return 0;
}

// 发一条拓宽到 long 的转换；已是 TYPE_LONG 就原样返回。调用方必须先用
// mir_sred_widen_ty_ok 验过类型，否则这里可能发出 sext i64→i64 这类畸形指令。
kimo mir_sred_widen(r: int, ty: Type) -> int {
    if (ty.kind == TYPE_LONG) { return r; }
    let r2 = mir_new_reg();
    let cv = mir_mk(MIR_CAST);
    cv.dst = r2;
    cv.arg1 = r;
    cv.ty = mk_type(TYPE_LONG);
    mir_emit(cv);
    return r2;
}

// 判定 + 建上下文 + 把预分配容量改准为 n - base。返回 -1 表示不适用；否则返回装
// "实际元素数"的寄存器 id（>0），调用方用它作为预分配容量。
// 容量必须按"实际写入次数"给：base>0 时迭代数 = n - base < n，而按下标写 data 时
// 一旦越过 cap 就是堆越界写（原先走 push 则由运行时自动扩容，所以 cap=n 只是浪费）。
kimo mir_sred_begin(cond: HirExpr, body: array<HirStmt>, slots: array<int>,
                    n_reg: int) -> int {
    if (mir_sred_n != 0) { return -1; }
    if (len(slots) == 0) { return -1; }
    if ((cond as any) == 0 || cond.kind != EXPR_BINARY || cond.op != BIN_LT) { return -1; }
    let bch = cond.children;
    if (len(bch) != 2 || bch[0].kind != EXPR_VAR) { return -1; }
    let i_h = bch[0];
    let ity = i_h.inferred_type;
    if ((ity as any) == 0) { return -1; }
    // 下标只认 int/long：codegen 的直接 GEP 也仅此两者启用，其它类型会退回运行时
    // set，而运行时 set 对"index >= cap"的写入是丢弃的 —— 静默少写元素。
    if (ity.kind != TYPE_INT && ity.kind != TYPE_LONG) { return -1; }
    // 界变量的类型必须能安全拓宽到 long（容量要在 64 位里算，见下）。验不出来就
    // 在这里放弃削减，且此刻还没发任何指令，回退是干净的。
    let nty = bch[1].inferred_type;
    if (mir_sred_widen_ty_ok(nty) == 0) { return -1; }
    let si = 0;
    while (si < len(slots)) {
        let s0 = slots[si];
        if (mir_empty_is(s0) == 0) { return -1; }
        si = si + 1;
    }
    mir_sred_arr_h = [];
    mir_sred_adj = [];
    if (mir_sred_body_ok(body, slots, i_h.slot) == 0) { return -1; }
    mir_sred_i_h = i_h;
    mir_sred_base_reg = mir_lower_expr(i_h);
    // 迭代数 = n - base 必须在 64 位里算：int32 会回绕（base=-15 亿、n=12 亿 → 真值
    // 27 亿回绕成负），而负容量被运行时夹成 0，于是削减出来的无护栏直写全部落在
    // 12 字节对象之外 —— 那是成片堆越界写，GC 只看见一个小对象，绝查不出来。
    let cnt = mir_new_reg();
    let n_w = mir_sred_widen(n_reg, nty);
    let base_w = mir_sred_widen(mir_sred_base_reg, ity);
    let sb = mir_mk(MIR_BINOP);
    sb.dst = cnt;
    sb.arg1 = n_w;
    sb.arg2 = base_w;
    sb.longval = BIN_SUB;
    sb.ty = mk_type(TYPE_LONG);
    mir_emit(sb);
    mir_sred_slots = slots;
    mir_sred_n = len(slots);
    return cnt;
}

// 循环出口：把每个目标的 len 补成实际写入的元素数，并关闭上下文。
kimo mir_sred_finish() -> void {
    if (mir_sred_n == 0) { return; }
    let i_r = mir_lower_expr(mir_sred_i_h);
    let cnt = mir_new_reg();
    let sb = mir_mk(MIR_BINOP);
    sb.dst = cnt;
    sb.arg1 = i_r;
    sb.arg2 = mir_sred_base_reg;
    sb.longval = BIN_SUB;
    sb.ty = mir_sred_i_h.inferred_type;
    mir_emit(sb);
    let k = 0;
    while (k < mir_sred_n) {
        let a_r = mir_lower_expr(mir_sred_arr_h[k]);
        let r = mir_new_reg();
        let call = mir_mk(MIR_CALL);
        call.dst = r;
        call.strval = "shadow_array_set_len";
        call.ty = mir_sred_arr_h[k].inferred_type;
        call.args = array_push([], a_r);
        call.args = array_push(call.args, cnt);
        mir_emit(call);
        k = k + 1;
    }
    mir_sred_n = 0;
    mir_sred_slots = [];
    mir_sred_adj = [];
    mir_sred_arr_h = [];
    mir_sred_i_h = 0 as HirExpr;
    mir_sred_base_reg = -1;
    return;
}

// STMT_ASSIGN 钩子：命中则发 a[(i-base)] = v 并返回 1（调用方据此跳过常规 push lowering
// 与槽回写 —— 数组对象自始至终没换）。
kimo mir_sred_try_store(lhs_slot: int, call_h: HirExpr) -> int {
    if (mir_sred_n == 0) { return 0; }
    let hit = -1;
    let k = 0;
    while (k < mir_sred_n) {
        if (mir_sred_slots[k] == lhs_slot) { hit = k; }
        k = k + 1;
    }
    if (hit < 0) { return 0; }
    let args = call_h.children;
    if (len(args) != 2) { return 0; }
    if (args[0].kind != EXPR_VAR || args[0].slot != lhs_slot) { return 0; }
    let v_reg = mir_lower_expr(args[1]);
    let a_r = mir_lower_expr(args[0]);
    let i_r = mir_lower_expr(mir_sred_i_h);
    let idx = mir_new_reg();
    let sub = mir_mk(MIR_BINOP);
    sub.dst = idx;
    sub.arg1 = i_r;
    sub.arg2 = mir_sred_base_reg;
    sub.longval = BIN_SUB;
    sub.ty = mir_sred_i_h.inferred_type;
    mir_emit(sub);
    // 该 append 写在 i = i + 1 之后 → 本轮 i 已自增，下标要再减 1，否则整体错 1，
    // 且最后一次迭代写到 cap 之外（堆越界）。
    if (mir_sred_adj[hit] == 1) {
        let one = mir_new_reg();
        let ci = mir_mk(MIR_CONST_INT);
        ci.dst = one;
        ci.longval = 1;
        ci.ty = mk_type(TYPE_INT);
        mir_emit(ci);
        let idx2 = mir_new_reg();
        let sub2 = mir_mk(MIR_BINOP);
        sub2.dst = idx2;
        sub2.arg1 = idx;
        sub2.arg2 = one;
        sub2.longval = BIN_SUB;
        sub2.ty = mir_sred_i_h.inferred_type;
        mir_emit(sub2);
        idx = idx2;
    }
    let st = mir_mk(MIR_STORE_INDEX);
    st.arg1 = a_r;
    st.arg2 = idx;
    st.ty = args[0].inferred_type.elem_type;
    st.args = array_push([], v_reg);
    // longval=1 告诉 codegen"这条下标恒在界内，免运行时护栏"。依据是四条合起来：
    //   1) 预分配容量按 64 位精确算出（mir_sred_begin），要么给足要么 panic，所以
    //      对象头里的 cap 就是物理容量（runtime 侧同一约束）；
    //   2) 界是变量或字面量，且 mir_sred_body_ok 要求体内每条语句只能是目标的
    //      append 或那次 i += 1 —— 界与下标在体内都不可能被动到；
    //   3) 计数器从 base 起单调 +1，故 i - base 从 0 逐一到迭代数-1，且迭代数 ≤ 2^31
    //      （否则第 1 条已经 panic），下标在 int32 里不会回绕；
    //   4) adj 那条分支把"先自增后 append"的下标再减 1，取值区间与不调整时一致。
    // 任何一条以后被放宽，这里就必须改成 0（护栏回来），否则分析出错会直接变成堆写坏。
    st.longval = 1;
    mir_emit(st);
    return 1;
}

// 循环体别名扫描（只读，不改 mir_owned）：找出体内会被共享的 slot。
// 表达式层别名仅来自函数调用实参（callee 可能保留）与闭包捕获。
pub kimo mir_scan_aliases_expr(h: HirExpr, aliased: array<int>) -> void {
    if ((h as any) == 0) { return; }
    let k = h.kind;
    if (k == EXPR_VAR) { return; }
    if (k == EXPR_CALL) {
        let args = h.children;
        let i = 0;
        while (i < len(args)) {
            let a = args[i];
            if (a.kind == EXPR_VAR) {
                if (a.slot >= 0 && a.slot < len(aliased)) { aliased[a.slot] = 1; }
            }
            mir_scan_aliases_expr(a, aliased);
            i = i + 1;
        }
        return;
    }
    if (k == EXPR_CLOSURE) {
        let children = h.children;
        let i = 0;
        while (i < len(children)) {
            let c = children[i];
            if (c.kind == EXPR_VAR) {
                if (c.slot >= 0 && c.slot < len(aliased)) { aliased[c.slot] = 1; }
            }
            mir_scan_aliases_expr(c, aliased);
            i = i + 1;
        }
        return;
    }
    let children = h.children;
    let i = 0;
    while (i < len(children)) {
        mir_scan_aliases_expr(children[i], aliased);
        i = i + 1;
    }
}

pub kimo mir_scan_aliases_stmt(h: HirStmt, aliased: array<int>) -> void {
    if ((h as any) == 0) { return; }
    let k = h.kind;
    if (k == STMT_LET) {
        if ((h.child as any) != 0) {
            let c = h.child;
            if (c.kind == EXPR_VAR) {
                if (c.slot >= 0 && c.slot < len(aliased)) { aliased[c.slot] = 1; }
            }
            mir_scan_aliases_expr(c, aliased);
        }
        return;
    }
    if (k == STMT_ASSIGN) {
        let lhs = h.child;
        let rhs = h.rhs;
        if (lhs.kind == EXPR_INDEX || lhs.kind == EXPR_MEMBER) {
            if ((rhs as any) != 0 && rhs.kind == EXPR_VAR) {
                if (rhs.slot >= 0 && rhs.slot < len(aliased)) { aliased[rhs.slot] = 1; }
            }
        }
        if ((rhs as any) != 0) { mir_scan_aliases_expr(rhs, aliased); }
        mir_scan_aliases_expr(lhs, aliased);
        return;
    }
    if (k == STMT_EXPR) {
        if ((h.child as any) != 0) { mir_scan_aliases_expr(h.child, aliased); }
        return;
    }
    if (k == STMT_RETURN) {
        if ((h.child as any) != 0) { mir_scan_aliases_expr(h.child, aliased); }
        return;
    }
    if (k == STMT_IF) {
        if ((h.child as any) != 0) { mir_scan_aliases_expr(h.child, aliased); }
        let tb = h.body;
        let i = 0;
        while (i < len(tb)) { mir_scan_aliases_stmt(tb[i], aliased); i = i + 1; }
        let eb = h.else_body;
        let j = 0;
        while (j < len(eb)) { mir_scan_aliases_stmt(eb[j], aliased); j = j + 1; }
        return;
    }
    if (k == STMT_WHILE) {
        if ((h.child as any) != 0) { mir_scan_aliases_expr(h.child, aliased); }
        let wb = h.body;
        let i = 0;
        while (i < len(wb)) { mir_scan_aliases_stmt(wb[i], aliased); i = i + 1; }
        return;
    }
    if (k == STMT_FOR) {
        if ((h.child as any) != 0) { mir_scan_aliases_expr(h.child, aliased); }
        let fb = h.body;
        let i = 0;
        while (i < len(fb)) { mir_scan_aliases_stmt(fb[i], aliased); i = i + 1; }
        return;
    }
    if (k == STMT_BLOCK) {
        let bb = h.body;
        let i = 0;
        while (i < len(bb)) { mir_scan_aliases_stmt(bb[i], aliased); i = i + 1; }
        return;
    }
    if (k == STMT_MATCH) {
        if ((h.child as any) != 0) { mir_scan_aliases_expr(h.child, aliased); }
        let blocks = h.arm_blocks;
        let i = 0;
        while (i < len(blocks)) {
            let blk = blocks[i];
            let j = 0;
            while (j < len(blk.stmts)) { mir_scan_aliases_stmt(blk.stmts[j], aliased); j = j + 1; }
            i = i + 1;
        }
        return;
    }
}

// 循环入口：扫描体内别名操作，清除对应 slot 所有权（跨迭代共享）
pub kimo mir_clear_loop_aliases(body: array<HirStmt>) -> void {
    let aliased: array<int> = [];
    let ai = 0;
    while (ai < mir_n_slots) {
        aliased = array_push(aliased, 0);
        ai = ai + 1;
    }
    let i = 0;
    while (i < len(body)) {
        mir_scan_aliases_stmt(body[i], aliased);
        i = i + 1;
    }
    let j = 0;
    while (j < mir_n_slots) {
        if (aliased[j] == 1) { mir_owned_clear(j); }
        j = j + 1;
    }
}

// 检查是否已有终止符
pub kimo mir_has_terminator() -> int {
    if ((mir_cur_terminator as any) == 0) { return 0; }
    return 1;
}

pub kimo mir_new_reg() -> int {
    let r = mir_n_regs;
    mir_n_regs = mir_n_regs + 1;
    return r;
}

pub kimo mir_new_label() -> string {
    let l = "bb" + int_to_str(mir_label_counter);
    mir_label_counter = mir_label_counter + 1;
    return l;
}

pub kimo mir_mk(op: int) -> MirInst {
    let i = MirInst { op: op, line: mir_cur_line, ty: 0 as Type, dst: -1, arg1: -1, arg2: -1,
                      longval: 0, floatval: 0.0, strval: "", strval2: "", args: [] };
    return i;
}

pub kimo mir_type_of_hir_expr(h: HirExpr) -> Type {
    return h.inferred_type;
}

// array_push 调用：返回第一个实参的数组类型（保留 elem_type），供 codegen 分派 typed push。
// 独立小函数：避免 mir_lower_expr 过大触发旧宿主 slot 上限致自举产物崩溃。
// 注意：a0 是 HirExpr（HIR 已把 Expr 迁移为 HirExpr），绝不能按 Expr 布局读取——
// 两结构体字段偏移不同，强转会读到垃圾内存致 typed push 分派失效。
pub kimo mir_array_push_ty(a0: HirExpr, fallback: Type) -> Type {
    let a0ty = a0.inferred_type;
    if ((a0ty as any) != 0 && a0ty.kind == TYPE_ARRAY) {
        return a0ty;
    }
    return fallback;
}

// 封存当前块，开始新块
pub kimo mir_seal_and_begin(new_label: string) -> void {
    let blk = MirBlock { label: mir_cur_label, insts: mir_cur_insts, terminator: mir_cur_terminator };
    mir_blocks = array_push(mir_blocks, blk);
    mir_cur_label = new_label;
    mir_cur_insts = [];
    mir_cur_terminator = 0 as MirInst;
}

// 仅封存当前块（用于函数末尾）
pub kimo mir_seal_last() -> void {
    let blk = MirBlock { label: mir_cur_label, insts: mir_cur_insts, terminator: mir_cur_terminator };
    mir_blocks = array_push(mir_blocks, blk);
    mir_cur_insts = [];
    mir_cur_terminator = 0 as MirInst;
}

// 发射指令（当前块已有终止符则丢弃不可达代码）
pub kimo mir_emit(inst: MirInst) -> void {
    if (mir_has_terminator() == 1) { return; }
    mir_cur_insts = array_push(mir_cur_insts, inst);
}

// 设置终止符
pub kimo mir_set_term(inst: MirInst) -> void {
    if (mir_has_terminator() == 1) { return; }
    mir_cur_terminator = inst;
}

// 无条件跳转（便捷封装）
pub kimo mir_emit_br(target: string) -> void {
    let br = mir_mk(MIR_BR);
    br.strval = target;
    mir_set_term(br);
}

// 推入/弹出 loop 上下文
pub kimo mir_push_loop(brk: string, cont: string) -> void {
    mir_loop_break_labels = array_push(mir_loop_break_labels, brk);
    mir_loop_continue_labels = array_push(mir_loop_continue_labels, cont);
}

pub kimo mir_pop_loop() -> void {
    let n = len(mir_loop_break_labels);
    let new_brk: array<string> = [];
    let new_cont: array<string> = [];
    let i = 0;
    while (i < n - 1) {
        new_brk = array_push(new_brk, mir_loop_break_labels[i]);
        new_cont = array_push(new_cont, mir_loop_continue_labels[i]);
        i = i + 1;
    }
    mir_loop_break_labels = new_brk;
    mir_loop_continue_labels = new_cont;
}

// --- 表达式 lowering：返回结果寄存器编号 ---
pub kimo mir_lower_expr(h: HirExpr) -> int {
    let k = h.kind;

    if (k == EXPR_INT || k == EXPR_LONG || k == EXPR_BOOL) {
        let r = mir_new_reg();
        let inst = mir_mk(MIR_CONST_INT);
        inst.dst = r;
        // ⚠️ long 常量不可 cast int（截断）：1000000000000L 会溢出。longval 字段是 long（64 位），直接存。
        inst.longval = h.intval;
        inst.ty = h.inferred_type;
        // 兜底：inferred_type 未填（缓存跳过 TC 的字面量）→ int，避免 cg 生成 i0 非法类型。
        if ((inst.ty as any) == 0) {
            if (k == EXPR_LONG) { inst.ty = mk_type(TYPE_LONG); }
            else { inst.ty = mk_type(TYPE_INT); }
        }
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_FLOAT) {
        let r = mir_new_reg();
        let inst = mir_mk(MIR_CONST_FLOAT);
        inst.dst = r;
        inst.floatval = h.floatval;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_STRING) {
        let r = mir_new_reg();
        let inst = mir_mk(MIR_CONST_STR);
        inst.dst = r;
        inst.strval = h.str1;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_NULL) {
        let r = mir_new_reg();
        let inst = mir_mk(MIR_CONST_NULL);
        inst.dst = r;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_VAR) {
        // 无负载 payload-enum 变体（如 None）：slot<0 且类型为 TYPE_ENUM_PAYLOAD
        // → 构造无负载 AnyBox（h.intval = 变体索引）
        let hty = h.inferred_type;
        let is_enum_ctor = 0;
        if ((hty as any) != 0) {
            if (hty.kind == TYPE_ENUM_PAYLOAD && h.slot < 0) {
                is_enum_ctor = 1;
            }
        }
        if (is_enum_ctor == 1) {
            let r = mir_new_reg();
            let inst = mir_mk(MIR_ENUM_CONSTRUCT);
            inst.dst = r;
            inst.longval = h.intval;
            inst.strval = h.str1;
            inst.args = [];
            inst.ty = hty;
            mir_emit(inst);
            return r;
        }
        let r = mir_new_reg();
        let inst = mir_mk(MIR_LOAD_VAR);
        inst.dst = r;
        inst.arg1 = h.slot;
        inst.strval = h.str1;  // 变量名，供全局引用（slot=-1）按名查找
        inst.ty = hty;
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_BINARY) {
        let children = h.children;
        // &&/|| 短路求值：去糖为 condbr 控制流
        if (h.op == BIN_AND || h.op == BIN_OR) {
            let tmp_slot = h.slot;
            let sc_ty = h.inferred_type;
            if ((sc_ty as any) == 0) { sc_ty = mk_type(TYPE_BOOL); }
            let lhs_sc = mir_lower_expr(children[0]);
            let rhs_label = mir_new_label();
            let short_label = mir_new_label();
            let merge_label = mir_new_label();

            let condbr = mir_mk(MIR_CONDBR);
            condbr.arg1 = lhs_sc;
            if (h.op == BIN_AND) {
                condbr.strval = rhs_label;
                condbr.strval2 = short_label;
            } else {
                condbr.strval = short_label;
                condbr.strval2 = rhs_label;
            }
            mir_set_term(condbr);

            // rhs 块：求值 rhs 写入结果 slot
            mir_seal_and_begin(rhs_label);
            let rhs_sc = mir_lower_expr(children[1]);
            let st_r = mir_mk(MIR_STORE_VAR);
            st_r.arg1 = rhs_sc;
            st_r.arg2 = tmp_slot;
            st_r.ty = sc_ty;
            mir_emit(st_r);
            mir_emit_br(merge_label);

            // short 块：写短路常量（&&: 0 / ||: 1）
            mir_seal_and_begin(short_label);
            let scr = mir_new_reg();
            let scc = mir_mk(MIR_CONST_INT);
            scc.dst = scr;
            scc.longval = 0;
            if (h.op == BIN_OR) { scc.longval = 1; }
            scc.ty = sc_ty;
            mir_emit(scc);
            let st_s = mir_mk(MIR_STORE_VAR);
            st_s.arg1 = scr;
            st_s.arg2 = tmp_slot;
            st_s.ty = sc_ty;
            mir_emit(st_s);
            mir_emit_br(merge_label);

            // merge 块：load 结果
            mir_seal_and_begin(merge_label);
            let r_sc = mir_new_reg();
            let ld_sc = mir_mk(MIR_LOAD_VAR);
            ld_sc.dst = r_sc;
            ld_sc.arg1 = tmp_slot;
            ld_sc.ty = sc_ty;
            mir_emit(ld_sc);
            return r_sc;
        }
        let lhs = mir_lower_expr(children[0]);
        let rhs = mir_lower_expr(children[1]);
        let r = mir_new_reg();
        let inst = mir_mk(MIR_BINOP);
        inst.dst = r;
        inst.arg1 = lhs;
        inst.arg2 = rhs;
        inst.longval = h.op;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_UNARY) {
        let children = h.children;
        let operand = mir_lower_expr(children[0]);
        let r = mir_new_reg();
        let inst = mir_mk(MIR_UNOP);
        inst.dst = r;
        inst.arg1 = operand;
        inst.longval = h.op;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    // 自增/自减 ++/--：load → ±1 → store → 返回（pre=新值 / post=旧值）
    if (k == EXPR_INCDEC) {
        let children = h.children;
        let target = children[0];
        let is_inc = (h.op as int) == 0;
        let is_pre = str_eq(h.str1, "pre") == 1;
        let tty = h.inferred_type;
        let target_kind = target.kind;
        // 目标组件只 lower 一次（load 与 store 复用，避免下标/对象重复求值）
        let arr_reg = -1;
        let idx_reg = -1;
        let obj_reg = -1;
        if (target_kind == EXPR_INDEX) {
            let tchildren = target.children;
            arr_reg = mir_lower_expr(tchildren[0]);
            idx_reg = mir_lower_expr(tchildren[1]);
        } else if (target_kind == EXPR_MEMBER) {
            let tchildren = target.children;
            obj_reg = mir_lower_expr(tchildren[0]);
        }
        let old_reg = -1;
        if (target_kind == EXPR_VAR) {
            let ld = mir_mk(MIR_LOAD_VAR);
            ld.dst = mir_new_reg();
            ld.arg1 = target.slot;
            ld.strval = target.str1;
            ld.ty = target.inferred_type;
            mir_emit(ld);
            old_reg = ld.dst;
        } else if (target_kind == EXPR_INDEX) {
            let ld = mir_mk(MIR_INDEX);
            ld.dst = mir_new_reg();
            ld.arg1 = arr_reg;
            ld.arg2 = idx_reg;
            ld.ty = target.inferred_type;
            mir_emit(ld);
            old_reg = ld.dst;
        } else if (target_kind == EXPR_MEMBER) {
            let ld = mir_mk(MIR_MEMBER);
            ld.dst = mir_new_reg();
            ld.arg1 = obj_reg;
            ld.strval = target.str1;
            ld.longval = target.intval as int;
            ld.ty = target.inferred_type;
            mir_emit(ld);
            old_reg = ld.dst;
        } else {
            let r = mir_new_reg();
            let inst = mir_mk(MIR_CONST_INT);
            inst.dst = r;
            inst.longval = 0;
            inst.ty = mk_type(TYPE_INT);
            mir_emit(inst);
            return r;
        }
        let one_reg = mir_new_reg();
        let onec = mir_mk(MIR_CONST_INT);
        onec.dst = one_reg;
        onec.longval = 1;
        onec.ty = mk_type(TYPE_INT);
        mir_emit(onec);
        let new_reg = mir_new_reg();
        let bin = mir_mk(MIR_BINOP);
        bin.dst = new_reg;
        bin.arg1 = old_reg;
        bin.arg2 = one_reg;
        if (is_inc) { bin.longval = BIN_ADD; } else { bin.longval = BIN_SUB; }
        bin.ty = tty;
        mir_emit(bin);
        if (target_kind == EXPR_VAR) {
            let st = mir_mk(MIR_STORE_VAR);
            st.arg1 = new_reg;
            st.arg2 = target.slot;
            st.ty = target.inferred_type;
            st.strval = target.str1;
            mir_emit(st);
        } else if (target_kind == EXPR_INDEX) {
            let st = mir_mk(MIR_STORE_INDEX);
            st.arg1 = arr_reg;
            st.arg2 = idx_reg;
            st.ty = target.inferred_type;  // 数组元素类型：codegen 据此决定直接 GEP 还是运行时函数
            st.args = array_push([], new_reg);
            let tch = target.children;
            st.longval = mir_prove_in_bounds(tch[0], tch[1]);
            mir_emit(st);
        } else if (target_kind == EXPR_MEMBER) {
            let st = mir_mk(MIR_STORE_MEMBER);
            st.arg1 = obj_reg;
            st.strval = target.str1;
            st.longval = target.intval as int;
            st.args = array_push([], new_reg);
            mir_emit(st);
        }
        if (is_pre) { return new_reg; }
        return old_reg;
    }

    if (k == EXPR_CALL && h.op != -1) {
        // enum 变体构造（如 Some(42)）：调用名是 enum 变体，h.intval = 变体索引
        let callee_ty = h.inferred_type;
        let is_enum_ctor = 0;
        if ((callee_ty as any) != 0) {
            let ct = callee_ty;
            if (ct.kind == TYPE_ENUM_PAYLOAD && h.op >= 0) { is_enum_ctor = 1; }
        }
        if (is_enum_ctor == 1) {
            let arg_regs: array<int> = [];
            let args = h.children;
            let i = 0;
            while (i < len(args)) {
                let ar = mir_lower_expr(args[i]);
                arg_regs = array_push(arg_regs, ar);
                // 枚举负载持有实参引用：变量缓冲被枚举共享，清除所有权
                if (args[i].kind == EXPR_VAR) { mir_owned_clear(args[i].slot); }
                i = i + 1;
            }
            let r = mir_new_reg();
            let inst = mir_mk(MIR_ENUM_CONSTRUCT);
            inst.dst = r;
            inst.longval = h.intval as int;
            inst.strval = h.str1;
            inst.args = arg_regs;
            inst.ty = callee_ty;
            mir_emit(inst);
            return r;
        }
        let arg_regs: array<int> = [];
        let args = h.children;
        // 0.5.3 dyn Trait：接收者若为 trait 对象 → vtable 运行时动态分发
        let is_dyn_call = 0;
        let dyn_trait_name = "";
        if (len(args) > 0) {
            let r_t = args[0].inferred_type;
            // 缓存命中跳过 TC 时接收者 inferred_type 可能为 null（未回填），勿解引用
            if ((r_t as any) != 0 && r_t.kind == TYPE_TRAIT_OBJECT && len(r_t.name) > 0) { is_dyn_call = 1; dyn_trait_name = r_t.name; }
        }
        // 0.5.3 dyn：该实参位置形参为 dyn Trait 且实参是本文件具体 struct → 装箱为 trait 对象
        //（TC 扁平登记：按函数名+位置查 dyn trait 名，避免持久化 array<Type> 悬垂 AV）
        let box_trait = "";
        let i = 0;
        while (i < len(args)) {
            let ar = mir_lower_expr(args[i]);
            // 传参：变量缓冲可能被 callee 保留/共享，清除所有权
            if (args[i].kind == EXPR_VAR) { mir_owned_clear(args[i].slot); }
            let need_box = 0;
            if (is_dyn_call == 0) {
                box_trait = tc_dyn_trait_at(h.str1, i);
                if (len(box_trait) > 0) { need_box = 1; }
            }
            if (need_box == 1) {
                let box_ty = mk_named_type(TYPE_TRAIT_OBJECT, box_trait);
                let mk = mir_new_reg();
                let mi = mir_mk(MIR_MAKE_TRAITOBJ);
                mi.dst = mk;
                mi.strval = box_trait;              // trait 名
                mi.strval2 = args[i].inferred_type.name; // 具体 struct 名
                mi.args = array_push([], ar);
                mi.ty = box_ty;
                mir_emit(mi);
                arg_regs = array_push(arg_regs, mk);
            } else {
                arg_regs = array_push(arg_regs, ar);
            }
            i = i + 1;
        }
        let r = mir_new_reg();
        if (is_dyn_call == 1) {
            let inst = mir_mk(MIR_CALL_DYN);
            inst.dst = r;
            inst.arg1 = arg_regs[0];          // dyn 对象（数据指针 + vtable）
            inst.strval = dyn_trait_name;     // trait 名
            inst.strval2 = h.str1;            // 方法名
            let rest_args: array<int> = [];
            let ri = 1;
            while (ri < len(arg_regs)) { rest_args = array_push(rest_args, arg_regs[ri]); ri = ri + 1; }
            inst.args = rest_args;
            inst.ty = callee_ty;              // 方法返回类型（dyn 化后）
            mir_emit(inst);
            return r;
        }
        let inst = mir_mk(MIR_CALL);
        inst.dst = r;
        inst.strval = h.str1;
        inst.args = arg_regs;
        // 跨调用容量：cap(实参 a)==另一实参 → 登记，供被调侧播种（sieve 的 flags 容量==size）
        mir_xc_collect(h.str1, args);
        // array_push：携带第一个实参的数组类型（保留 elem_type），
        // codegen 据此分派 typed push（array<int>→shadow_array_push_int），
        // 使静态类型数组以 4/8 字节槽存储，与直接 GEP 优化一致。
        if (str_eq(h.str1, "array_push") == 1 && len(args) > 0) {
            inst.ty = mir_array_push_ty(args[0], callee_ty);
        } else {
            inst.ty = callee_ty;
        }
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_CALL && h.op == -1) {
        // 闭包间接调用：h.slot = 闭包变量 slot，h.inferred_type = 闭包类型
        let closure_reg = mir_new_reg();
        let load_inst = mir_mk(MIR_LOAD_VAR);
        load_inst.dst = closure_reg;
        load_inst.arg1 = h.slot;
        load_inst.strval = h.str1;
        load_inst.ty = mk_type(TYPE_FUNCTION);
        mir_emit(load_inst);
        let arg_regs: array<int> = [];
        let args = h.children;
        let i = 0;
        while (i < len(args)) {
            let ar = mir_lower_expr(args[i]);
            arg_regs = array_push(arg_regs, ar);
            // 传参：变量缓冲可能被 callee 保留/共享，清除所有权
            if (args[i].kind == EXPR_VAR) { mir_owned_clear(args[i].slot); }
            i = i + 1;
        }
        let r = mir_new_reg();
        let inst = mir_mk(MIR_CALL_INDIRECT);
        inst.dst = r;
        inst.arg1 = closure_reg;
        inst.args = arg_regs;
        inst.ty = h.inferred_type;  // 闭包类型（captured_count/param_types/ret_type）
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_CLOSURE) {
        let cap_regs: array<int> = [];
        let children = h.children;
        let i = 0;
        while (i < len(children)) {
            let cr = mir_lower_expr(children[i]);
            cap_regs = array_push(cap_regs, cr);
            i = i + 1;
        }
        let r = mir_new_reg();
        let inst = mir_mk(MIR_MAKE_CLOSURE);
        inst.dst = r;
        inst.strval = h.str1;
        inst.args = cap_regs;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_CAST) {
        let children = h.children;
        let operand = mir_lower_expr(children[0]);
        let r = mir_new_reg();
        let inst = mir_mk(MIR_CAST);
        inst.dst = r;
        inst.arg1 = operand;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_INDEX) {
        let children = h.children;
        let arr = mir_lower_expr(children[0]);
        let idx = mir_lower_expr(children[1]);
        let r = mir_new_reg();
        let inst = mir_mk(MIR_INDEX);
        inst.dst = r;
        inst.arg1 = arr;
        inst.arg2 = idx;
        inst.ty = h.inferred_type;
        // 循环界+容量可证 0<=idx<cap → 免 OOB 护栏（codegen cg_gen_array_load_direct 读 longval）
        inst.longval = mir_prove_in_bounds(children[0], children[1]);
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_SLICE) {
        let children = h.children;
        let base = mir_lower_expr(children[0]);
        let lo = mir_lower_expr(children[1]);
        let hi = mir_lower_expr(children[2]);
        let r = mir_new_reg();
        let inst = mir_mk(MIR_SLICE);
        inst.dst = r;
        inst.arg1 = base;
        let arglist: array<int> = [];
        arglist = array_push(arglist, lo);
        arglist = array_push(arglist, hi);
        inst.args = arglist;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_MEMBER) {
        let children = h.children;
        let obj = mir_lower_expr(children[0]);
        let r = mir_new_reg();
        let inst = mir_mk(MIR_MEMBER);
        inst.dst = r;
        inst.arg1 = obj;
        inst.strval = h.str1;
        inst.longval = h.intval as int;  // 字段索引
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_ARRAY_LIT) {
        let elem_regs: array<int> = [];
        let elems = h.children;
        let i = 0;
        while (i < len(elems)) {
            let er = mir_lower_expr(elems[i]);
            elem_regs = array_push(elem_regs, er);
            i = i + 1;
        }
        let r = mir_new_reg();
        let inst = mir_mk(MIR_ARRAY_LIT);
        inst.dst = r;
        inst.args = elem_regs;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    if (k == EXPR_STRUCT_LIT) {
        let field_regs: array<int> = [];
        let fields = h.children;
        let i = 0;
        while (i < len(fields)) {
            let fr = mir_lower_expr(fields[i]);
            field_regs = array_push(field_regs, fr);
            i = i + 1;
        }
        let r = mir_new_reg();
        let inst = mir_mk(MIR_STRUCT_LIT);
        inst.dst = r;
        inst.strval = h.str1;
        inst.args = field_regs;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    // 元组字面量 — 复用 MIR_STRUCT_LIT，strval 留空（"" 表示元组）
    if (k == EXPR_TUPLE) {
        let elem_regs: array<int> = [];
        let elems = h.children;
        let i = 0;
        while (i < len(elems)) {
            let er = mir_lower_expr(elems[i]);
            elem_regs = array_push(elem_regs, er);
            i = i + 1;
        }
        let r = mir_new_reg();
        let inst = mir_mk(MIR_STRUCT_LIT);
        inst.dst = r;
        inst.strval = "";
        inst.args = elem_regs;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    // range 在非 for 上下文：防御性返回 0
    if (k == EXPR_RANGE) {
        let r = mir_new_reg();
        let zc = mir_mk(MIR_CONST_INT);
        zc.dst = r;
        zc.longval = 0;
        zc.ty = mk_type(TYPE_INT);
        mir_emit(zc);
        return r;
    }

    // spawn：nullary → TYPE_FUTURE；带参 → fn_ty（TYPE_FUNCTION）
    if (k == EXPR_SPAWN) {
        let arg_regs: array<int> = [];
        let children = h.children;
        let i = 0;
        while (i < len(children)) {
            let ar = mir_lower_expr(children[i]);
            arg_regs = array_push(arg_regs, ar);
            i = i + 1;
        }
        let r = mir_new_reg();
        let inst = mir_mk(MIR_SPAWN);
        inst.dst = r;
        inst.strval = h.str1;
        inst.args = arg_regs;
        if (len(arg_regs) > 0) {
            inst.ty = h.fn_ty;
        } else {
            inst.ty = mk_type(TYPE_FUTURE);
        }
        mir_emit(inst);
        return r;
    }

    // await：降低 Future 表达式，发射 MIR_AWAIT 取值
    if (k == EXPR_AWAIT) {
        let children = h.children;
        let fut_reg = mir_lower_expr(children[0]);
        let r = mir_new_reg();
        let inst = mir_mk(MIR_AWAIT);
        inst.dst = r;
        inst.arg1 = fut_reg;
        inst.ty = mk_type(TYPE_ANY);
        mir_emit(inst);
        return r;
    }

    // new Type：分配零初始化 struct（h.intval = 字段数，TC 回填）
    if (k == EXPR_NEW) {
        let n_fields = h.intval as int;
        let int_ty = mk_type(TYPE_INT);
        let field_regs: array<int> = [];
        let i = 0;
        while (i < n_fields) {
            let zr = mir_new_reg();
            let z = mir_mk(MIR_CONST_INT);
            z.dst = zr;
            z.longval = 0;
            z.ty = int_ty;
            mir_emit(z);
            field_regs = array_push(field_regs, zr);
            i = i + 1;
        }
        let r = mir_new_reg();
        let inst = mir_mk(MIR_STRUCT_LIT);
        inst.dst = r;
        inst.strval = h.str1;
        inst.args = field_regs;
        inst.ty = h.inferred_type;
        mir_emit(inst);
        return r;
    }

    // if 表达式：condbr → then/else 各写结果 slot → merge load
    if (k == EXPR_IF) {
        let children = h.children;
        let tmp_slot = h.slot;
        let cond = mir_lower_expr(children[0]);
        let then_label = mir_new_label();
        let else_label = mir_new_label();
        let merge_label = mir_new_label();

        let condbr = mir_mk(MIR_CONDBR);
        condbr.arg1 = cond;
        condbr.strval = then_label;
        condbr.strval2 = else_label;
        mir_set_term(condbr);

        mir_seal_and_begin(then_label);
        let then_val = mir_lower_expr(children[1]);
        let st1 = mir_mk(MIR_STORE_VAR);
        st1.arg1 = then_val;
        st1.arg2 = tmp_slot;
        st1.ty = h.inferred_type;
        mir_emit(st1);
        mir_emit_br(merge_label);

        mir_seal_and_begin(else_label);
        let else_val = -1;
        if (len(children) > 2) {
            else_val = mir_lower_expr(children[2]);
        } else {
            let z = mir_mk(MIR_CONST_INT);
            let zr = mir_new_reg();
            z.dst = zr;
            z.longval = 0;
            z.ty = h.inferred_type;
            mir_emit(z);
            else_val = zr;
        }
        let st2 = mir_mk(MIR_STORE_VAR);
        st2.arg1 = else_val;
        st2.arg2 = tmp_slot;
        st2.ty = h.inferred_type;
        mir_emit(st2);
        mir_emit_br(merge_label);

        mir_seal_and_begin(merge_label);
        let r = mir_new_reg();
        let ld = mir_mk(MIR_LOAD_VAR);
        ld.dst = r;
        ld.arg1 = tmp_slot;
        ld.ty = h.inferred_type;
        mir_emit(ld);
        return r;
    }

    // match 表达式：children 布局 [0]=scrutinee, 之后交替 pat,body
    if (k == EXPR_MATCH) {
        let children = h.children;
        let tmp_slot = h.slot;
        let scrut = mir_lower_expr(children[0]);
        let merge_label = mir_new_label();
        let n = len(children);
        let bool_ty = mk_type(TYPE_BOOL);
        let i = 1;
        while (i < n) {
            let pat_h = children[i];
            let body_h = children[i + 1];
            let is_wild = 0;
            if (pat_h.kind == EXPR_VAR && str_eq(pat_h.str1, "_") == 1) { is_wild = 1; }
            if (is_wild == 1) {
                let bvw = mir_lower_expr(body_h);
                let stw = mir_mk(MIR_STORE_VAR);
                stw.arg1 = bvw;
                stw.arg2 = tmp_slot;
                stw.ty = h.inferred_type;
                mir_emit(stw);
                mir_emit_br(merge_label);
                i = n;
            } else if (pat_h.kind == EXPR_ENUM_VARIANT) {
                let variant_idx = pat_h.intval as int;
                let tag_r = mir_new_reg();
                let tag_inst = mir_mk(MIR_ENUM_GET_TAG);
                tag_inst.dst = tag_r;
                tag_inst.arg1 = scrut;
                tag_inst.ty = mk_type(TYPE_INT);
                mir_emit(tag_inst);
                let vi_r = mir_new_reg();
                let vi_inst = mir_mk(MIR_CONST_INT);
                vi_inst.dst = vi_r;
                vi_inst.longval = variant_idx;
                vi_inst.ty = mk_type(TYPE_INT);
                mir_emit(vi_inst);
                let cmp_r = mir_new_reg();
                let cmp = mir_mk(MIR_BINOP);
                cmp.dst = cmp_r;
                cmp.arg1 = tag_r;
                cmp.arg2 = vi_r;
                cmp.longval = BIN_EQ;
                cmp.ty = bool_ty;
                mir_emit(cmp);
                let body_label = mir_new_label();
                let next_label = mir_new_label();
                let condbr = mir_mk(MIR_CONDBR);
                condbr.arg1 = cmp_r;
                condbr.strval = body_label;
                condbr.strval2 = next_label;
                mir_set_term(condbr);
                // 命中臂：提取每个 payload 写入绑定 slot
                mir_seal_and_begin(body_label);
                let bind_children = pat_h.children;
                let bi = 0;
                while (bi < len(bind_children)) {
                    let bh = bind_children[bi];
                    let payload_r = mir_new_reg();
                    let pl_inst = mir_mk(MIR_ENUM_GET_PAYLOAD);
                    pl_inst.dst = payload_r;
                    pl_inst.arg1 = scrut;
                    pl_inst.longval = bh.intval;  // 负载索引
                    pl_inst.arg2 = len(bind_children);  // 负载总数
                    pl_inst.ty = bh.inferred_type;
                    if ((pl_inst.ty as any) == 0) { pl_inst.ty = mk_type(TYPE_ANY); }
                    mir_emit(pl_inst);
                    let stb2 = mir_mk(MIR_STORE_VAR);
                    stb2.arg1 = payload_r;
                    stb2.arg2 = bh.slot;
                    stb2.ty = pl_inst.ty;
                    mir_emit(stb2);
                    bi = bi + 1;
                }
                let bv = mir_lower_expr(body_h);
                let stb = mir_mk(MIR_STORE_VAR);
                stb.arg1 = bv;
                stb.arg2 = tmp_slot;
                stb.ty = h.inferred_type;
                mir_emit(stb);
                mir_emit_br(merge_label);
                mir_seal_and_begin(next_label);
            } else {
                // 无负载变体名（None）或字面量模式
                let pat_ty = pat_h.inferred_type;
                let is_no_payload_variant = 0;
                let variant_idx_np = 0;
                if ((pat_ty as any) != 0) {
                    if (pat_ty.kind == TYPE_ENUM_PAYLOAD && pat_h.slot < 0) {
                        is_no_payload_variant = 1;
                        variant_idx_np = pat_h.intval as int;
                    }
                }
                if (is_no_payload_variant == 1) {
                    let tag_r = mir_new_reg();
                    let tag_inst = mir_mk(MIR_ENUM_GET_TAG);
                    tag_inst.dst = tag_r;
                    tag_inst.arg1 = scrut;
                    tag_inst.ty = mk_type(TYPE_INT);
                    mir_emit(tag_inst);
                    let vi_r = mir_new_reg();
                    let vi_inst = mir_mk(MIR_CONST_INT);
                    vi_inst.dst = vi_r;
                    vi_inst.longval = variant_idx_np;
                    vi_inst.ty = mk_type(TYPE_INT);
                    mir_emit(vi_inst);
                    let cmp_r = mir_new_reg();
                    let cmp = mir_mk(MIR_BINOP);
                    cmp.dst = cmp_r;
                    cmp.arg1 = tag_r;
                    cmp.arg2 = vi_r;
                    cmp.longval = BIN_EQ;
                    cmp.ty = bool_ty;
                    mir_emit(cmp);
                    let body_label = mir_new_label();
                    let next_label = mir_new_label();
                    let condbr = mir_mk(MIR_CONDBR);
                    condbr.arg1 = cmp_r;
                    condbr.strval = body_label;
                    condbr.strval2 = next_label;
                    mir_set_term(condbr);
                    mir_seal_and_begin(body_label);
                    let bv = mir_lower_expr(body_h);
                    let stb = mir_mk(MIR_STORE_VAR);
                    stb.arg1 = bv;
                    stb.arg2 = tmp_slot;
                    stb.ty = h.inferred_type;
                    mir_emit(stb);
                    mir_emit_br(merge_label);
                    mir_seal_and_begin(next_label);
                } else {
                    let pv = mir_lower_expr(pat_h);
                    let cmp_r = mir_new_reg();
                    let cmp = mir_mk(MIR_BINOP);
                    cmp.dst = cmp_r;
                    cmp.arg1 = scrut;
                    cmp.arg2 = pv;
                    cmp.longval = BIN_EQ;
                    cmp.ty = bool_ty;
                    mir_emit(cmp);
                    let body_label = mir_new_label();
                    let next_label = mir_new_label();
                    let condbr = mir_mk(MIR_CONDBR);
                    condbr.arg1 = cmp_r;
                    condbr.strval = body_label;
                    condbr.strval2 = next_label;
                    mir_set_term(condbr);
                    mir_seal_and_begin(body_label);
                    let bv = mir_lower_expr(body_h);
                    let stb = mir_mk(MIR_STORE_VAR);
                    stb.arg1 = bv;
                    stb.arg2 = tmp_slot;
                    stb.ty = h.inferred_type;
                    mir_emit(stb);
                    mir_emit_br(merge_label);
                    mir_seal_and_begin(next_label);
                }
            }
            i = i + 2;
        }
        // 全不匹配兜底：写 0（当前块已终止则自动丢弃）
        let z = mir_mk(MIR_CONST_INT);
        let zr = mir_new_reg();
        z.dst = zr;
        z.longval = 0;
        z.ty = h.inferred_type;
        mir_emit(z);
        let stz = mir_mk(MIR_STORE_VAR);
        stz.arg1 = zr;
        stz.arg2 = tmp_slot;
        stz.ty = h.inferred_type;
        mir_emit(stz);
        mir_emit_br(merge_label);
        mir_seal_and_begin(merge_label);
        let mr = mir_new_reg();
        let mld = mir_mk(MIR_LOAD_VAR);
        mld.dst = mr;
        mld.arg1 = tmp_slot;
        mld.ty = h.inferred_type;
        mir_emit(mld);
        return mr;
    }

    // `?` 错误传播：unwrap-or-throw
    //   h.children[0] = inner；h.inferred_type = 解包类型 A（TC 推导）
    //   h.op = 错误变体索引（1）；h.str1 = 枚举名（"Result"/"Option"）
    if (k == EXPR_QUESTION) {
        let inner_r = mir_lower_expr(h.children[0]);
        // 立即备份 inner_r：GET_PAYLOAD 在 mir_seal_and_begin(ok_label) 之后才用。
        // 0.4 编译器自身编译 mir.shadow 时，局部 int 跨多次函数调用（mir_mk/mir_emit/
        // mir_seal_and_begin）存在 slot 被覆盖的风险（实测 GET_PAYLOAD.arg1 从正确值
        // 变成后续寄存器号 1 → cg_get_reg 未设置 → IR `<null operand!>` → llc 崩溃）。
        let inner_r_keep = inner_r;
        if (file_exists("build/.qdbg") == 1) {
            let k0 = -999;
            if ((h.children[0] as any) != 0) { k0 = h.children[0].kind; }
            println("DBG question inner_r=" + int_to_str(inner_r) + " nchild=" + int_to_str(len(h.children)) + " kind0=" + int_to_str(k0));
        }
        let a_ty = h.inferred_type;
        if ((a_ty as any) == 0) { a_ty = mk_type(TYPE_ANY); }
        let bool_ty = mk_type(TYPE_BOOL);
        let tag_r = mir_new_reg();
        let tag_inst = mir_mk(MIR_ENUM_GET_TAG);
        tag_inst.dst = tag_r;
        tag_inst.arg1 = inner_r_keep;
        tag_inst.ty = mk_type(TYPE_INT);
        mir_emit(tag_inst);
        let vi_r = mir_new_reg();
        let vi_inst = mir_mk(MIR_CONST_INT);
        vi_inst.dst = vi_r;
        vi_inst.longval = h.op;
        vi_inst.ty = mk_type(TYPE_INT);
        mir_emit(vi_inst);
        let cmp_r = mir_new_reg();
        let cmp = mir_mk(MIR_BINOP);
        cmp.dst = cmp_r;
        cmp.arg1 = tag_r;
        cmp.arg2 = vi_r;
        cmp.longval = BIN_EQ;
        cmp.ty = bool_ty;
        mir_emit(cmp);
        let ok_label = mir_new_label();
        let err_label = mir_new_label();
        let merge_label = mir_new_label();
        let condbr = mir_mk(MIR_CONDBR);
        condbr.arg1 = cmp_r;
        condbr.strval = err_label;
        condbr.strval2 = ok_label;
        mir_set_term(condbr);
        // 错误臂：rt_throw_str(msg) + ret
        mir_seal_and_begin(err_label);
        let msg_r = mir_new_reg();
        let msg_inst = mir_mk(MIR_CONST_STR);
        msg_inst.dst = msg_r;
        if (str_eq(h.str1, "Option") == 1) {
            msg_inst.strval = "error: '?' used on None value";
        } else {
            msg_inst.strval = "error: '?' used on Err value";
        }
        msg_inst.ty = mk_type(TYPE_STRING);
        mir_emit(msg_inst);
        let thr = mir_mk(MIR_CALL);
        thr.strval = "rt_throw_str";
        thr.args = array_push([], msg_r);
        thr.ty = mk_type(TYPE_VOID);
        mir_emit(thr);
        let ret_inst = mir_mk(MIR_RET);
        ret_inst.arg1 = -1;
        mir_set_term(ret_inst);
        // OK 臂：提取 payload(A)
        mir_seal_and_begin(ok_label);
        let pv_r = mir_new_reg();
        let pl = mir_mk(MIR_ENUM_GET_PAYLOAD);
        pl.dst = pv_r;
        pl.arg1 = inner_r_keep;
        pl.longval = 0;
        pl.ty = a_ty;
        mir_emit(pl);
        mir_emit_br(merge_label);
        mir_seal_and_begin(merge_label);
        return pv_r;
    }

    // 未知表达式种类
    return -1;
}


// --- 语句 lowering ---
pub kimo mir_lower_stmt(h: HirStmt) -> void {
    mir_cur_line = h.line;
    let k = h.kind;

    if (k == STMT_LET) {
        // 数组护栏分析：let 是一次定义 → 该槽类常量（后续未被赋值则保持）；记录下界。
        if (h.slot >= 0 && h.slot < len(mir_constish)) {
            mir_constish[h.slot] = 1;
            let cli = 0;
            while (cli < len(mir_cap_lb_slot)) {
                if (mir_cap_lb_ok[cli] == 1 && mir_cap_lb_slot[cli] == h.slot) { mir_cap_lb_ok[cli] = 0; }
                cli = cli + 1;
            }
        }
        if ((h.child as any) != 0) { mir_vmin_set(h.slot, h.child); }
        if ((h.child as any) != 0) {
            let rhs_reg = mir_lower_expr(h.child);
            let inst = mir_mk(MIR_STORE_VAR);
            inst.arg1 = rhs_reg;
            inst.arg2 = h.slot;
            inst.ty = h.inferred_type;
            mir_emit(inst);
            // 所有权：let x = y（变量复制）→ 共享缓冲，源与目标均不唯一持有；
            // let x = 字面量/二元运算 → 新缓冲，唯一持有；
            // let x = 调用/索引/成员/闭包 → 结果可能逃逸/共享，不唯一持有。
            let init_kind = h.child.kind;
            if (mir_dbg() == 1) {
                println("DBG LET slot=" + int_to_str(h.slot) + " initkind=" + int_to_str(init_kind) + " childslot=" + int_to_str(h.child.slot) + " owned=" + int_to_str(mir_owned_is(h.slot)));
            }
            // 空数组字面量 [] → 标记空（供填充循环预分配检测）；其他初始化清 0
            if (init_kind == EXPR_ARRAY_LIT && len(h.child.children) == 0) {
                mir_empty_set(h.slot, 1);
            } else {
                mir_empty_set(h.slot, 0);
            }
            if (init_kind == EXPR_VAR) {
                mir_owned_clear(h.child.slot);
                mir_owned_set(h.slot, 0);
            } else if (init_kind == EXPR_CALL || init_kind == EXPR_INDEX ||
                       init_kind == EXPR_MEMBER || init_kind == EXPR_CLOSURE) {
                mir_owned_set(h.slot, 0);
                if (init_kind == EXPR_CLOSURE) {
                    // 闭包捕获的变量缓冲被闭包共享，清除所有权
                    let cap_children = h.child.children;
                    let ci = 0;
                    while (ci < len(cap_children)) {
                        if (cap_children[ci].kind == EXPR_VAR) { mir_owned_clear(cap_children[ci].slot); }
                        ci = ci + 1;
                    }
                }
            } else {
                mir_owned_set(h.slot, 1);
            }
        }
        return;
    }

    if (k == STMT_EXPR) {
        if ((h.child as any) != 0) {
            mir_lower_expr(h.child);
        }
        return;
    }

    if (k == STMT_RETURN) {
        if ((h.child as any) != 0) {
            let r = mir_lower_expr(h.child);
            let inst = mir_mk(MIR_RET);
            inst.arg1 = r;
            mir_set_term(inst);
        } else {
            let inst = mir_mk(MIR_RET);
            inst.arg1 = -1;
            mir_set_term(inst);
        }
        return;
    }

    if (k == STMT_IF) {
        let cond_reg = mir_lower_expr(h.child);
        let then_label = mir_new_label();
        let else_label = mir_new_label();
        let merge_label = mir_new_label();

        let condbr = mir_mk(MIR_CONDBR);
        condbr.arg1 = cond_reg;
        condbr.strval = then_label;
        condbr.strval2 = else_label;
        mir_set_term(condbr);

        mir_seal_and_begin(then_label);
        let then_body = h.body;
        let i = 0;
        while (i < len(then_body)) {
            mir_lower_stmt(then_body[i]);
            i = i + 1;
        }
        mir_emit_br(merge_label);

        mir_seal_and_begin(else_label);
        let else_body = h.else_body;
        let j = 0;
        while (j < len(else_body)) {
            mir_lower_stmt(else_body[j]);
            j = j + 1;
        }
        mir_emit_br(merge_label);

        mir_seal_and_begin(merge_label);
        return;
    }

    // 语句级 match（含 enum 解构臂）：镜像 EXPR_MATCH 控制流，臂体是语句块
    if (k == STMT_MATCH) {
        let scrut = mir_lower_expr(h.child);
        let merge_label = mir_new_label();
        let pats = h.pats;
        let blocks = h.arm_blocks;
        let bool_ty = mk_type(TYPE_BOOL);
        let n = len(pats);
        let i = 0;
        while (i < n) {
            let pat_h = pats[i];
            let blk = blocks[i];
            let is_wild = 0;
            if (pat_h.kind == EXPR_VAR && str_eq(pat_h.str1, "_") == 1) { is_wild = 1; }
            if (is_wild == 1) {
                let wj = 0;
                while (wj < len(blk.stmts)) {
                    mir_lower_stmt(blk.stmts[wj]);
                    wj = wj + 1;
                }
                mir_emit_br(merge_label);
                i = n;
            } else if (pat_h.kind == EXPR_ENUM_VARIANT) {
                let variant_idx = pat_h.intval as int;
                let tag_r = mir_new_reg();
                let tag_inst = mir_mk(MIR_ENUM_GET_TAG);
                tag_inst.dst = tag_r;
                tag_inst.arg1 = scrut;
                tag_inst.ty = mk_type(TYPE_INT);
                mir_emit(tag_inst);
                let vi_r = mir_new_reg();
                let vi_inst = mir_mk(MIR_CONST_INT);
                vi_inst.dst = vi_r;
                vi_inst.longval = variant_idx;
                vi_inst.ty = mk_type(TYPE_INT);
                mir_emit(vi_inst);
                let cmp_r = mir_new_reg();
                let cmp = mir_mk(MIR_BINOP);
                cmp.dst = cmp_r;
                cmp.arg1 = tag_r;
                cmp.arg2 = vi_r;
                cmp.longval = BIN_EQ;
                cmp.ty = bool_ty;
                mir_emit(cmp);
                let body_label = mir_new_label();
                let next_label = mir_new_label();
                let condbr = mir_mk(MIR_CONDBR);
                condbr.arg1 = cmp_r;
                condbr.strval = body_label;
                condbr.strval2 = next_label;
                mir_set_term(condbr);
                // 命中臂：提取 payload 写入绑定 slot，再执行臂块
                mir_seal_and_begin(body_label);
                let bind_children = pat_h.children;
                let bi = 0;
                while (bi < len(bind_children)) {
                    let bh = bind_children[bi];
                    let payload_r = mir_new_reg();
                    let pl_inst = mir_mk(MIR_ENUM_GET_PAYLOAD);
                    pl_inst.dst = payload_r;
                    pl_inst.arg1 = scrut;
                    pl_inst.longval = bh.intval;
                    pl_inst.arg2 = len(bind_children);
                    pl_inst.ty = bh.inferred_type;
                    if ((pl_inst.ty as any) == 0) { pl_inst.ty = mk_type(TYPE_ANY); }
                    mir_emit(pl_inst);
                    let stb2 = mir_mk(MIR_STORE_VAR);
                    stb2.arg1 = payload_r;
                    stb2.arg2 = bh.slot;
                    stb2.ty = pl_inst.ty;
                    mir_emit(stb2);
                    bi = bi + 1;
                }
                let bj = 0;
                while (bj < len(blk.stmts)) {
                    mir_lower_stmt(blk.stmts[bj]);
                    bj = bj + 1;
                }
                mir_emit_br(merge_label);
                mir_seal_and_begin(next_label);
            } else {
                // 无负载变体名（None）或字面量模式
                let pat_ty = pat_h.inferred_type;
                let is_no_payload_variant = 0;
                let variant_idx_np = 0;
                if ((pat_ty as any) != 0) {
                    if (pat_ty.kind == TYPE_ENUM_PAYLOAD && pat_h.slot < 0) {
                        is_no_payload_variant = 1;
                        variant_idx_np = pat_h.intval as int;
                    }
                }
                let cmp_r = mir_new_reg();
                if (is_no_payload_variant == 1) {
                    let tag_r = mir_new_reg();
                    let tag_inst = mir_mk(MIR_ENUM_GET_TAG);
                    tag_inst.dst = tag_r;
                    tag_inst.arg1 = scrut;
                    tag_inst.ty = mk_type(TYPE_INT);
                    mir_emit(tag_inst);
                    let vi_r = mir_new_reg();
                    let vi_inst = mir_mk(MIR_CONST_INT);
                    vi_inst.dst = vi_r;
                    vi_inst.longval = variant_idx_np;
                    vi_inst.ty = mk_type(TYPE_INT);
                    mir_emit(vi_inst);
                    let cmp = mir_mk(MIR_BINOP);
                    cmp.dst = cmp_r;
                    cmp.arg1 = tag_r;
                    cmp.arg2 = vi_r;
                    cmp.longval = BIN_EQ;
                    cmp.ty = bool_ty;
                    mir_emit(cmp);
                } else {
                    let pv = mir_lower_expr(pat_h);
                    let cmp = mir_mk(MIR_BINOP);
                    cmp.dst = cmp_r;
                    cmp.arg1 = scrut;
                    cmp.arg2 = pv;
                    cmp.longval = BIN_EQ;
                    cmp.ty = bool_ty;
                    mir_emit(cmp);
                }
                let body_label = mir_new_label();
                let next_label = mir_new_label();
                let condbr = mir_mk(MIR_CONDBR);
                condbr.arg1 = cmp_r;
                condbr.strval = body_label;
                condbr.strval2 = next_label;
                mir_set_term(condbr);
                mir_seal_and_begin(body_label);
                let bj = 0;
                while (bj < len(blk.stmts)) {
                    mir_lower_stmt(blk.stmts[bj]);
                    bj = bj + 1;
                }
                mir_emit_br(merge_label);
                mir_seal_and_begin(next_label);
            }
            i = i + 1;
        }
        // 全不匹配：落入 merge
        mir_emit_br(merge_label);
        mir_seal_and_begin(merge_label);
        return;
    }

    if (k == STMT_WHILE) {
        // 填充循环预分配：识别 while (i < n) { a = array_push(a, v); i = i + 1; }
        // 且 a 已知为空（let a=[]）→ 循环前一次性分配 cap=n（类似 Go 的 make），
        // 消除 2M 次 push 的倍增扩容 + memcpy（prime_sieve 等）。bound 仅限变量/字面量
        // （无副作用，可安全在循环前求值一次）；a 非空或模式不符则不触发（保守）。
        let pre_slots: array<int> = [];
        let pre_tys: array<Type> = [];
        let pre_bound: HirExpr = 0 as HirExpr;
        let cond = h.child;
        if ((cond as any) != 0 && cond.kind == EXPR_BINARY &&
            (cond.op == BIN_LT || cond.op == BIN_LE)) {
            let cchildren = cond.children;
            if (len(cchildren) == 2 && cchildren[0].kind == EXPR_VAR) {
                let c1 = cchildren[1];
                if (c1.kind == EXPR_VAR || c1.kind == EXPR_INT) {
                    let i_slot = cchildren[0].slot;
                    let body = h.body;
                    let found_inc = 0;
                    let bi = 0;
                    while (bi < len(body)) {
                        let st = body[bi];
                        if (st.kind == STMT_ASSIGN && (st.child as any) != 0 &&
                            (st.rhs as any) != 0) {
                            let slhs = st.child;
                            let srhs = st.rhs;
                            if (slhs.kind == EXPR_VAR) {
                                if (srhs.kind == EXPR_CALL && str_eq(srhs.str1, "array_push") == 1) {
                                    let args = srhs.children;
                                    if (len(args) > 0 && args[0].kind == EXPR_VAR &&
                                        args[0].slot == slhs.slot && mir_empty_is(slhs.slot) == 1) {
                                        let dup = 0;
                                        let di = 0;
                                        while (di < len(pre_slots)) {
                                            if (pre_slots[di] == slhs.slot) { dup = 1; }
                                            di = di + 1;
                                        }
                                        if (dup == 0) {
                                            pre_slots = array_push(pre_slots, slhs.slot);
                                            pre_tys = array_push(pre_tys, slhs.inferred_type);
                                        }
                                    }
                                }
                                if (srhs.kind == EXPR_BINARY && srhs.op == BIN_ADD) {
                                    let rchildren = srhs.children;
                                    if (len(rchildren) == 2 && rchildren[0].kind == EXPR_VAR &&
                                        rchildren[0].slot == slhs.slot && slhs.slot == i_slot &&
                                        rchildren[1].kind == EXPR_INT && rchildren[1].intval == 1) {
                                        found_inc = 1;
                                    }
                                }
                            }
                        }
                        bi = bi + 1;
                    }
                    if (len(pre_slots) > 0 && found_inc == 1) {
                        pre_bound = c1;
                    }
                }
            }
        }
        if (len(pre_slots) > 0 && (pre_bound as any) != 0) {
            // 预分配：对每个合格目标各发一条 a = shadow_array_prealloc(elem_size, n)。
            // 上界只求值一次并被所有目标共享（bound 限定为变量/字面量，无副作用）；
            // elem_size 逐目标按各自元素类型算。原实现只保留最后一个目标，于是
            // while(i<n){a=push(a);b=push(b);c=push(c);d=push(d)} 里三个数组仍走
            // 倍增扩容（awfy_queens_long 实测 234 万次分配、其中 72 万次是 12 字节
            // 空数组，正是这个形状）。
            let n_reg = mir_lower_expr(pre_bound);
            // v10_s18：形状条件更严时把逐元素 append 改成计数下标直写。按下标写一旦越过
            // cap 就是堆越界（原先由 push 的扩容接住），所以容量改准为实际写入数 n - base。
            let cap_reg = n_reg;
            let cap_fn = "shadow_array_prealloc";
            let sred_cnt = mir_sred_begin(cond, h.body, pre_slots, n_reg);
            if (sred_cnt >= 0) {
                cap_reg = sred_cnt;
                // 削减启用后容量是 64 位精确计数（不在 int32 里回绕），走 _l 版本。
                cap_fn = "shadow_array_prealloc_l";
            }
            let pi = 0;
            while (pi < len(pre_slots)) {
                let pslot = pre_slots[pi];
                let pty: Type = pre_tys[pi];
                let es = 8;
                if ((pty as any) != 0 && (pty.elem_type as any) != 0) {
                    let ek = pty.elem_type.kind;
                    if (ek == TYPE_INT || ek == TYPE_CHAR || ek == TYPE_SHORT ||
                        ek == TYPE_BOOL || ek == TYPE_ENUM || ek == TYPE_DATE) { es = 4; }
                }
                let es_reg = mir_new_reg();
                let es_inst = mir_mk(MIR_CONST_INT);
                es_inst.dst = es_reg;
                es_inst.longval = es;
                es_inst.ty = mk_type(TYPE_INT);
                mir_emit(es_inst);
                let r = mir_new_reg();
                let call = mir_mk(MIR_CALL);
                call.dst = r;
                call.strval = cap_fn;
                call.args = [es_reg, cap_reg];
                call.ty = pty;
                mir_emit(call);
                let st = mir_mk(MIR_STORE_VAR);
                st.arg1 = r;
                st.arg2 = pslot;
                st.ty = pty;
                mir_emit(st);
                mir_empty_set(pslot, 0);
                // 预分配后 cap(a)==bound：bound 为类常量槽时建立容量事实（供循环界证明/跨调用传达）
                if (pre_bound.kind == EXPR_VAR) { mir_cap_set(pslot, pre_bound.slot); }
                pi = pi + 1;
            }
        }
        // 循环界帧：while(cv < B) / while(cv <= B) 且 cv 在体内单调不减 → 压栈，
        // 供数组访问证明 0 <= cv-C < cap(==B)。bound 可为变量槽或常量。
        let lf_cv_slot = -1;
        let lf_bound_slot = -1;
        let lf_bval = 0;
        let lf_inc = 0;
        let lf_pushed = 0;
        let lf_cond = h.child;
        if ((lf_cond as any) != 0 && lf_cond.kind == EXPR_BINARY &&
            (lf_cond.op == BIN_LT || lf_cond.op == BIN_LE) && len(lf_cond.children) == 2 &&
            lf_cond.children[0].kind == EXPR_VAR) {
            let lf_cv = lf_cond.children[0];
            let lf_c1 = lf_cond.children[1];
            let lf_okb = 0;
            if (lf_c1.kind == EXPR_VAR) { lf_bound_slot = lf_c1.slot; lf_okb = 1; }
            else if (lf_c1.kind == EXPR_INT) { lf_bound_slot = -1; lf_bval = lf_c1.intval as int; lf_okb = 1; }
            if (lf_okb == 1 && mir_loop_cv_monotone(lf_cv.slot, h.body) == 1) {
                lf_cv_slot = lf_cv.slot;
                if (lf_cond.op == BIN_LE) { lf_inc = 1; }
                mir_lf_push(lf_cv_slot, lf_bound_slot, lf_bval, lf_inc);
                lf_pushed = 1;
            }
        }
        // 循环入口：体内别名操作会让变量在下一次迭代被共享，清除所有权禁用就地追加
        mir_clear_loop_aliases(h.body);
        let cond_label = mir_new_label();
        let body_label = mir_new_label();
        let exit_label = mir_new_label();

        mir_emit_br(cond_label);

        mir_seal_and_begin(cond_label);
        let cond_reg = mir_lower_expr(h.child);
        let condbr = mir_mk(MIR_CONDBR);
        condbr.arg1 = cond_reg;
        condbr.strval = body_label;
        condbr.strval2 = exit_label;
        mir_set_term(condbr);

        mir_seal_and_begin(body_label);
        mir_push_loop(exit_label, cond_label);
        let body = h.body;
        let i = 0;
        while (i < len(body)) {
            mir_lower_stmt(body[i]);
            i = i + 1;
        }
        mir_pop_loop();
        mir_emit_br(cond_label);

        if (lf_pushed == 1) { mir_lf_pop(); }

        mir_seal_and_begin(exit_label);
        // v10_s18：出口一次性把各目标的 len 补成实际写入数（未启用削减时是空操作）。
        mir_sred_finish();
        // 填充循环出口：预分配保证 cap(a)>=bound，且循环体对 a 的 push 复写会清掉 cap 事实
        // （mir_mark_reassigned），此处重建 cap(a)==bound 供紧随其后的调用/访问证明使用。
        if ((pre_bound as any) != 0 && pre_bound.kind == EXPR_VAR) {
            let pj = 0;
            while (pj < len(pre_slots)) { mir_cap_set(pre_slots[pj], pre_bound.slot); pj = pj + 1; }
        }
        return;
    }

    if (k == STMT_BREAK) {
        let n = len(mir_loop_break_labels);
        if (n > 0) {
            let target = mir_loop_break_labels[n - 1] as string;
            mir_emit_br(target);
        }
        return;
    }

    if (k == STMT_CONTINUE) {
        let n = len(mir_loop_continue_labels);
        if (n > 0) {
            let target = mir_loop_continue_labels[n - 1] as string;
            mir_emit_br(target);
        }
        return;
    }

    if (k == STMT_ASSIGN) {
        let lhs = h.child;
        let rhs_h = h.rhs;

        if (lhs.kind == EXPR_VAR) {
            // 数组护栏分析：这是对该槽的又一次写入 → 不再类常量；更新下界。
            mir_mark_reassigned(lhs.slot);
            if ((rhs_h as any) != 0) { mir_vmin_set(lhs.slot, rhs_h); }
            // 空数组字面量 [] → 标记空（供填充循环预分配检测）；其他写入清 0
            if ((rhs_h as any) != 0 && rhs_h.kind == EXPR_ARRAY_LIT && len(rhs_h.children) == 0) {
                mir_empty_set(lhs.slot, 1);
            } else {
                mir_empty_set(lhs.slot, 0);
            }
            // v10_s18：本循环已启用计数存储削减 → a = array_push(a, v) 改成 a[i-base] = v。
            // 不回写槽：数组对象从头到尾没换过（容量在循环前一次给足）。
            if ((rhs_h as any) != 0 && rhs_h.kind == EXPR_CALL &&
                mir_sred_try_store(lhs.slot, rhs_h) == 1) {
                mir_owned_set(lhs.slot, 0);
                return;
            }
            // 就地追加优化：a = a + b（静态 string 类型）→ shadow_string_concat_inplace(a, b)。
            // 复用 a 的缓冲，避免热循环里每次拼接都分配新缓冲 + 全量复制（str_reverse 等）。
            // 仅当 RHS 是 a + b 且 a 与 LHS 同变量、类型为 string、且 a 唯一持有其缓冲
            // （mir_owned_is）时生效；字面量/非堆缓冲由运行时 rt_alloc_cap 检测并回退普通 concat。
            let lty = lhs.inferred_type;
            if ((rhs_h as any) != 0 && (lty as any) != 0 && lty.kind == TYPE_STRING &&
                rhs_h.kind == EXPR_BINARY && rhs_h.op == BIN_ADD) {
                let rchildren = rhs_h.children;
                if (len(rchildren) == 2) {
                    let rl = rchildren[0];
                    let rr = rchildren[1];
                    if (rl.kind == EXPR_VAR && rl.slot == lhs.slot && mir_owned_is(lhs.slot) == 1) {
                        // 单字符追加优化：a = a + s[i]（s 为 string）→
                        // a = shadow_string_concat_char_at(a, s, i)。
                        // 消除 s[i] 每次分配 1 字符字符串（str_reverse 91% 分配来自此）；
                        // 单次 C 调用完成"读源字符 + strlen/cap 判断 + 写字节"，
                        // 消除原 char_at + concat_char_fast 每轮 2 次调用 → 1 次。
                        if (rr.kind == EXPR_INDEX && len(rr.children) == 2) {
                            let rbase = rr.children[0];
                            if ((rbase as any) != 0 && (rbase.inferred_type as any) != 0 &&
                                rbase.inferred_type.kind == TYPE_STRING) {
                                let ra = mir_lower_expr(rl);
                                let rs = mir_lower_expr(rbase);
                                let ri = mir_lower_expr(rr.children[1]);
                                let rc = mir_new_reg();
                                let call = mir_mk(MIR_CALL);
                                call.dst = rc;
                                call.strval = "shadow_string_concat_char_at";
                                call.args = [ra, rs, ri];
                                call.ty = lty;
                                mir_emit(call);
                                let st = mir_mk(MIR_STORE_VAR);
                                st.arg1 = rc;
                                st.arg2 = lhs.slot;
                                st.ty = lty;
                                st.strval = lhs.str1;
                                mir_emit(st);
                                return;
                            }
                        }
                        if (mir_dbg() == 1) {
                            println("DBG INPLACE slot=" + int_to_str(lhs.slot) + " owned=" + int_to_str(mir_owned_is(lhs.slot)));
                        }
                        let ra = mir_lower_expr(rl);
                        let rb = mir_lower_expr(rr);
                        let rc = mir_new_reg();
                        let call = mir_mk(MIR_CALL);
                        call.dst = rc;
                        call.strval = "shadow_string_concat_inplace";
                        call.args = [ra, rb];
                        call.ty = lty;
                        mir_emit(call);
                        let st = mir_mk(MIR_STORE_VAR);
                        st.arg1 = rc;
                        st.arg2 = lhs.slot;
                        st.ty = lty;
                        st.strval = lhs.str1;
                        mir_emit(st);
                        return;
                    }
                }
            }
            let rhs_reg = -1;
            if ((rhs_h as any) != 0) { rhs_reg = mir_lower_expr(rhs_h); }
            let inst = mir_mk(MIR_STORE_VAR);
            inst.arg1 = rhs_reg;
            inst.arg2 = lhs.slot;
            inst.ty = lhs.inferred_type;  // slot 类型（如 double）：codegen 据此做 float→double fpext
            inst.strval = lhs.str1;  // 全局赋值（slot=-1）按名查找
            mir_emit(inst);
            // 所有权更新（与 STMT_LET 同规则）：x = y → 共享；x = 字面量/二元 → 新缓冲；
            // x = 调用/索引/成员/闭包 → 不唯一持有。
            if ((rhs_h as any) != 0) {
                let rk = rhs_h.kind;
                if (rk == EXPR_VAR) {
                    mir_owned_clear(rhs_h.slot);
                    mir_owned_set(lhs.slot, 0);
                } else if (rk == EXPR_CALL || rk == EXPR_INDEX ||
                           rk == EXPR_MEMBER || rk == EXPR_CLOSURE) {
                    mir_owned_set(lhs.slot, 0);
                } else {
                    mir_owned_set(lhs.slot, 1);
                }
            }
            return;
        }

        if (lhs.kind == EXPR_INDEX) {
            let lhs_children = lhs.children;
            // a[i] = v 写入数组缓冲：清空 a 的空标记（保守，防预分配误判）
            if (len(lhs_children) > 0 && lhs_children[0].kind == EXPR_VAR) {
                mir_empty_set(lhs_children[0].slot, 0);
            }
            let arr_reg = mir_lower_expr(lhs_children[0]);
            let idx_reg = mir_lower_expr(lhs_children[1]);
            let rhs_reg = -1;
            if ((rhs_h as any) != 0) { rhs_reg = mir_lower_expr(rhs_h); }
            let inst = mir_mk(MIR_STORE_INDEX);
            inst.arg1 = arr_reg;
            inst.arg2 = idx_reg;
            inst.ty = lhs.inferred_type;  // 数组元素类型：codegen 据此决定直接 GEP 还是运行时函数
            inst.args = array_push([], rhs_reg);
            // 循环界+容量可证 0<=idx<cap → 免 OOB 护栏（codegen cg_gen_array_store_direct 读 longval）
            inst.longval = mir_prove_in_bounds(lhs_children[0], lhs_children[1]);
            mir_emit(inst);
            // 存储到数组：RHS 变量缓冲被数组共享，不再唯一持有
            if ((rhs_h as any) != 0 && rhs_h.kind == EXPR_VAR) { mir_owned_clear(rhs_h.slot); }
            return;
        }

        if (lhs.kind == EXPR_MEMBER) {
            let lhs_children = lhs.children;
            let obj_reg = mir_lower_expr(lhs_children[0]);
            let rhs_reg = -1;
            if ((rhs_h as any) != 0) { rhs_reg = mir_lower_expr(rhs_h); }
            let inst = mir_mk(MIR_STORE_MEMBER);
            inst.arg1 = obj_reg;
            inst.strval = lhs.str1;
            inst.longval = lhs.intval;  // 字段索引
            inst.args = array_push([], rhs_reg);
            mir_emit(inst);
            // 存储到成员：RHS 变量缓冲被对象共享，不再唯一持有
            if ((rhs_h as any) != 0 && rhs_h.kind == EXPR_VAR) { mir_owned_clear(rhs_h.slot); }
            return;
        }
        return;
    }

    if (k == STMT_BLOCK) {
        let body = h.body;
        let i = 0;
        while (i < len(body)) {
            mir_lower_stmt(body[i]);
            i = i + 1;
        }
        return;
    }

    if (k == STMT_FOR) {
        // for (vars in iter) { body } 去糖为带索引的 while：
        //   单变量 for (x in arr): x = arr[idx]
        //   双变量 for (i, x in arr): i = idx, x = arr[idx]
        //   range for (i in a..b): idx = a; while (idx < b) { i = idx; body; idx++ }
        //   多变量解包 for (a, b in arr): a = arr[idx].0, b = arr[idx].1
        // 循环入口：体内别名操作会让变量在下一次迭代被共享，清除所有权禁用就地追加
        mir_clear_loop_aliases(h.body);
        let var_names = tc_split_commas(h.str1);
        let n_vars = len(var_names);
        let first_slot = h.slot;
        let idx_slot = h.int1;
        let extra_slots = h.extra_slots;
        let iter_h = h.child;

        let int_ty = mk_type(TYPE_INT);
        let bool_ty = mk_type(TYPE_BOOL);

        // EXPR_RANGE: for (i in a..b)
        let is_range = 0;
        if (iter_h.kind == EXPR_RANGE) { is_range = 1; }

        if (is_range == 1) {
            let children = iter_h.children;
            let start_h = children[0];
            let end_h = children[1];
            let start_reg = mir_lower_expr(start_h);
            let end_reg = mir_lower_expr(end_h);

            let st_start = mir_mk(MIR_STORE_VAR);
            st_start.arg1 = start_reg;
            st_start.arg2 = idx_slot;
            st_start.ty = int_ty;
            mir_emit(st_start);

            let cond_label = mir_new_label();
            let body_label = mir_new_label();
            let inc_label = mir_new_label();
            let exit_label = mir_new_label();
            mir_emit_br(cond_label);

            mir_seal_and_begin(cond_label);
            let idx_r = mir_new_reg();
            let ldi = mir_mk(MIR_LOAD_VAR);
            ldi.dst = idx_r;
            ldi.arg1 = idx_slot;
            ldi.ty = int_ty;
            mir_emit(ldi);
            let cmp_r = mir_new_reg();
            let cmp = mir_mk(MIR_BINOP);
            cmp.dst = cmp_r;
            cmp.arg1 = idx_r;
            cmp.arg2 = end_reg;
            cmp.longval = BIN_LT;
            cmp.ty = bool_ty;
            mir_emit(cmp);
            let condbr = mir_mk(MIR_CONDBR);
            condbr.arg1 = cmp_r;
            condbr.strval = body_label;
            condbr.strval2 = exit_label;
            mir_set_term(condbr);

            mir_seal_and_begin(body_label);
            mir_push_loop(exit_label, inc_label);
            let idx_r2 = mir_new_reg();
            let ldi2 = mir_mk(MIR_LOAD_VAR);
            ldi2.dst = idx_r2;
            ldi2.arg1 = idx_slot;
            ldi2.ty = int_ty;
            mir_emit(ldi2);
            let stx = mir_mk(MIR_STORE_VAR);
            stx.arg1 = idx_r2;
            stx.arg2 = first_slot;
            stx.ty = int_ty;
            mir_emit(stx);
            let body = h.body;
            let bi = 0;
            while (bi < len(body)) {
                mir_lower_stmt(body[bi]);
                bi = bi + 1;
            }
            mir_pop_loop();
            mir_emit_br(inc_label);

            mir_seal_and_begin(inc_label);
            let idx_r3 = mir_new_reg();
            let ldi3 = mir_mk(MIR_LOAD_VAR);
            ldi3.dst = idx_r3;
            ldi3.arg1 = idx_slot;
            ldi3.ty = int_ty;
            mir_emit(ldi3);
            let one_reg = mir_new_reg();
            let onec = mir_mk(MIR_CONST_INT);
            onec.dst = one_reg;
            onec.longval = 1;
            onec.ty = int_ty;
            mir_emit(onec);
            let inc_r = mir_new_reg();
            let inc = mir_mk(MIR_BINOP);
            inc.dst = inc_r;
            inc.arg1 = idx_r3;
            inc.arg2 = one_reg;
            inc.longval = BIN_ADD;
            inc.ty = int_ty;
            mir_emit(inc);
            let sti = mir_mk(MIR_STORE_VAR);
            sti.arg1 = inc_r;
            sti.arg2 = idx_slot;
            sti.ty = int_ty;
            mir_emit(sti);
            mir_emit_br(cond_label);

            mir_seal_and_begin(exit_label);
            return;
        }

        // 数组/字符串/dict/set 迭代模式
        let elem_ty = int_ty;
        let is_string_iter = 0;
        let is_dict_iter = 0;
        let dict_val_ty = 0 as Type;
        let is_set_iter = 0;
        let iter_ty = iter_h.inferred_type;
        if ((iter_ty as any) != 0) {
            let att = iter_ty;
            if (att.kind == TYPE_STRING) {
                is_string_iter = 1;
                elem_ty = mk_type(TYPE_CHAR);
            } else if (att.kind == TYPE_DICT) {
                is_dict_iter = 1;
                elem_ty = mk_type(TYPE_STRING);
                dict_val_ty = att.val_type;
                if ((dict_val_ty as any) == 0) { dict_val_ty = mk_type(TYPE_STRING); }
            } else if (att.kind == TYPE_SET) {
                is_set_iter = 1;
                elem_ty = att.elem_type;
                if ((elem_ty as any) == 0) { elem_ty = mk_type(TYPE_STRING); }
            } else if ((att.elem_type as any) != 0) {
                elem_ty = att.elem_type;
            }
        }

        // 求值迭代对象（仅一次）
        let arr_reg = mir_lower_expr(iter_h);
        let orig_dict_reg = arr_reg;

        // len = is_dict ? shadow_dict_size : (is_set ? shadow_set_size : (is_string ? shadow_string_len : shadow_array_len))
        let len_reg = mir_new_reg();
        let lenc = mir_mk(MIR_CALL);
        lenc.dst = len_reg;
        if (is_dict_iter == 1) {
            lenc.strval = "shadow_dict_size";
        } else if (is_set_iter == 1) {
            lenc.strval = "shadow_set_size";
        } else if (is_string_iter == 1) {
            lenc.strval = "shadow_string_len";
        } else {
            lenc.strval = "shadow_array_len";
        }
        lenc.args = array_push([], arr_reg);
        lenc.ty = int_ty;
        mir_emit(lenc);

        // idx = 0
        let zero_reg = mir_new_reg();
        let zc = mir_mk(MIR_CONST_INT);
        zc.dst = zero_reg;
        zc.longval = 0;
        zc.ty = int_ty;
        mir_emit(zc);
        let st0 = mir_mk(MIR_STORE_VAR);
        st0.arg1 = zero_reg;
        st0.arg2 = idx_slot;
        st0.ty = int_ty;
        mir_emit(st0);

        let cond_label = mir_new_label();
        let body_label = mir_new_label();
        let inc_label = mir_new_label();
        let exit_label = mir_new_label();

        mir_emit_br(cond_label);

        mir_seal_and_begin(cond_label);
        let idx_r = mir_new_reg();
        let ldi = mir_mk(MIR_LOAD_VAR);
        ldi.dst = idx_r;
        ldi.arg1 = idx_slot;
        ldi.ty = int_ty;
        mir_emit(ldi);
        let cmp_r = mir_new_reg();
        let cmp = mir_mk(MIR_BINOP);
        cmp.dst = cmp_r;
        cmp.arg1 = idx_r;
        cmp.arg2 = len_reg;
        cmp.longval = BIN_LT;
        cmp.ty = bool_ty;
        mir_emit(cmp);
        let condbr = mir_mk(MIR_CONDBR);
        condbr.arg1 = cmp_r;
        condbr.strval = body_label;
        condbr.strval2 = exit_label;
        mir_set_term(condbr);

        // body: 绑定循环变量 + <body>
        mir_seal_and_begin(body_label);
        mir_push_loop(exit_label, inc_label);

        let idx_r2 = mir_new_reg();
        let ldi2 = mir_mk(MIR_LOAD_VAR);
        ldi2.dst = idx_r2;
        ldi2.arg1 = idx_slot;
        ldi2.ty = int_ty;
        mir_emit(ldi2);

        if (n_vars == 1) {
            if (is_dict_iter == 1) {
                // dict 单变量 for (k in dict): k = shadow_dict_key_at(dict, idx)
                let elem_r = mir_new_reg();
                let kc = mir_mk(MIR_CALL);
                kc.dst = elem_r;
                kc.strval = "shadow_dict_key_at";
                kc.args = array_push(array_push([], orig_dict_reg), idx_r2);
                kc.ty = elem_ty;
                mir_emit(kc);
                let stx = mir_mk(MIR_STORE_VAR);
                stx.arg1 = elem_r;
                stx.arg2 = first_slot;
                stx.ty = elem_ty;
                mir_emit(stx);
            } else if (is_set_iter == 1) {
                // set 单变量：shadow_set_at_{string|int}
                let set_fn = "shadow_set_at_string";
                let ret_ty = elem_ty;
                let ek = TYPE_STRING;
                if ((elem_ty as any) != 0) { ek = elem_ty.kind; }
                if (ek == TYPE_INT || ek == TYPE_LONG || ek == TYPE_DATE
                    || ek == TYPE_TIMESTAMP || ek == TYPE_NANOTIMESTAMP
                    || ek == TYPE_BOOL) {
                    set_fn = "shadow_set_at_int";
                    ret_ty = mk_type(TYPE_LONG);
                }
                let elem_r = mir_new_reg();
                let kc = mir_mk(MIR_CALL);
                kc.dst = elem_r;
                kc.strval = set_fn;
                kc.args = array_push(array_push([], arr_reg), idx_r2);
                kc.ty = ret_ty;
                mir_emit(kc);
                let stx = mir_mk(MIR_STORE_VAR);
                stx.arg1 = elem_r;
                stx.arg2 = first_slot;
                stx.ty = elem_ty;
                mir_emit(stx);
            } else {
                // 单变量 for (x in arr): x = arr[idx]
                let elem_r = mir_new_reg();
                let idxinst = mir_mk(MIR_INDEX);
                idxinst.dst = elem_r;
                idxinst.arg1 = arr_reg;
                idxinst.arg2 = idx_r2;
                idxinst.ty = elem_ty;
                mir_emit(idxinst);
                let stx = mir_mk(MIR_STORE_VAR);
                stx.arg1 = elem_r;
                stx.arg2 = first_slot;
                stx.ty = elem_ty;
                mir_emit(stx);
            }
        } else if (n_vars == 2 && is_dict_iter == 1) {
            // dict 双变量 for (k, v in dict): k = key_at, v = dict[k]
            let key_r = mir_new_reg();
            let kc = mir_mk(MIR_CALL);
            kc.dst = key_r;
            kc.strval = "shadow_dict_key_at";
            kc.args = array_push(array_push([], orig_dict_reg), idx_r2);
            kc.ty = elem_ty;
            mir_emit(kc);
            let stk = mir_mk(MIR_STORE_VAR);
            stk.arg1 = key_r;
            stk.arg2 = first_slot;
            stk.ty = elem_ty;
            mir_emit(stk);
            let dict_get_fn = "shadow_dict_get_string";
            let dict_val_ret_ty = dict_val_ty;
            let dvk = TYPE_STRING;
            if ((dict_val_ty as any) != 0) { dvk = dict_val_ty.kind; }
            if (dvk == TYPE_INT || dvk == TYPE_LONG || dvk == TYPE_DATE
                || dvk == TYPE_TIMESTAMP || dvk == TYPE_NANOTIMESTAMP
                || dvk == TYPE_BOOL) {
                dict_get_fn = "shadow_dict_get_int";
                dict_val_ret_ty = mk_type(TYPE_LONG);
            }
            let val_r = mir_new_reg();
            let valc = mir_mk(MIR_CALL);
            valc.dst = val_r;
            valc.strval = dict_get_fn;
            valc.args = array_push(array_push([], orig_dict_reg), key_r);
            valc.ty = dict_val_ret_ty;
            mir_emit(valc);
            let stv = mir_mk(MIR_STORE_VAR);
            stv.arg1 = val_r;
            stv.arg2 = extra_slots[0] as int;
            stv.ty = dict_val_ty;
            mir_emit(stv);
        } else if (n_vars == 2) {
            // 双变量 for (i, x in arr): i = idx, x = arr[idx]
            let st_i = mir_mk(MIR_STORE_VAR);
            st_i.arg1 = idx_r2;
            st_i.arg2 = first_slot;
            st_i.ty = int_ty;
            mir_emit(st_i);
            let elem_r = mir_new_reg();
            let idxinst = mir_mk(MIR_INDEX);
            idxinst.dst = elem_r;
            idxinst.arg1 = arr_reg;
            idxinst.arg2 = idx_r2;
            idxinst.ty = elem_ty;
            mir_emit(idxinst);
            let stx = mir_mk(MIR_STORE_VAR);
            stx.arg1 = elem_r;
            stx.arg2 = extra_slots[0] as int;
            stx.ty = elem_ty;
            mir_emit(stx);
        } else {
            // 多变量解包 for (a, b, c in arr): a = arr[idx].0, ...
            let elem_r = mir_new_reg();
            let idxinst = mir_mk(MIR_INDEX);
            idxinst.dst = elem_r;
            idxinst.arg1 = arr_reg;
            idxinst.arg2 = idx_r2;
            idxinst.ty = elem_ty;
            mir_emit(idxinst);

            // 元组字段类型（元素类型应为 TYPE_TUPLE）
            let tuple_param_types = 0 as Type;  // 仅用于判空；实际逐字段取 elem_ty 的 param_types
            let tp_types: array<Type> = [];
            if ((elem_ty as any) != 0 && elem_ty.kind == TYPE_TUPLE) {
                let pi = 0;
                while (pi < len(elem_ty.param_types)) {
                    tp_types = array_push(tp_types, elem_ty.param_types[pi]);
                    pi = pi + 1;
                }
            }

            let all_slots: array<int> = [];
            all_slots = array_push(all_slots, first_slot);
            let vi = 0;
            while (vi < len(extra_slots)) {
                all_slots = array_push(all_slots, extra_slots[vi]);
                vi = vi + 1;
            }
            let fi = 0;
            while (fi < len(all_slots)) {
                let field_ty = mk_type(TYPE_ANY);
                if (fi < len(tp_types)) { field_ty = tp_types[fi]; }
                let field_r = mir_new_reg();
                let memacc = mir_mk(MIR_MEMBER);
                memacc.dst = field_r;
                memacc.arg1 = elem_r;
                memacc.longval = fi;
                memacc.ty = field_ty;
                mir_emit(memacc);
                let stf = mir_mk(MIR_STORE_VAR);
                stf.arg1 = field_r;
                stf.arg2 = all_slots[fi] as int;
                stf.ty = field_ty;
                mir_emit(stf);
                fi = fi + 1;
            }
        }

        let body = h.body;
        let bi = 0;
        while (bi < len(body)) {
            mir_lower_stmt(body[bi]);
            bi = bi + 1;
        }
        mir_pop_loop();
        mir_emit_br(inc_label);

        // inc: idx = idx + 1
        mir_seal_and_begin(inc_label);
        let idx_r3 = mir_new_reg();
        let ldi3 = mir_mk(MIR_LOAD_VAR);
        ldi3.dst = idx_r3;
        ldi3.arg1 = idx_slot;
        ldi3.ty = int_ty;
        mir_emit(ldi3);
        let one_reg = mir_new_reg();
        let onec = mir_mk(MIR_CONST_INT);
        onec.dst = one_reg;
        onec.longval = 1;
        onec.ty = int_ty;
        mir_emit(onec);
        let inc_r = mir_new_reg();
        let inc = mir_mk(MIR_BINOP);
        inc.dst = inc_r;
        inc.arg1 = idx_r3;
        inc.arg2 = one_reg;
        inc.longval = BIN_ADD;
        inc.ty = int_ty;
        mir_emit(inc);
        let sti = mir_mk(MIR_STORE_VAR);
        sti.arg1 = inc_r;
        sti.arg2 = idx_slot;
        sti.ty = int_ty;
        mir_emit(sti);
        mir_emit_br(cond_label);

        mir_seal_and_begin(exit_label);
        return;
    }
}

// --- 函数 lowering ---
pub kimo mir_lower_func(hf: HirFunc) -> MirFunc {
    mir_blocks = [];
    mir_cur_label = "entry";
    mir_cur_insts = [];
    mir_cur_terminator = 0 as MirInst;
    mir_cur_line = 0;
    mir_n_regs = 0;
    mir_label_counter = 0;
    mir_loop_break_labels = [];
    mir_loop_continue_labels = [];
    mir_n_slots = hf.n_slots;
    mir_owned = [];
    let oi = 0;
    while (oi < mir_n_slots) {
        mir_owned = array_push(mir_owned, 0);
        oi = oi + 1;
    }
    mir_slot_empty = [];
    let ei = 0;
    while (ei < mir_n_slots) {
        mir_slot_empty = array_push(mir_slot_empty, 0);
        ei = ei + 1;
    }
    mir_cap_lb_slot = [];
    mir_cap_lb_ok = [];
    mir_constish = [];
    mir_vmin_known = [];
    mir_vmin = [];
    let kfi = 0;
    while (kfi < mir_n_slots) {
        mir_cap_lb_slot = array_push(mir_cap_lb_slot, -1);
        mir_cap_lb_ok = array_push(mir_cap_lb_ok, 0);
        mir_constish = array_push(mir_constish, 0);
        mir_vmin_known = array_push(mir_vmin_known, 0);
        mir_vmin = array_push(mir_vmin, 0);
        kfi = kfi + 1;
    }
    mir_lf_slot = [];
    mir_lf_bound = [];
    mir_lf_bval = [];
    mir_lf_inc = [];
    mir_lf_mono = [];
    mir_lf_cvmin = [];
    mir_lf_n = 0;
    mir_sred_n = 0;
    mir_sred_slots = [];
    mir_sred_adj = [];
    mir_sred_arr_h = [];
    mir_sred_i_h = 0 as HirExpr;
    mir_sred_base_reg = -1;

    // 跨调用容量播种：把调用点登记的 cap(数组形参)==另一形参 落到形参槽上
    mir_xc_seed_params(hf);

    let body = hf.body;
    let i = 0;
    while (i < len(body)) {
        let stmt = body[i];
        mir_lower_stmt(stmt);
        i = i + 1;
    }

    if (mir_has_terminator() == 0) {
        let ret = mir_mk(MIR_RET);
        ret.arg1 = -1;
        mir_set_term(ret);
    }

    mir_seal_last();

    let params_mir: array<MirParam> = [];
    let params = hf.params;
    let j = 0;
    while (j < len(params)) {
        let p = params[j];
        params_mir = array_push(params_mir, MirParam { slot: p.slot, type_kind: p.ty.kind });
        j = j + 1;
    }

    let mf = MirFunc {
        name: hf.name,
        params: params_mir,
        return_type_kind: hf.return_type.kind,
        blocks: mir_blocks,
        n_regs: mir_n_regs,
        n_slots: hf.n_slots,
        extern_name: hf.extern_name,
        is_nogc: hf.is_nogc
    };
    return mf;
}

// --- 程序 lowering：返回 array<MirFunc>（跳过 extern 函数）---
pub kimo mir_lower_program(hfuncs: array<HirFunc>) -> array<MirFunc> {
    // 两遍：第一遍按源码序 lowering 生成本会建立跨调用容量登记表（调用侧在 callee 之后
    // lowering，callee 第一遍拿不到容量播种）；若确有跨调用容量则重走一遍，让所有 callee
    // 都在登记表齐备后播种，消除数组下标护栏。无跨调用事实时只跑一遍，不做多余工作。
    mir_xc_fn = [];
    mir_xc_arr = [];
    mir_xc_src = [];
    mir_xc_used = 0;
    let mfuncs: array<MirFunc> = [];
    let i = 0;
    while (i < len(hfuncs)) {
        let hf = hfuncs[i];
        if (len(hf.extern_name) == 0) { mfuncs = array_push(mfuncs, mir_lower_func(hf)); }
        i = i + 1;
    }
    if (mir_pi_dbg == 1) { println("PI pass1 done used=" + int_to_str(mir_xc_used)); }
    if (mir_xc_used == 1) {
        mfuncs = [];
        let j = 0;
        while (j < len(hfuncs)) {
            let hf = hfuncs[j];
            if (len(hf.extern_name) == 0) { mfuncs = array_push(mfuncs, mir_lower_func(hf)); }
            j = j + 1;
        }
    }
    return mfuncs;
}
